---

<link href="https://cdn.jsdelivr.net/npm/photoswipe@5.3.8/dist/photoswipe.css" rel="stylesheet" />

<script>
  import PhotoSwipe from "photoswipe";
  import type { PhotoSwipeItem, PhotoSwipeOptions } from "../types/photoswipe";

  const initPhotoSwipe = async () => {
    try {
      const images = document.querySelectorAll("a[data-pswp]");
      const videos = document.querySelectorAll("video.video-player");

      // Build a unified list sorted by document order
      const allElements: { element: Element; type: "image" | "video" }[] = [
        ...Array.from(images).map((el) => ({ element: el, type: "image" as const })),
        ...Array.from(videos).map((el) => ({ element: el, type: "video" as const })),
      ].sort((a, b) =>
        a.element.compareDocumentPosition(b.element) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
      );

      const allItems: PhotoSwipeItem[] = allElements.map(({ element, type }) => {
        if (type === "video") {
          const video = element as HTMLVideoElement;
          // Use actual video dimensions (from preload="metadata"), fall back to attributes
          const nativeW = video.videoWidth || parseInt(video.getAttribute("width") || "720");
          const nativeH = video.videoHeight || parseInt(video.getAttribute("height") || "480");
          const pad = 40; // PhotoSwipe padding (20px each side)
          const captionSpace = 60; // room for caption below video
          const maxW = window.innerWidth - pad;
          const maxH = window.innerHeight - pad - captionSpace;
          const scale = Math.min(maxW / nativeW, maxH / nativeH, 1);
          const fitW = Math.round(nativeW * scale);
          const fitH = Math.round(nativeH * scale);
          return {
            html: `<div class="pswp__video-wrapper">
              <video
                controls
                class="pswp__video"
                playsinline
                preload="none"
                style="width:${fitW}px;height:${fitH}px"
              >
                <source src="${video.querySelector("source")?.src}" type="video/mp4">
              </video>
            </div>`,
            width: fitW,
            height: fitH,
            caption:
              video.closest(".video-container")?.querySelector(".video-comment")?.textContent || "",
          };
        }
        const img = element as HTMLAnchorElement;
        return {
          src: img.getAttribute("href") || "",
          width: parseInt(img.getAttribute("data-width") || "0"),
          height: parseInt(img.getAttribute("data-height") || "0"),
          alt: img.getAttribute("data-caption") || "",
          caption: img.getAttribute("data-caption") || "",
        };
      });

      // Add click handlers in document order
      allElements.forEach(({ element }, index) => {
        element.addEventListener("click", (e) => {
          e.preventDefault();

          const pswp = new PhotoSwipe({
            dataSource: allItems,
            index,
            bgOpacity: 1,
            padding: { top: 20, bottom: 20, left: 20, right: 20 },
          } as PhotoSwipeOptions);

          // Register custom caption element
          pswp.on("uiRegister", () => {
            pswp.ui?.registerElement({
              name: "custom-caption",
              order: 9,
              isButton: false,
              appendTo: "wrapper",
              html: "Caption text",
              onInit: (el) => {
                el.style.position = "absolute";
                el.style.bottom = "15px";
                el.style.left = "50%";
                el.style.transform = "translateX(-50%)";
                el.style.zIndex = "1500";
                el.style.color = "#fff";
                el.style.background = "rgba(0, 0, 0, 0.85)";
                el.style.padding = "8px 16px";
                el.style.borderRadius = "4px";
                el.style.maxWidth = "80%";
                el.style.pointerEvents = "none";

                pswp.on("change", () => {
                  const caption = pswp.currSlide?.data?.caption;
                  if (caption) {
                    el.innerHTML = caption;
                  }
                });
              },
            });
          });

          // Pause videos when navigating away from them
          pswp.on("change", () => {
            const container = pswp.element;
            if (container) {
              container.querySelectorAll("video").forEach((v) => v.pause());
            }
          });

          pswp.init();
        });
      });
    } catch (error) {
      console.error("PhotoSwipe initialization error:", error);
    }
  };

  // Wait for DOM to be ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPhotoSwipe);
  } else {
    initPhotoSwipe();
  }
</script>

<style is:global>
  /* Force light-on-dark text in the lightbox regardless of site theme */
  .pswp {
    --pswp-icon-color: #fff;
    --pswp-icon-color-secondary: #000;
    color: #fff;
  }

  .pswp__counter {
    color: #fff;
  }

  .pswp__custom-caption {
    color: #fff;
    font-size: 16px;
    line-height: 1.5;
    text-align: center;
    margin: 0 auto;
    white-space: normal;
    display: inline-block;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
  }

  .pswp__custom-caption {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pswp__custom-caption:not(:empty) {
    opacity: 1;
  }

  .pswp__video-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }

  .pswp__video {
    max-width: 90vw;
    max-height: 85vh;
    width: auto;
    height: auto;
  }
</style>

<!-- PhotoSwipe container -->
<div class="pswp" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="pswp__bg"></div>
  <div class="pswp__scroll-wrap">
    <div class="pswp__container">
      <div class="pswp__item"></div>
      <div class="pswp__item"></div>
      <div class="pswp__item"></div>
    </div>
    <div class="pswp__ui pswp__ui--hidden">
      <div class="pswp__top-bar">
        <div class="pswp__counter"></div>
        <button class="pswp__button pswp__button--close" title="Close (Esc)"></button>
        <button class="pswp__button pswp__button--zoom" title="Zoom in/out"></button>
      </div>
    </div>
  </div>
</div>
