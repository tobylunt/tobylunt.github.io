    opSymbols[3].style.fontSize = "1.5rem";
    state[opSymbols[3].id] = {
      x: plusX, y: topY + matH / 2 - 14, opacity: 0.8
    };

    // ── MHA(X) matrix (center) ──
    // Use headCells/headBracket/headLabel so "Output" from step 17 morphs into "MHA(X)"
    var oX = plusX + opW + opGap;
    var oY = topY;
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < cols; c++) {
        state[headCells[r][c].id] = {
          x: oX + c * (cellW + gap),
          y: oY + r * (cellH + gap),
