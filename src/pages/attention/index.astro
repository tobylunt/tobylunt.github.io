    dimLabels[1].innerHTML = "Queries \u2193";
    dimLabels[1].style.fontSize = "0.6rem";
    dimLabels[1].style.color = "var(--attn-blue)";

    // Column token labels — same as step 12
    for (var i = 0; i < T; i++) {
      state[miscLabels[i].id] = {
        x: matX + i * (cellW + gap) + cellW / 2 - 12,
        y: matY - 26,
        opacity: 0.5
      };
      miscLabels[i].textContent = TOKENS[i].text;
      miscLabels[i].style.fontSize = "0.58rem";
      miscLabels[i].style.fontWeight = "500";
      miscLabels[i].style.color = "var(--attn-text-muted)";
    }

    // Row token labels — same as step 12
    for (var i = 0; i < T; i++) {
      miscLabels[8 + i].style.width = rowLabelW + "px";
      state[miscLabels[8 + i].id] = {
        x: matX - rowLabelW - 18,
        y: matY + i * (cellH + gap) + cellH / 2 - 6,
        opacity: 0.5
      };
      miscLabels[8 + i].textContent = TOKENS[i].text;
      miscLabels[8 + i].style.fontSize = "0.5rem";
      miscLabels[8 + i].style.fontWeight = "500";
      miscLabels[8 + i].style.textAlign = "right";
      miscLabels[8 + i].style.color = "var(--attn-text-muted)";
    }

    // Color scale legend below matrix
    // "0" label
    state[miscLabels[16].id] = { x: matX + matW / 2 - 72, y: matY + matH + 18, opacity: 0.5 };
    miscLabels[16].textContent = "0";
    miscLabels[16].style.fontSize = "0.6rem";

    // Gradient bar (using a miscLabel with background gradient)
    state[miscLabels[17].id] = { x: matX + matW / 2 - 60, y: matY + matH + 16, opacity: 0.8 };
    miscLabels[17].textContent = "";
    miscLabels[17].style.background = "linear-gradient(to right, " + heatColor(0) + ", " + heatColor(0.5) + ", " + heatColor(1) + ")";
    miscLabels[17].style.width = "120px";
    miscLabels[17].style.height = "10px";
    miscLabels[17].style.borderRadius = "3px";

    // "1" label
    state[miscLabels[18].id] = { x: matX + matW / 2 + 64, y: matY + matH + 18, opacity: 0.5 };
    miscLabels[18].textContent = "1";
    miscLabels[18].style.fontSize = "0.6rem";

    return state;
  }

  function computeStep14(goingForward) {
    // Step 14: Multi-Head Patterns — 3 attention heads side by side
    // attnCells (Content) stays in CENTER — same position as step 13 — so the
    // animation engine smoothly shrinks them in place. scoreCells and altCells
    // fade in on the left and right.

    var state = {};
    hideAll(state);
    var gap = CELL_GAP;

    // Smaller cells to fit 3 matrices with per-matrix labels
    var sCellW = Math.round(CELL_W * 0.7);
    var sCellH = Math.round(CELL_H * 0.9);
    var matSpacing = Math.max(24, Math.round(W * 0.03));

    var matW = T * (sCellW + gap) - gap;
    var matH = T * (sCellH + gap) - gap;

    // Per-matrix layout: each unit = rowLabelArea + matrix
    var rowLabelW = 26;
    var perMatUnit = rowLabelW + matW;
    var totalW = 3 * perMatUnit + 2 * matSpacing;
    var startX = (W - totalW) / 2;
    var matY = (H - matH) / 2 + 20;

    // Matrix cell x-positions (left edge of heatmap cells)
    var leftMatX = startX + rowLabelW;
    var centerMatX = startX + perMatUnit + matSpacing + rowLabelW;
    var rightMatX = startX + 2 * (perMatUnit + matSpacing) + rowLabelW;

    // Row label x-positions (left edge of row label area)
    var leftRowX = startX;
    var centerRowX = startX + perMatUnit + matSpacing;
    var rightRowX = startX + 2 * (perMatUnit + matSpacing);

    // Three weight sets, cell pools, and label index mappings
    // attnCells in CENTER for smooth transition from/to step 13
    // miscLabels 0-7/8-15 stay on center matrix (same indices as step 13)
    // dimLabels 2/1 stay on center matrix (same as step 13's Keys/Queries)
    var headData = [
      { cells: scoreCells, weights: PREV_TOKEN_WEIGHTS, matX: leftMatX, rowX: leftRowX,
        label: "Previous Token", colLabels: 24, rowLabels: 32 },
      { cells: attnCells, weights: ATTN_WEIGHTS, matX: centerMatX, rowX: centerRowX,
        label: "Content", colLabels: 0, rowLabels: 8 },
      { cells: altCells, weights: SYNTAX_WEIGHTS, matX: rightMatX, rowX: rightRowX,
        label: "Syntactic", colLabels: 40, rowLabels: 48 }
    ];

    // Render heatmaps + per-matrix labels
    for (var hi = 0; hi < 3; hi++) {
      var hd = headData[hi];

      // Heatmap cells
      for (var r = 0; r < T; r++) {
        for (var c = 0; c < T; c++) {
          var w = hd.weights[r][c];
          var isMasked = c > r;
          state[hd.cells[r][c].id] = {
            x: hd.matX + c * (sCellW + gap),
            y: matY + r * (sCellH + gap),
            w: sCellW, h: sCellH,
            opacity: isMasked ? 0.08 : 1,
            bg: isMasked ? (isDark() ? "hsl(0,0%,20%)" : "hsl(0,0%,88%)") : heatColor(w),
            color: "transparent",
            fontSize: "0.5rem"
          };
        }
      }

      // Column token labels above each matrix
      for (var i = 0; i < T; i++) {
        state[miscLabels[hd.colLabels + i].id] = {
          x: hd.matX + i * (sCellW + gap) + sCellW / 2 - 12,
          y: matY - 18,
          opacity: 0.5
        };
        miscLabels[hd.colLabels + i].textContent = TOKENS[i].text;
        miscLabels[hd.colLabels + i].style.fontSize = "0.48rem";
        miscLabels[hd.colLabels + i].style.fontWeight = "500";
        miscLabels[hd.colLabels + i].style.color = "var(--attn-text-muted)";
      }

      // Row token labels left of each matrix (right-aligned within row label area)
      for (var i = 0; i < T; i++) {
        state[miscLabels[hd.rowLabels + i].id] = {
          x: hd.rowX,
          y: matY + i * (sCellH + gap) + sCellH / 2 - 6,
          opacity: 0.5
        };
        miscLabels[hd.rowLabels + i].textContent = TOKENS[i].text;
        miscLabels[hd.rowLabels + i].style.fontSize = "0.42rem";
        miscLabels[hd.rowLabels + i].style.fontWeight = "500";
        miscLabels[hd.rowLabels + i].style.width = (rowLabelW - 4) + "px";
        miscLabels[hd.rowLabels + i].style.textAlign = "right";
        miscLabels[hd.rowLabels + i].style.color = "var(--attn-text-muted)";
      }
    }

    // Brackets around each matrix
    // attnBracket on center (same bracket as step 13, smoothly shrinks in place)
    state[scoreBracket.id] = {
      x: leftMatX - 4, y: matY - 4,
      w: matW + 8, h: matH + 8,
      opacity: 1, borderColor: "hsl(42, 60%, 55%)"
    };
    state[attnBracket.id] = {
      x: centerMatX - 4, y: matY - 4,
      w: matW + 8, h: matH + 8,
      opacity: 1, borderColor: "hsl(42, 60%, 55%)"
    };
    state[altBracket.id] = {
      x: rightMatX - 4, y: matY - 4,
      w: matW + 8, h: matH + 8,
      opacity: 1, borderColor: "hsl(42, 60%, 55%)"
    };

    // Head labels below each matrix (miscLabels 19, 20, 21)
    var headLabelNames = ["Previous Token", "Content", "Syntactic"];
    var headLabelXs = [leftMatX, centerMatX, rightMatX];
    for (var li = 0; li < 3; li++) {
      state[miscLabels[19 + li].id] = {
        x: headLabelXs[li] + matW / 2 - 40,
        y: matY + matH + 10,
        opacity: 0.8
      };
      miscLabels[19 + li].textContent = headLabelNames[li];
      miscLabels[19 + li].style.fontSize = "0.62rem";
      miscLabels[19 + li].style.fontWeight = "600";
      miscLabels[19 + li].style.color = "var(--attn-text-muted)";
    }

    // "K →" above each matrix
    // dimLabels[2] on center (same as step 13's "Keys →", animates smoothly)
    var keysLabelIds = [3, 2, 4];
    var keysLabelXs = [leftMatX, centerMatX, rightMatX];
    for (var ki = 0; ki < 3; ki++) {
      state[dimLabels[keysLabelIds[ki]].id] = {
        x: keysLabelXs[ki],
        y: matY - 32,
        opacity: 1
      };
      dimLabels[keysLabelIds[ki]].innerHTML = "K \u2192";
      dimLabels[keysLabelIds[ki]].style.fontSize = "0.5rem";
      dimLabels[keysLabelIds[ki]].style.color = "var(--attn-orange)";
    }

    // "Q ↓" left of each matrix, above row labels
    // dimLabels[1] on center (same as step 13's "Queries ↓", animates smoothly)
    var queriesLabelIds = [5, 1, 6];
    var queriesLabelXs = [leftRowX, centerRowX, rightRowX];
    for (var qi = 0; qi < 3; qi++) {
      state[dimLabels[queriesLabelIds[qi]].id] = {
        x: queriesLabelXs[qi],
        y: matY - 10,
        opacity: 1
      };
      dimLabels[queriesLabelIds[qi]].innerHTML = "Q \u2193";
      dimLabels[queriesLabelIds[qi]].style.fontSize = "0.5rem";
      dimLabels[queriesLabelIds[qi]].style.color = "var(--attn-blue)";
    }

    // Subtitle: "3 of 4 attention heads"
    state[dimLabels[0].id] = { x: (W - 120) / 2, y: matY - 54, opacity: 0.5 };
    dimLabels[0].textContent = "3 of 4 attention heads";
    dimLabels[0].style.fontStyle = "italic";
    dimLabels[0].style.fontSize = "0.7rem";
    dimLabels[0].style.color = "var(--attn-text-muted)";

    // Color scale legend centered below
    var legendCenterX = (W - 120) / 2;
    var legendY = matY + matH + 34;
    state[miscLabels[16].id] = { x: legendCenterX - 12, y: legendY, opacity: 0.5 };
    miscLabels[16].textContent = "0";
    miscLabels[16].style.fontSize = "0.6rem";

    state[miscLabels[17].id] = { x: legendCenterX, y: legendY - 2, opacity: 0.8 };
    miscLabels[17].textContent = "";
    miscLabels[17].style.background = "linear-gradient(to right, " + heatColor(0) + ", " + heatColor(0.5) + ", " + heatColor(1) + ")";
    miscLabels[17].style.width = "120px";
    miscLabels[17].style.height = "10px";
    miscLabels[17].style.borderRadius = "3px";

    state[miscLabels[18].id] = { x: legendCenterX + 124, y: legendY, opacity: 0.5 };
    miscLabels[18].textContent = "1";
    miscLabels[18].style.fontSize = "0.6rem";

    return state;
  }

  function computeStep15(goingForward) {
    // Step 15: Value Matrix — X · W_V = V, matching steps 9/10 styling
    var state = {};
    hideAll(state);
    var gap = CELL_GAP;

    // ── X matrix (left): T cols × D_MODEL rows — identical to steps 9/10 ──
    var inputW = T * (CELL_W + gap) - gap;
    var inputH = D_MODEL * (CELL_H + gap) - gap;

    // ── W_V standard orientation: D_MODEL rows × D_HEAD cols ──
    var wCellW = CELL_W;
    var wGap = gap;
    var wCellH = CELL_H;
    var wMatW = D_HEAD * (wCellW + wGap) - wGap;
    var wMatH = D_MODEL * (wCellH + wGap) - wGap;

    // ── V standard: D_HEAD cols × T rows ──
    var vCellH = CELL_H;
    var vMatW = D_HEAD * (CELL_W + gap) - gap;
    var vMatH = T * (vCellH + gap) - gap;

    var dotSpacing = 56;
    var eqSpacing = 56;
    var totalW = inputW + dotSpacing + wMatW + eqSpacing + vMatW;
    var startX = (W - totalW) / 2;
    var centerY = H / 2;
    var xOff = startX;

    // ── X matrix cells ──
    var pc = cellColors("purple");
    var iY = centerY - inputH / 2;
    for (var t = 0; t < T; t++) {
      for (var d = 0; d < D_MODEL; d++) {
        state[combCells[t][d].id] = {
          x: xOff + t * (CELL_W + gap),
          y: iY + d * (CELL_H + gap),
          w: CELL_W, h: CELL_H,
          opacity: 1, bg: pc.bg, color: pc.text
        };
      }
    }
    state[matBracket.id] = {
      x: xOff - 6, y: iY - 4,
      w: inputW + 12, h: inputH + 8,
      opacity: 1, borderColor: "var(--attn-purple)"
    };

    // Token labels above X (tokenEls, compact style matching steps 9/10)
    for (var t = 0; t < T; t++) {
      state[tokenEls[t].id] = {
        x: xOff + t * (CELL_W + gap) + (CELL_W - CHIP_W) / 2, y: iY - 20,
        w: CHIP_W, h: 16,
        opacity: 0.5,
        bg: "transparent", color: resolveTextColor(),
        fontSize: "0.6rem",
        borderRadius: "0px",
        padding: "0px"
      };
    }

    // "X" title above token labels (index 22: avoids step 14's col labels at 0-7)
    state[miscLabels[22].id] = { x: xOff + inputW / 2 - 4, y: iY - 38, opacity: 1 };
    miscLabels[22].textContent = "X";
    miscLabels[22].style.fontSize = "0.85rem";
    miscLabels[22].style.fontWeight = "700";
    miscLabels[22].style.color = "var(--attn-purple)";

    // d_model vertical label (left side of X)
    state[dModelLabel.id] = {
      x: xOff - 28, y: iY + inputH / 2 - 30,
      w: 20, h: 60, opacity: 0.6
    };

    // · operator
    opSymbols[0].textContent = "\u00B7";
    state[opSymbols[0].id] = {
      x: xOff + inputW + dotSpacing / 2 - 3, y: centerY - 10,
      opacity: 0.7
    };
    xOff += inputW + dotSpacing;

    // ── W_V matrix (standard): row=d_model, col=d_head ──
    var wY = centerY - wMatH / 2;
    var wc = cellColors("v");
    for (var d = 0; d < D_MODEL; d++) {
      for (var h = 0; h < D_HEAD; h++) {
        state[wvCells[d][h].id] = {
          x: xOff + h * (wCellW + wGap),
          y: wY + d * (wCellH + wGap),
          w: wCellW, h: wCellH,
          opacity: 1, bg: wc.bg, color: wc.text
        };
      }
    }
    state[wvBracket.id] = {
      x: xOff - 4, y: wY - 4,
      w: wMatW + 8, h: wMatH + 8,
      opacity: 1, borderColor: "var(--attn-rose)"
    };
    state[wvLabel.id] = { x: xOff + wMatW / 2 - 12, y: wY - 22, opacity: 1 };
    wvLabel.innerHTML = "<i>W</i><sub>V</sub>";

    // d_head horizontal label below W_V (centered)
    state[dHeadLabel.id] = {
      x: xOff + wMatW / 2 - 40, y: wY + wMatH + 10,
      opacity: 0.6
    };

    // = operator
    state[opSymbols[2].id] = {
      x: xOff + wMatW + eqSpacing / 2 - 5, y: centerY - 10,
      opacity: 0.7
    };
    xOff += wMatW + eqSpacing;

    // ── V matrix (standard view): row=token, col=d_head ──
    var vY = centerY - vMatH / 2;
    var vc = cellColors("v");
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        state[vCells[t][h].id] = {
          x: xOff + h * (CELL_W + gap),
          y: vY + t * (vCellH + gap),
          w: CELL_W, h: vCellH,
          opacity: goingForward ? 0.001 : 1, bg: vc.bg, color: vc.text
        };
      }
    }
    state[vBracket.id] = {
      x: xOff - 6, y: vY - 4,
      w: vMatW + 12, h: vMatH + 8,
      opacity: 1, borderColor: "var(--attn-rose)"
    };

    // Token labels on right of V rows — miscLabels[56..63]
    // (avoids step 14's row/col labels which span 0-55, and step 16's dim labels at 24-33)
    for (var t = 0; t < T; t++) {
      var vlbl = miscLabels[56 + t];
      vlbl.textContent = TOKENS[t].text;
      vlbl.style.fontSize = "0.5rem";
      vlbl.style.fontWeight = "500";
      vlbl.style.textAlign = "left";
      vlbl.style.color = "var(--attn-text-muted)";
      state[vlbl.id] = {
        x: xOff + vMatW + 8,
        y: vY + t * (vCellH + gap) + vCellH / 2 - 6,
        opacity: 0.5
      };
    }

    // "V" title above V matrix
    state[vLabel.id] = { x: xOff + vMatW / 2 - 6, y: vY - 26, opacity: 1 };
    vLabel.textContent = "V";
    vLabel.style.fontSize = "";

    // d_head horizontal label below V (index 23: avoids step 14's dimLabels[0] "3 of 4 heads")
    miscLabels[23].innerHTML = "d<sub>head</sub>&nbsp;= 256";
    miscLabels[23].style.fontStyle = "italic";
    miscLabels[23].style.fontFamily = "var(--attn-mono)";
    miscLabels[23].style.color = "var(--attn-text-muted)";
    state[miscLabels[23].id] = {
      x: xOff + vMatW / 2 - 40, y: vY + vMatH + 10,
      w: 80, h: 20, opacity: 0.6
    };

    return state;
  }

  postAnimFns[15] = function () {
    if (reducedMotion) return;
    var tl = gsap.timeline();
    subAnimTimeline = tl;

    // Initially hide all V cells
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        vCells[t][h].style.opacity = "0";
      }
    }

    // Highlight colors
    var highlightPurple = "hsl(270, 50%, 55%, 0.35)";
    var highlightRose = "hsl(340, 50%, 55%, 0.35)";
    var pc = cellColors("purple");
    var wc = cellColors("v");

    // For each token, highlight X column then sweep W_V columns
    // X column t (d_model values) · W_V column h (d_model values) → V[t][h]
    for (var t = 0; t < T; t++) {
      (function (t) {
        var xColEls = [];
        for (var d = 0; d < D_MODEL; d++) xColEls.push(combCells[t][d]);

        // Highlight X column
        tl.to(xColEls, {
          backgroundColor: highlightPurple,
          duration: 0.04
        });

        // For each d_head column in W_V
        for (var h = 0; h < D_HEAD; h++) {
          (function (h) {
            var wvColEls = [];
            for (var d = 0; d < D_MODEL; d++) wvColEls.push(wvCells[d][h]);

            // Flash W_V column highlight
            tl.to(wvColEls, {
              backgroundColor: highlightRose,
              duration: 0.03
            });

            // Fade in V cell
            tl.to(vCells[t][h], {
              opacity: 1,
              duration: 0.04
            }, ">");

            // De-highlight W_V column
            tl.to(wvColEls, {
              backgroundColor: wc.bg,
              duration: 0.03
            }, ">");
          })(h);
        }

        // De-highlight X column
        tl.to(xColEls, {
          backgroundColor: pc.bg,
          duration: 0.04
        });
      })(t);
    }
  };

  function computeStep16() {
    // Step 16: Value Weighting — Attn × V = Head₁
    var state = {};
    hideAll(state);
    var gap = CELL_GAP;

    var aCellW = 24;
    var aCellH = 20;
    var aMatW = T * (aCellW + gap) - gap;
    var aMatH = T * (aCellH + gap) - gap;
    var spacing = 36;
    var vMatW = D_HEAD * (CELL_W + gap) - gap;
    var vMatH = T * (CELL_H + gap) - gap;
    var oMatW = D_HEAD * (CELL_W + gap) - gap;
    var oMatH = T * (CELL_H + gap) - gap;

    var totalW = aMatW + spacing + vMatW + spacing + oMatW + 40;
    var sX = (W - totalW) / 2;
    var cY = H / 2;

    // ── Upper zone: Attn × V = Head₁ ──

    // Compact attention heatmap
    var aX = sX;
    var aY = cY - aMatH / 2;
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < T; c++) {
        var w = ATTN_WEIGHTS[r][c];
        var isMasked = c > r;
        state[attnCells[r][c].id] = {
          x: aX + c * (aCellW + gap),
          y: aY + r * (aCellH + gap),
          w: aCellW, h: aCellH,
          opacity: isMasked ? 0.08 : 1,
          bg: isMasked ? "transparent" : heatColor(w),
          color: isMasked ? "transparent" : heatTextColor(w),
          fontSize: "0.55rem"
        };
        attnCells[r][c].textContent = isMasked ? "" : w.toFixed(2);
      }
    }
    state[attnBracket.id] = {
      x: aX - 4, y: aY - 4,
      w: aMatW + 8, h: aMatH + 8,
      opacity: 1, borderColor: "hsl(42, 60%, 55%)"
    };
    state[attnLabel.id] = { x: aX + aMatW / 2 - 10, y: aY - 26, opacity: 0.7 };
    attnLabel.textContent = "Attn";

    // × operator
    state[opSymbols[0].id] = {
      x: aX + aMatW + spacing / 2 - 6, y: cY - 10, opacity: 1
    };

    // V matrix
    var vX = aX + aMatW + spacing;
    var vY = cY - vMatH / 2;
    var vc = cellColors("v");
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < D_HEAD; c++) {
        state[vCells[r][c].id] = {
          x: vX + c * (CELL_W + gap),
          y: vY + r * (CELL_H + gap),
          w: CELL_W, h: CELL_H,
          opacity: 1, bg: vc.bg, color: vc.text
        };
      }
    }
    state[vBracket.id] = {
      x: vX - 4, y: vY - 4,
      w: vMatW + 8, h: vMatH + 8,
      opacity: 1, borderColor: "var(--attn-rose)"
    };
    state[vLabel.id] = { x: vX + vMatW / 2 - 4, y: vY - 26, opacity: 1 };

    // = operator
    state[opSymbols[2].id] = {
      x: vX + vMatW + spacing / 2 - 4, y: cY - 10, opacity: 1
    };

    // Head₁ output (renamed from "Output")
    var oX = vX + vMatW + spacing;
    var oY = cY - oMatH / 2;
    var hc = cellColors("head");
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < D_HEAD; c++) {
        state[outCells[r][c].id] = {
          x: oX + c * (CELL_W + gap),
          y: oY + r * (CELL_H + gap),
          w: CELL_W, h: CELL_H,
          opacity: 1, bg: hc.bg, color: hc.text
        };
      }
    }
    state[outBracket.id] = {
      x: oX - 4, y: oY - 4,
      w: oMatW + 8, h: oMatH + 8,
      opacity: 1, borderColor: "var(--attn-head-gold)"
    };
    // Relabel "Output" → "Head₁"
    outLabel.innerHTML = "Head<sub>1</sub>";
    state[outLabel.id] = { x: oX + oMatW / 2 - 16, y: oY - 26, opacity: 1 };

    // ── Dimension labels below each matrix ──
    var dimStyle = function (lb) {
      lb.style.fontStyle = "italic";
      lb.style.fontFamily = "var(--attn-mono)";
      lb.style.fontSize = "0.55rem";
