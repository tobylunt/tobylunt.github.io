      }
    }

    // Bracket around concat matrix
    state[headBracket.id] = {
      x: concatX - 4, y: concatY - 4,
      w: concatMatW + 8, h: concatMatH + 8,
      opacity: 1, borderColor: "var(--attn-head-gold)"
    };
    headLabel.textContent = "Output";
    headLabel.style.fontFamily = "var(--attn-mono)";
    headLabel.style.fontStyle = "normal";
    state[headLabel.id] = { x: concatX + concatMatW / 2 - 20, y: concatY - 28, opacity: 1 };

    // ── Token labels left of concat output matrix ──
    for (var i = 0; i < T; i++) {
      miscLabels[45 + i].textContent = TOKENS[i].text;
      miscLabels[45 + i].style.fontSize = "0.42rem";
      miscLabels[45 + i].style.fontWeight = "500";
      miscLabels[45 + i].style.textAlign = "right";
      miscLabels[45 + i].style.width = (labelW - 4) + "px";
      miscLabels[45 + i].style.color = "var(--attn-text-muted)";
      state[miscLabels[45 + i].id] = {
        x: concatX - labelW, y: concatY + i * (gridCellH + gridGap) + gridCellH / 2 - 5,
        opacity: 0.5
      };
    }

    // ── Dimension label below concat output ──
    miscLabels[31].innerHTML = "4 \u00d7 d<sub>head</sub>&ensp;=&ensp;d<sub>model</sub>";
    miscLabels[31].style.fontStyle = "italic";
    miscLabels[31].style.fontFamily = "var(--attn-mono)";
    miscLabels[31].style.fontSize = "0.55rem";
    miscLabels[31].style.fontWeight = "600";
    miscLabels[31].style.color = dark ? "hsl(152,40%,68%)" : "hsl(152,40%,30%)";
    state[miscLabels[31].id] = {
      x: concatX + concatMatW / 2 - 45, y: concatY + concatMatH + 10, opacity: 0.8
    };

    // Numeric formula below dim label
    miscLabels[32].innerHTML = "(4 \u00d7 256 = 1024)";
    miscLabels[32].style.fontStyle = "italic";
    miscLabels[32].style.fontFamily = "var(--attn-mono)";
    miscLabels[32].style.fontSize = "0.5rem";
    miscLabels[32].style.color = "var(--attn-text-muted)";
    state[miscLabels[32].id] = {
      x: concatX + concatMatW / 2 - 35, y: concatY + concatMatH + 24, opacity: 0.45
    };

    // When going forward from step 16, prevent vCells from animating
    // from V matrix position to Head4 grid position
    if (goingForward) {
      for (var r = 0; r < T; r++) {
        for (var c = 0; c < D_HEAD; c++) {
          state[vCells[r][c].id].opacity = 0;
        }
      }
    }

    return state;
  }

  // Post-animation for step 17: fade in vCells at their Head4 grid positions
  postAnimFns[17] = function () {
    if (reducedMotion) return;
    var tl = gsap.timeline();
    subAnimTimeline = tl;

    // Recalculate Head4 grid positions (must match computeStep17 layout)
    var gap = CELL_GAP;
    var oMatH = T * (CELL_H + gap) - gap;
    var cardW = 60;
    var cardH = Math.round(oMatH * 0.65);
    var cardGap = 10;
    var gridCellW = Math.max(8, Math.round((cardW - 8) / D_HEAD));
    var gridCellH = Math.max(4, Math.round((cardH - 8) / T));
    var labelW = 34;
    var totalCardsW = 4 * cardW + 3 * cardGap;
    var startX = (W - (labelW + totalCardsW + 28 + labelW + (4 * (3 * (gridCellW + 1) - 1) + 3 * 3) + 20)) / 2;
    var cardsX = startX + labelW;
    var centerY = H / 2;
    var cardsTopY = centerY - cardH / 2;
    var cx = cardsX + 3 * (cardW + cardGap); // Head4 x position
    var gridX = cx + 4;
    var gridY = cardsTopY + 4;
    var dark = isDark();
    var head4Bg = dark ? "hsl(285,30%,32%,0.5)" : "hsl(285,28%,82%)";

    // Position vCells at Head4 grid instantly (they are already opacity 0)
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < D_HEAD; c++) {
        var el = vCells[r][c];
        el.style.left = (gridX + c * gridCellW) + "px";
        el.style.top = (gridY + r * gridCellH) + "px";
        el.style.width = (gridCellW - 1) + "px";
        el.style.height = (gridCellH - 1) + "px";
        el.style.backgroundColor = head4Bg;
        el.style.color = "transparent";
      }
    }

    // Collect all vCell elements and fade them in
    var vElems = [];
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < D_HEAD; c++) {
        vElems.push(vCells[r][c]);
      }
    }
    tl.to(vElems, { opacity: 0.85, duration: 0.3 });
  };

  function computeStep18() {
    var state = {};
    hideAll(state);
    var dark = isDark();
    var gap = CELL_GAP;

    // All three matrices use D_HEAD columns for balanced proportions
    var cols = D_HEAD;
    var cellW = CELL_W;
    var cellH = CELL_H;

    var matW = cols * (cellW + gap) - gap;
    var matH = T * (cellH + gap) - gap;

    // Spacing: matrix ─ gap ─ operator ─ gap ─ matrix
    var opGap = Math.max(20, Math.round(W * 0.025));
    var opW = 16;
    var totalW = 3 * (matW + 8) + 2 * (opGap * 2 + opW);
    var startX = (W - totalW) / 2;

