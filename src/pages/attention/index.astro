    // Weight cells (D_MODEL x D_HEAD for each)
    function makeMatCells(prefix, rows, cols, opts) {
      // opts.ellipsisRow: which row is ellipsis (default: rows - 2, i.e. second-to-last)
      // opts.ellipsisCol: which col is ellipsis (default: -1, meaning none)
      // Ellipsis row cells show ⋮ (vertical dots = "more rows")
      // Ellipsis col cells show ⋯ (horizontal dots = "more columns")
      // Intersection shows ⋱
      var eRow = (opts && opts.ellipsisRow !== undefined) ? opts.ellipsisRow : rows - 2;
      var eCol = (opts && opts.ellipsisCol !== undefined) ? opts.ellipsisCol : -1;
      var cells = [];
      for (var r = 0; r < rows; r++) {
        cells[r] = [];
        for (var c = 0; c < cols; c++) {
          var val;
          if (r === eRow && c === eCol) val = "\u22F1"; // ⋱ for row+col ellipsis intersection
