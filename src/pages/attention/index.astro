      // to prevent them morphing into unrelated step 10 positions
      for (var fi = 0; fi <= 7; fi++) miscLabels[fi].style.opacity = "0";
    }

    var state = {};
    hideAll(state);
    var gap = CELL_GAP;

    // ── Shrunk Q at top-right ("saved for later") — standard: D_HEAD cols × T rows ──
    var qShrinkScale = 0.5;
    var qSmallCellW = Math.round(CELL_W * qShrinkScale);
    var qSmallCellH = Math.round(CELL_H * qShrinkScale);
    var qSmallGap = Math.max(1, Math.round(gap * qShrinkScale));
    var qSmallMatW = D_HEAD * (qSmallCellW + qSmallGap) - qSmallGap;
    var qSmallMatH = T * (qSmallCellH + qSmallGap) - qSmallGap;
    var qSmallX = W - qSmallMatW - 40;
    var qSmallY = 54;

    var qc = cellColors("q");
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        // Standard view: t=row (token), h=col (d_head)
        if (h === 2) qCells[t][h].textContent = "\u22EF"; // ⋯ (d_head column ellipsis)
        else if (t === 6) qCells[t][h].textContent = (Math.random() * 2 - 1).toFixed(2);

        state[qCells[t][h].id] = {
          x: qSmallX + h * (qSmallCellW + qSmallGap),
          y: qSmallY + t * (qSmallCellH + qSmallGap),
          w: qSmallCellW, h: qSmallCellH,
          opacity: 0.5, bg: qc.bg, color: qc.text,
          fontSize: "0.35rem"
        };
      }
    }
    state[qBracket.id] = {
      x: qSmallX - 3, y: qSmallY - 2,
      w: qSmallMatW + 6, h: qSmallMatH + 4,
      opacity: 0.4, borderColor: "var(--attn-blue)",
      borderRadius: "4px"
    };
    state[qLabel.id] = { x: qSmallX + qSmallMatW / 2 - 6, y: qSmallY - 22, opacity: 0.5 };
    qLabel.textContent = "Q";

    // Token labels on right of shrunk Q rows — miscLabels[8..15] matching step 9/11
    for (var t = 0; t < T; t++) {
      var qlbl = miscLabels[8 + t];
      qlbl.textContent = TOKENS[t].text;
      qlbl.style.fontSize = "0.35rem";
      qlbl.style.fontWeight = "500";
      qlbl.style.textAlign = "left";
      qlbl.style.color = "var(--attn-text-muted)";
      state[qlbl.id] = {
        x: qSmallX + qSmallMatW + 6,
        y: qSmallY + t * (qSmallCellH + qSmallGap) + qSmallCellH / 2 - 4,
        opacity: 0.3
      };
    }

    // ── X matrix (left): T cols × D_MODEL rows — identical to step 9 ──
    var inputW = T * (CELL_W + gap) - gap;
    var inputH = D_MODEL * (CELL_H + gap) - gap;

    // ── W_K standard orientation: D_MODEL rows × D_HEAD cols ──
    var wCellW = 28;
    var wGap = gap;
    var wCellH = CELL_H;
    var wMatW = D_HEAD * (wCellW + wGap) - wGap;
    var wMatH = D_MODEL * (wCellH + wGap) - wGap;

    // ── K standard: D_HEAD cols × T rows ──
    var kCellH = CELL_H;
    var kMatW = D_HEAD * (CELL_W + gap) - gap;
    var kMatH = T * (kCellH + gap) - gap;

    var dotSpacing = 56;
    var eqSpacing = 56;
    var totalW = inputW + dotSpacing + wMatW + eqSpacing + kMatW;
    var startX = (W - totalW) / 2;
    var centerY = H / 2;
    var xOff = startX;

    // ── X matrix cells ──
    var pc = cellColors("purple");
    var iY = centerY - inputH / 2;
    for (var t = 0; t < T; t++) {
      for (var d = 0; d < D_MODEL; d++) {
        state[combCells[t][d].id] = {
          x: xOff + t * (CELL_W + gap),
          y: iY + d * (CELL_H + gap),
          w: CELL_W, h: CELL_H,
          opacity: 1, bg: pc.bg, color: pc.text
        };
      }
    }
    state[matBracket.id] = {
      x: xOff - 6, y: iY - 4,
      w: inputW + 12, h: inputH + 8,
      opacity: 1, borderColor: "var(--attn-purple)"
    };

    // Token labels above X (tokenEls, compact style matching step 9)
    for (var t = 0; t < T; t++) {
      state[tokenEls[t].id] = {
        x: xOff + t * (CELL_W + gap) + (CELL_W - CHIP_W) / 2, y: iY - 20,
        w: CHIP_W, h: 16,
        opacity: 0.5,
        bg: "transparent", color: resolveTextColor(),
        fontSize: "0.6rem",
        borderRadius: "0px",
        padding: "0px"
      };
    }

    // "X" title above token labels
    state[miscLabels[3].id] = { x: xOff + inputW / 2 - 4, y: iY - 38, opacity: 1 };
    miscLabels[3].textContent = "X";
    miscLabels[3].style.fontSize = "0.85rem";
    miscLabels[3].style.fontWeight = "700";
    miscLabels[3].style.color = "var(--attn-purple)";

    // d_model vertical label (left side of X)
    state[dModelLabel.id] = {
      x: xOff - 28, y: iY + inputH / 2 - 30,
      w: 20, h: 60, opacity: 0.6
    };

    // · operator
    opSymbols[0].textContent = "\u00B7";
    state[opSymbols[0].id] = {
      x: xOff + inputW + dotSpacing / 2 - 3, y: centerY - 10,
      opacity: 0.7
    };
    xOff += inputW + dotSpacing;

    // ── W_K matrix (standard): row=d_model, col=d_head ──
    var wY = centerY - wMatH / 2;
    var wc = cellColors("k");
    for (var d = 0; d < D_MODEL; d++) {
      for (var h = 0; h < D_HEAD; h++) {
        state[wkCells[d][h].id] = {
          x: xOff + h * (wCellW + wGap),
          y: wY + d * (wCellH + wGap),
          w: wCellW, h: wCellH,
          opacity: 1, bg: wc.bg, color: wc.text,
          fontSize: "0.5rem"
        };
      }
    }
    state[wkBracket.id] = {
      x: xOff - 4, y: wY - 4,
      w: wMatW + 8, h: wMatH + 8,
      opacity: 1, borderColor: "var(--attn-orange)"
    };
    state[wkLabel.id] = { x: xOff + wMatW / 2 - 12, y: wY - 22, opacity: 1 };
    wkLabel.innerHTML = "<i>W</i><sub>K</sub>";

    // d_head horizontal label below W_K
    state[dHeadLabel.id] = {
      x: xOff, y: wY + wMatH + 10,
      opacity: 0.6
    };

    // = operator
    state[opSymbols[2].id] = {
      x: xOff + wMatW + eqSpacing / 2 - 5, y: centerY - 10,
      opacity: 0.7
    };
    xOff += wMatW + eqSpacing;

    // ── K matrix (standard view): row=token, col=d_head ──
    var kY = centerY - kMatH / 2;
    var kc = cellColors("k");
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        // Standard: t=row (token), h=col (d_head)
        if (h === 2) kCells[t][h].textContent = "\u22EF"; // ⋯ (d_head column ellipsis)
        else if (t === 6) kCells[t][h].textContent = (Math.random() * 2 - 1).toFixed(2);

        state[kCells[t][h].id] = {
          x: xOff + h * (CELL_W + gap),
          y: kY + t * (kCellH + gap),
          w: CELL_W, h: kCellH,
          opacity: goingForward ? 0.001 : 1, bg: kc.bg, color: kc.text
        };
      }
    }
    state[kBracket.id] = {
      x: xOff - 6, y: kY - 4,
      w: kMatW + 12, h: kMatH + 8,
      opacity: 1, borderColor: "var(--attn-orange)"
    };

    // Token labels on right of K rows — miscLabels[16..23]
    for (var t = 0; t < T; t++) {
      var klbl = miscLabels[16 + t];
      klbl.textContent = TOKENS[t].text;
      klbl.style.fontSize = "0.5rem";
      klbl.style.fontWeight = "500";
      klbl.style.textAlign = "left";
      klbl.style.color = "var(--attn-text-muted)";
      state[klbl.id] = {
        x: xOff + kMatW + 8,
        y: kY + t * (kCellH + gap) + kCellH / 2 - 6,
        opacity: 0.5
      };
    }

    // "K" title above K matrix
    state[kLabel.id] = { x: xOff + kMatW / 2 - 6, y: kY - 26, opacity: 1 };
    kLabel.textContent = "K";

    // d_head horizontal label below K
    dimLabels[0].innerHTML = "d<sub>head</sub>&nbsp;= 256";
    dimLabels[0].style.writingMode = "";
    dimLabels[0].style.transform = "";
    dimLabels[0].style.fontStyle = "italic";
    dimLabels[0].style.fontFamily = "var(--attn-mono)";
    dimLabels[0].style.color = "var(--attn-text-muted)";
    state[dimLabels[0].id] = {
      x: xOff + kMatW / 2 - 40, y: kY + kMatH + 10,
      w: 80, h: 20, opacity: 0.6
    };

    return state;
  }

  // Post-animation: per-token, column-by-column dot product for step 10
  postAnimFns[10] = function () {
    if (reducedMotion) return;
    var tl = gsap.timeline();
    subAnimTimeline = tl;

    // Initially hide all K data cells (non-ellipsis only)
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        kCells[t][h].style.opacity = "0";
      }
    }

    // Highlight colors
    var highlightPurple = "hsl(270, 50%, 55%, 0.35)";
    var highlightOrange = "hsl(30, 50%, 55%, 0.35)";
    var pc = cellColors("purple");
    var wc = cellColors("k");

    // For each token, highlight X column then sweep W_K columns
    // X column t (d_model values) · W_K column h (d_model values) → K[t][h]
    for (var t = 0; t < T; t++) {
      (function (t) {
        // Collect X column elements (combCells[t][0..D_MODEL-1])
        var xColEls = [];
        for (var d = 0; d < D_MODEL; d++) xColEls.push(combCells[t][d]);

        // Highlight X column
        tl.to(xColEls, {
          backgroundColor: highlightPurple,
          duration: 0.04
        });

        // For each d_head column in W_K
        for (var h = 0; h < D_HEAD; h++) {
          (function (h) {
            // Collect W_K column h elements (wkCells[0..D_MODEL-1][h])
            var wkColEls = [];
            for (var d = 0; d < D_MODEL; d++) wkColEls.push(wkCells[d][h]);

            // Flash W_K column highlight
            tl.to(wkColEls, {
              backgroundColor: highlightOrange,
              duration: 0.03
            });

            // Fade in K cell
            tl.to(kCells[t][h], {
              opacity: 1,
              duration: 0.04
            }, ">");

            // De-highlight W_K column
            tl.to(wkColEls, {
              backgroundColor: wc.bg,
              duration: 0.03
            }, ">");
          })(h);
        }

        // De-highlight X column
        tl.to(xColEls, {
          backgroundColor: pc.bg,
          duration: 0.04
        });
      })(t);
    }
  };

  function computeStep11(goingForward) {
    // Step 11: Q · K^T Setup — show Q and K^T side by side as ingredients
    // Q row labels (miscLabels[8..15]) smoothly animate from step 10's shrunk corner.
    // K^T column labels (miscLabels[0..7]) fade in from invisible — no force-hide needed.
    // Force-hide miscLabels[16..23] (step 10's K row labels) to prevent morphing.
    if (goingForward) {
      for (var fi = 16; fi <= 23; fi++) miscLabels[fi].style.opacity = "0";
    }

    var gap = CELL_GAP;

    var state = {};
    hideAll(state);

    // Q in standard orientation (rows=T, cols=D_HEAD)
    var qMatW = D_HEAD * (CELL_W + gap) - gap;  // 4 cols
    var qMatH = T * (CELL_H + gap) - gap;       // 8 rows

    // K^T (same transposed layout as step 10: cols=T, rows=D_HEAD)
    var kCellH = CELL_H;
    var kMatW = T * (CELL_W + gap) - gap;        // 8 cols
    var kMatH = D_HEAD * (kCellH + gap) - gap;   // 4 rows

    // Center horizontally with · between
    var dotSpacing = 56;
    var totalW = qMatW + dotSpacing + kMatW;
    var startX = (W - totalW) / 2;
    var centerY = H / 2;

    var qX = startX;
    var qY = centerY - qMatH / 2;
    var kX = startX + qMatW + dotSpacing;
    var kY = centerY - kMatH / 2;

    // Q cells (standard orientation: row=token, col=d_head)
    var qc = cellColors("q");
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        state[qCells[t][h].id] = {
          x: qX + h * (CELL_W + gap),
          y: qY + t * (CELL_H + gap),
          w: CELL_W, h: CELL_H,
          opacity: 1, bg: qc.bg, color: qc.text,
          fontSize: ""
        };
      }
    }
    state[qBracket.id] = {
      x: qX - 6, y: qY - 4,
      w: qMatW + 12, h: qMatH + 8,
      opacity: 1, borderColor: "var(--attn-blue)"
    };
    state[qLabel.id] = { x: qX + qMatW / 2 - 4, y: qY - 26, opacity: 1 };
    qLabel.textContent = "Q";
    qLabel.style.fontSize = "";

    // K^T cells (transposed: col=token, row=d_head — same as step 10)
    var kc = cellColors("k");
    for (var t = 0; t < T; t++) {
      for (var h = 0; h < D_HEAD; h++) {
        // Override ellipsis for transposed K^T view (same as step 10)
        if (t === 6 && h === 2) kCells[t][h].textContent = "\u22EE";
        else if (h === 2) kCells[t][h].textContent = "\u22EE";
        else if (t === 6) kCells[t][h].textContent = (Math.random() * 2 - 1).toFixed(2);

        state[kCells[t][h].id] = {
          x: kX + t * (CELL_W + gap),
          y: kY + h * (kCellH + gap),
          w: CELL_W, h: kCellH,
          opacity: 1, bg: kc.bg, color: kc.text
        };
      }
    }
    state[kBracket.id] = {
      x: kX - 6, y: kY - 4,
      w: kMatW + 12, h: kMatH + 8,
      opacity: 1, borderColor: "var(--attn-orange)"
    };
    state[kLabel.id] = { x: kX + kMatW / 2 - 8, y: kY - 40, opacity: 1 };
    kLabel.textContent = "K\u1D40";

    // · operator between Q and K^T
    opSymbols[0].textContent = "\u00B7";
    state[opSymbols[0].id] = {
      x: qX + qMatW + dotSpacing / 2 - 3, y: centerY - 10,
      opacity: 0.7
    };

    // Token labels along left of Q (rows = query tokens)
    for (var i = 0; i < T; i++) {
      state[miscLabels[8 + i].id] = {
        x: qX - 40,
        y: qY + i * (CELL_H + gap) + CELL_H / 2 - 6,
        opacity: 0.5
      };
      miscLabels[8 + i].textContent = TOKENS[i].text;
      miscLabels[8 + i].style.fontSize = "0.5rem";
      miscLabels[8 + i].style.fontWeight = "500";
      miscLabels[8 + i].style.textAlign = "right";
      miscLabels[8 + i].style.width = "";
      miscLabels[8 + i].style.color = "var(--attn-text-muted)";
    }

    // Token labels along top of K^T (cols = key tokens)
    for (var i = 0; i < T; i++) {
      state[miscLabels[i].id] = {
        x: kX + i * (CELL_W + gap) + CELL_W / 2 - 12,
        y: kY - 22,
        opacity: 0.5
      };
      miscLabels[i].textContent = TOKENS[i].text;
      miscLabels[i].style.fontSize = "0.58rem";
      miscLabels[i].style.fontWeight = "500";
      miscLabels[i].style.color = "var(--attn-text-muted)";
    }

    return state;
  }

  function computeStep12(goingForward) {
    // Step 12: Attention Scores — 8×8 score matrix centered
    var gap = CELL_GAP;

    var state = {};
