    }

    // Concat grid cells — no text, colored blocks on top of section backgrounds
    // Cell pool mapping: headCells[r][0..6] (7 cols) + inputCells2[r][0..4] (5 cols) = 12 cols
    for (var section = 0; section < 4; section++) {
      var secX = concatX + section * (sectionW + sectionGap);
      for (var c = 0; c < COLS_PER_SECTION; c++) {
        var globalCol = section * COLS_PER_SECTION + c;
        var cellX = secX + c * (gridCellW + gridGap);
        for (var r = 0; r < T; r++) {
          var cell = globalCol < D_MODEL
            ? headCells[r][globalCol]
