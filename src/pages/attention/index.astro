  ];

  // ═══ ANIMATION ENGINE ═══

  function applyState(state, animate) {
    var duration = reducedMotion ? 0 : 0.5;
    var ease = "power2.inOut";
    var stagger = reducedMotion ? 0 : 0.012;

    // Collect elements into: fade-out, move, fade-in
    var fadeOut = [];
    var move = [];
    var fadeIn = [];

    getAllPoolEls().forEach(function (e) {
      if (!e) return;
      var target = state[e.id];
      var opStr = e.style.opacity;
      var isVisible = opStr !== "" && opStr !== "0" && parseFloat(opStr) > 0.01;

      if (!target || target.opacity === 0 || target.opacity === undefined) {
        if (isVisible) fadeOut.push(e);
      } else if (!isVisible) {
        fadeIn.push({ el: e, target: target });
      } else {
        move.push({ el: e, target: target });
      }
    });

    if (!animate) {
      // Instant — no animation
      fadeOut.forEach(function (e) { e.style.opacity = "0"; });
      move.concat(fadeIn).forEach(function (item) {
        applyTargetInstant(item.el, item.target);
      });
      return Promise.resolve();
    }

    return new Promise(function (resolve) {
      var resolved = false;
      function done() { if (!resolved) { resolved = true; resolve(); } }

      var tl = gsap.timeline({
        onComplete: done,
        defaults: { ease: ease }
      });

      // Phase 1: Fade out departing elements
      // Cap total stagger spread so large groups (e.g. 192 heatmap cells) fade as a block
      if (fadeOut.length > 0) {
        var maxFadeOutSpread = 0.02;
        var fadeOutStagger = fadeOut.length > 1 ? Math.min(stagger * 0.3, maxFadeOutSpread / (fadeOut.length - 1)) : 0;
        tl.to(fadeOut, {
          opacity: 0,
          duration: duration * 0.35,
          stagger: { each: fadeOutStagger, from: "start" }
        }, 0);
      }

      // Phase 2: Move persistent elements (position + opacity + size)
      // Cap total stagger spread so elements move as a cohesive group
      // regardless of how many elements are animating
      if (move.length > 0) {
        var maxMoveSpread = 0; // all move elements animate simultaneously (block movement)
        var moveStagger = move.length > 1 ? Math.min(stagger, maxMoveSpread / (move.length - 1)) : 0;
        move.forEach(function (item, i) {
          var props = buildTweenProps(item.target);
          props.duration = duration * 0.8;
          // Apply colors immediately for moves (GSAP can't tween CSS var colors)
          applyColors(item.el, item.target);
          tl.to(item.el, props, duration * 0.1 + i * moveStagger);
        });
      }

      // Phase 3: Fade in entering elements
      // Same cap for fade-in stagger
      if (fadeIn.length > 0) {
        var maxFadeSpread = 0.02;
        var fadeStagger = fadeIn.length > 1 ? Math.min(stagger, maxFadeSpread / (fadeIn.length - 1)) : 0;
        fadeIn.forEach(function (item, i) {
          var e = item.el;
          var t = item.target;
          // Position + style instantly (invisible)
          applyTargetInstant(e, t);
          e.style.opacity = "0";

          tl.to(e, {
            opacity: t.opacity !== undefined ? t.opacity : 1,
            duration: duration * 0.45,
          }, duration * 0.35 + i * fadeStagger);
        });
      }

      // Safety timeout
      setTimeout(done, 2500);
    });
  }

  function applyColors(e, t) {
    // Only set bg instantly if it's a CSS var (GSAP can't tween vars).
    // Explicit color values are tweened via buildTweenProps.
    if (t.bg && t.bg.indexOf("var(") !== -1) e.style.backgroundColor = t.bg;
    if (t.color) e.style.color = t.color;
    if (t.borderColor) e.style.borderColor = t.borderColor;
    // fontSize, borderRadius, padding are tweened via buildTweenProps
  }

  function buildTweenProps(t) {
    var props = {};
    if (t.x !== undefined) props.left = t.x + "px";
    if (t.y !== undefined) props.top = t.y + "px";
    if (t.w !== undefined) props.width = t.w + "px";
    if (t.h !== undefined) props.height = t.h + "px";
    if (t.opacity !== undefined) props.opacity = t.opacity;
    if (t.fontSize !== undefined) props.fontSize = t.fontSize || "";
    if (t.borderRadius !== undefined) props.borderRadius = t.borderRadius;
    if (t.padding !== undefined) props.padding = t.padding;
    // Tween backgroundColor only for explicit color values (GSAP can't tween CSS vars)
    if (t.bg && t.bg.indexOf("var(") === -1) props.backgroundColor = t.bg;
    if (t.rotation !== undefined) props.rotation = t.rotation;
    return props;
  }

  function applyTargetInstant(e, t) {
    if (t.x !== undefined) e.style.left = t.x + "px";
    if (t.y !== undefined) e.style.top = t.y + "px";
    if (t.w !== undefined) e.style.width = t.w + "px";
    if (t.h !== undefined) e.style.height = t.h + "px";
    if (t.opacity !== undefined) e.style.opacity = t.opacity;
    if (t.bg) e.style.backgroundColor = t.bg;
    if (t.color) e.style.color = t.color;
    if (t.borderColor) e.style.borderColor = t.borderColor;
    if (t.fontSize !== undefined) e.style.fontSize = t.fontSize || "";
    if (t.borderRadius !== undefined) e.style.borderRadius = t.borderRadius;
    if (t.padding !== undefined) e.style.padding = t.padding;
    if (t.rotation !== undefined) e.style.transform = "rotate(" + t.rotation + "deg)";
  }

  // ═══ MULTI-PHASE SEQUENCE ENGINE ═══

  function applyStateSequence(phases, animate) {
    var mySeqId = ++sequenceId;
    if (!animate || reducedMotion || phases.length === 0) {
      // Instant: run all onStart callbacks, then apply last phase
      phases.forEach(function (p) { if (p.onStart) p.onStart(); });
      var last = phases[phases.length - 1];
      return applyState(last.state, false);
    }
    var idx = 0;
    function runPhase() {
      if (sequenceId !== mySeqId) return Promise.resolve(); // cancelled
      var phase = phases[idx];
      if (phase.onStart) phase.onStart();
      return applyState(phase.state, true).then(function () {
        idx++;
        if (idx < phases.length && sequenceId === mySeqId) {
          return new Promise(function (resolve) {
            setTimeout(function () {
              if (sequenceId !== mySeqId) { resolve(); return; }
              runPhase().then(resolve);
            }, phases[idx - 1].delay || 0);
          });
        }
      });
    }
    return runPhase();
  }

  // ═══ STEP CONTROLLER ═══

  var backBtn = document.getElementById("attn-back");
  var nextBtn = document.getElementById("attn-next");
  var counterEl = document.getElementById("attn-counter");
  var annStep = document.getElementById("attn-ann-step");
  var annTitle = document.getElementById("attn-ann-title");
  var annBody = document.getElementById("attn-ann-body");
  var annDims = document.getElementById("attn-ann-dims");

  function updateAnnotation(step) {
    var d = STEP_DATA[step - 1];
    annStep.textContent = "Step " + step;
    annTitle.textContent = d.title;
    annBody.innerHTML = d.body;
    annDims.innerHTML = d.dims;
    counterEl.textContent = "Step " + step + " / " + TOTAL_STEPS;

    // Wire up detail toggles
    var toggles = annBody.querySelectorAll(".attn-detail-toggle");
    toggles.forEach(function (btn) {
      var closedText = btn.textContent; // preserve original label
      btn.addEventListener("click", function () {
        var detailId = "detail-" + btn.getAttribute("data-detail");
        var content = document.getElementById(detailId);
        if (content) {
          var isOpen = content.classList.toggle("open");
          btn.textContent = isOpen ? "Less \u25BE" : closedText;
        }
      });
    });
  }

  function updateButtons() {
    backBtn.disabled = currentStep <= 1;
    nextBtn.disabled = currentStep >= TOTAL_STEPS;
  }

  function goToStep(n, animate) {
    if (n < 1 || n > TOTAL_STEPS) return;
    if (animate === undefined) animate = true;
    var goingForward = n > currentStep;

    // Kill any sub-animation timeline
    if (subAnimTimeline) {
      subAnimTimeline.kill();
      subAnimTimeline = null;
    }
    // Cancel any running sequence
    sequenceId++;

    // Kill any in-progress tweens for rapid clicking
    gsap.killTweensOf(getAllPoolEls());

    // Hide tooltip and clear row hover if visible
    if (tooltip) { tooltip.style.opacity = "0"; tooltip.style.transform = ""; }
    clearRowHover();

    // Reset shared label styles to defaults before layout recomputation
    miscLabels.forEach(function (lb) {
      lb.style.fontSize = "";
      lb.style.fontWeight = "";
      lb.style.fontStyle = "";
      lb.style.fontFamily = "";
      lb.style.color = "";
      lb.style.filter = "";
      lb.style.background = "";
      lb.style.width = "";
      lb.style.height = "";
      lb.style.borderRadius = "";
      lb.style.textAlign = "";
      lb.style.borderTop = "";
      lb.style.borderRight = "";
      lb.style.borderBottom = "";
      lb.style.borderLeft = "";
      lb.className = "attn-el attn-label"; // reset any extra classes
      lb.innerHTML = ""; // clear any HTML legend content
    });
    // Clear any pill borders/radius/content from step 4 and step 8
    for (var bi = 0; bi < T; bi++) {
      embPills[bi].style.borderRight = "";
      embPills[bi].style.borderRadius = "";
      embPills[bi].style.whiteSpace = "";
      embPills[bi].style.display = "";
      embPills[bi].style.alignItems = "";
      embPills[bi].style.justifyContent = "";
      embPills[bi].style.fontFamily = "";
      embPills[bi].style.fontSize = "";
      embPills[bi].style.lineHeight = "";
      embPills[bi].style.color = "";
      embPills[bi].textContent = "";
    }
    // Clear d_model label vertical orientation from step 8
    miscLabels[10].style.writingMode = "";
    miscLabels[10].style.transform = "";
    // (miscLabels[11] border cleanup now handled by general reset above)
    // Only reset cell font sizes when entering step 4 (not when leaving it,
    // which would cause a visible font-size jump before the fade-out animation)
    if (n <= 4) {
      for (var bi = 0; bi < T; bi++) {
        for (var bd = 0; bd < D_MODEL; bd++) {
          embCells[bi][bd].style.fontSize = "";
          posCells[bi][bd].style.fontSize = "";
        }
      }
    }
    dimLabels.forEach(function (lb) {
      lb.style.fontSize = "";
      lb.style.fontWeight = "";
      lb.style.fontStyle = "";
      lb.style.fontFamily = "";
      lb.style.writingMode = "";
      lb.style.transform = "";
      lb.style.color = "";
      lb.style.width = "";
      lb.style.height = "";
    });
    // Reset attnLabel style overrides from step 13/14
    attnLabel.style.fontSize = "";
    attnLabel.style.fontWeight = "";
    // Reset altLabel styles from step 14
    altLabel.style.fontSize = "";
    altLabel.style.fontWeight = "";
    altLabel.style.color = "";
    // Restore scoreCells text (step 14 sets color:transparent but doesn't clear text)
    for (var sr = 0; sr < T; sr++) {
      for (var sc = 0; sc < T; sc++) {
        scoreCells[sr][sc].textContent = ATTN_SCORES[sr][sc].toFixed(1);
      }
    }
    opSymbols.forEach(function (op) {
      op.style.fontSize = "";
    });
    arrowEls.forEach(function (a) {
      a.textContent = "\u2192";
      a.style.fontSize = "";
      a.style.color = "";
      a.style.border = "";
      a.style.borderRadius = "";
      a.style.background = "";
    });
    // Reset head card inline styles (step 8 sets zIndex, step 16 sets border/bg/radius)
    headCards.forEach(function (card) {
      card.style.zIndex = "";
      card.style.borderRadius = "";
      card.style.border = "";
      card.style.background = "";
      card.textContent = "";
    });
    // Reset outLabel text (steps 16-17 change to "Head₁")
    outLabel.textContent = "Output";
    outLabel.style.fontSize = "";
    outLabel.style.fontWeight = "";

    // Restore qCells ellipsis text after step 9/10's transposed view
    // qCells[T][D_HEAD]: ellipsisRow=6, ellipsisCol=2
    for (var qt = 0; qt < T; qt++) {
      for (var qh = 0; qh < D_HEAD; qh++) {
        if (qt === 6 && qh === 2) qCells[qt][qh].textContent = "\u22F1";
        else if (qt === 6) qCells[qt][qh].textContent = "\u22EE";
        else if (qh === 2) qCells[qt][qh].textContent = "\u22EF";
      }
    }

    // Restore kCells ellipsis text after step 10's transposed view
    // kCells[T][D_HEAD]: ellipsisRow=6, ellipsisCol=2
    for (var kt = 0; kt < T; kt++) {
      for (var kh = 0; kh < D_HEAD; kh++) {
        if (kt === 6 && kh === 2) kCells[kt][kh].textContent = "\u22F1";
        else if (kt === 6) kCells[kt][kh].textContent = "\u22EE";
        else if (kh === 2) kCells[kt][kh].textContent = "\u22EF";
      }
    }

    // Clear token inline style overrides from steps 1-2 when entering steps 3-5
    // (these match CSS class defaults, so no visual flash).
    // Steps 6+ set their own small fontSize/borderRadius/padding — clearing those
    // would cause a momentary pop to the larger CSS defaults before GSAP re-applies.
    if (n >= 3 && n <= 5) {
      tokenEls.forEach(function (e) {
        e.style.fontSize = "";
        e.style.borderRadius = "";
        e.style.padding = "";
      });
    }

    // Ensure combCells show correct values for the target step.
    // Skip the normalize guard for step 6 going forward — the onStart
    // callback on phase 2 handles that so phase 1 keeps combined values.
    if (n >= 7 && !combCellsNormalized) { setCombCellsNormalized(); }
    if (n === 6 && !goingForward && !combCellsNormalized) { setCombCellsNormalized(); }
    if (n <= 5 && combCellsNormalized)  { setCombCellsCombined(); }

    currentStep = n;
    updateAnnotation(n);
    updateButtons();

    measure();
    var result = layoutFns[n](goingForward);
    var mySeq = sequenceId; // snapshot for stale-check in .then()

    // Check if layout returned a sequence (multi-phase step)
    if (result && result.sequence) {
      if (goingForward && animate) {
        applyStateSequence(result.sequence, true);
      } else {
        // Going backward or no animation: show final state
        var lastPhase = result.sequence[result.sequence.length - 1];
        applyState(lastPhase.state, false);
      }
    } else {
      applyState(result, animate).then(function () {
        // Run post-animation only if no subsequent goToStep() has fired
        if (sequenceId === mySeq && goingForward && animate && postAnimFns[n]) {
          postAnimFns[n]();
        }
      });
    }
  }

  backBtn.addEventListener("click", function () {
    goToStep(currentStep - 1);
  });
  nextBtn.addEventListener("click", function () {
    goToStep(currentStep + 1);
  });

  // Keyboard navigation
  document.addEventListener("keydown", function (e) {
    if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
    if (e.key === "ArrowRight" || e.key === "ArrowDown") {
      e.preventDefault();
      goToStep(currentStep + 1);
    } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
      e.preventDefault();
      goToStep(currentStep - 1);
    }
  });

  // ═══ HEATMAP INTERACTION (Steps 13, 14 & 16) ═══
  var tooltip = null;

  var hoveredRow = -1;

  function getHoverPools() {
    if (currentStep === 14) return [attnCells, scoreCells, altCells];
    return [attnCells];
  }

  function findMaxAttended(weights, r) {
    var maxVal = -1, maxC = 0;
    for (var i = 0; i <= r; i++) {
      if (weights[r][i] > maxVal) { maxVal = weights[r][i]; maxC = i; }
    }
    return { col: maxC, val: maxVal };
  }

  function setRowHover(row) {
    if (hoveredRow === row) return;
    clearRowHover();
    hoveredRow = row;
    var pools = getHoverPools();
    for (var pi = 0; pi < pools.length; pi++) {
      for (var r = 0; r < T; r++) {
        for (var c = 0; c < T; c++) {
          if (r === row) {
            pools[pi][r][c].classList.add("attn-row-active");
          } else {
            pools[pi][r][c].classList.add("attn-row-dim");
          }
        }
      }
    }
    // Dim non-hovered row query labels, highlight hovered one
    // Step 14 has per-matrix row labels at indices 8, 32, 48
    var rowLabelOffsets = currentStep === 14 ? [8, 32, 48] : [8];
    for (var oi = 0; oi < rowLabelOffsets.length; oi++) {
      for (var r = 0; r < T; r++) {
        if (r === row) {
          miscLabels[rowLabelOffsets[oi] + r].classList.add("attn-query-highlight");
        } else {
          miscLabels[rowLabelOffsets[oi] + r].classList.add("attn-row-dim");
        }
      }
    }
  }

  function clearRowHover() {
    if (hoveredRow < 0) return;
    // Always clear all 3 pools — removing classes from hidden elements is harmless
    var allPools = [attnCells, scoreCells, altCells];
    for (var pi = 0; pi < allPools.length; pi++) {
      for (var r = 0; r < T; r++) {
        for (var c = 0; c < T; c++) {
          allPools[pi][r][c].classList.remove("attn-row-dim", "attn-row-active");
        }
      }
    }
    // Clear all possible row label offsets (harmless on hidden elements)
    var allOffsets = [8, 32, 48];
    for (var oi = 0; oi < allOffsets.length; oi++) {
      for (var r = 0; r < T; r++) {
        miscLabels[allOffsets[oi] + r].classList.remove("attn-row-dim", "attn-query-highlight");
      }
    }
    hoveredRow = -1;
  }

  viz.addEventListener("mouseover", function (e) {
    if (currentStep !== 13 && currentStep !== 14 && currentStep !== 16) return;
    var cell = e.target.closest("[data-row]");
    if (!cell) return;
    var r = parseInt(cell.dataset.row);
    var c = parseInt(cell.dataset.col);

    if (!tooltip) {
      tooltip = el("div", "attn-heat-tooltip");
      viz.appendChild(tooltip);
    }

    if (currentStep === 13 || currentStep === 14) {
      // Full-row highlight: dim all other rows
      setRowHover(r);

      if (currentStep === 14) {
        // Multi-head tooltip
        var contentMax = findMaxAttended(ATTN_WEIGHTS, r);
        var prevMax = findMaxAttended(PREV_TOKEN_WEIGHTS, r);
        var syntaxMax = findMaxAttended(SYNTAX_WEIGHTS, r);
        tooltip.textContent = '\u201C' + TOKENS[r].text + '\u201D \u2192 content: ' + TOKENS[contentMax.col].text + '(' + contentMax.val.toFixed(2) + '), previous: ' + TOKENS[prevMax.col].text + '(' + prevMax.val.toFixed(2) + '), syntax: ' + TOKENS[syntaxMax.col].text + '(' + syntaxMax.val.toFixed(2) + ')';
      } else {
        var maxInfo = findMaxAttended(ATTN_WEIGHTS, r);
        tooltip.textContent = '\u201C' + TOKENS[r].text + '\u201D attends most to \u201C' + TOKENS[maxInfo.col].text + '\u201D (' + maxInfo.val.toFixed(2) + ')';
      }

      // Position tooltip centered below the matrix area
      if (currentStep === 14) {
        // Bounding box as union of all 3 matrices (scoreCells=left, altCells=right)
        var firstCell = scoreCells[0][0];
        var lastCell = altCells[T - 1][T - 1];
        var matLeft = parseFloat(firstCell.style.left);
        var matRight = parseFloat(lastCell.style.left) + parseFloat(lastCell.style.width);
        var matBottom = parseFloat(lastCell.style.top) + parseFloat(lastCell.style.height);
        tooltip.style.left = (matLeft + (matRight - matLeft) / 2) + "px";
        tooltip.style.top = (matBottom + 8) + "px";
      } else {
        var lastCell = attnCells[T - 1][T - 1];
        var firstCell = attnCells[0][0];
        var matLeft = parseFloat(firstCell.style.left);
        var matRight = parseFloat(lastCell.style.left) + parseFloat(lastCell.style.width);
        var matBottom = parseFloat(lastCell.style.top) + parseFloat(lastCell.style.height);
        tooltip.style.left = (matLeft + (matRight - matLeft) / 2) + "px";
        tooltip.style.top = (matBottom + 8) + "px";
      }
      tooltip.style.transform = "translateX(-50%)";
      tooltip.style.opacity = "1";
    } else {
      // Per-cell highlight for value weighting step (step 16)
      cell.classList.add("attn-cell-hover");
      tooltip.textContent = '"' + TOKENS[r].text + '" \u2192 "' + TOKENS[c].text + '": ' + ATTN_WEIGHTS[r][c].toFixed(3);
      tooltip.style.left = (parseFloat(cell.style.left) + 50) + "px";
      tooltip.style.top = (parseFloat(cell.style.top) - 28) + "px";
      tooltip.style.transform = "";
      tooltip.style.opacity = "1";
    }
  });

  viz.addEventListener("mousemove", function (e) {
    if ((currentStep !== 13 && currentStep !== 14) || hoveredRow < 0) return;
    // Clear row hover if mouse leaves the matrix bounding box
    var vizRect = viz.getBoundingClientRect();
    var mx = e.clientX - vizRect.left;
    var my = e.clientY - vizRect.top;

    var first, last;
    if (currentStep === 14) {
      first = scoreCells[0][0];
      last = altCells[T - 1][T - 1];
    } else {
      first = attnCells[0][0];
      last = attnCells[T - 1][T - 1];
    }
    var matLeft = parseFloat(first.style.left);
    var matTop = parseFloat(first.style.top);
    var matRight = parseFloat(last.style.left) + parseFloat(last.style.width);
    var matBottom = parseFloat(last.style.top) + parseFloat(last.style.height);
    if (mx < matLeft || mx > matRight || my < matTop || my > matBottom) {
      clearRowHover();
      if (tooltip) tooltip.style.opacity = "0";
    } else {
      // Update hovered row based on y position within matrix
      var gap = CELL_GAP;
      var cellH = currentStep === 14 ? Math.round(CELL_H * 0.9) : CELL_H;
      var rowIdx = Math.floor((my - matTop) / (cellH + gap));
      if (rowIdx >= 0 && rowIdx < T && rowIdx !== hoveredRow) {
        setRowHover(rowIdx);
        // Update tooltip for new row
        if (currentStep === 14) {
          var contentMax = findMaxAttended(ATTN_WEIGHTS, rowIdx);
          var prevMax = findMaxAttended(PREV_TOKEN_WEIGHTS, rowIdx);
          var syntaxMax = findMaxAttended(SYNTAX_WEIGHTS, rowIdx);
          if (tooltip) {
            tooltip.textContent = '\u201C' + TOKENS[rowIdx].text + '\u201D \u2192 content: ' + TOKENS[contentMax.col].text + '(' + contentMax.val.toFixed(2) + '), previous: ' + TOKENS[prevMax.col].text + '(' + prevMax.val.toFixed(2) + '), syntax: ' + TOKENS[syntaxMax.col].text + '(' + syntaxMax.val.toFixed(2) + ')';
          }
        } else {
          var maxInfo = findMaxAttended(ATTN_WEIGHTS, rowIdx);
          if (tooltip) {
            tooltip.textContent = '\u201C' + TOKENS[rowIdx].text + '\u201D attends most to \u201C' + TOKENS[maxInfo.col].text + '\u201D (' + maxInfo.val.toFixed(2) + ')';
          }
        }
      }
    }
  });

  viz.addEventListener("mouseout", function (e) {
    if (currentStep === 13 || currentStep === 14) {
      // Only clear if mouse actually left the viz container
      if (!e.relatedTarget || !viz.contains(e.relatedTarget)) {
        clearRowHover();
        if (tooltip) tooltip.style.opacity = "0";
      }
    } else {
      var cell = e.target.closest("[data-row]");
      if (cell) cell.classList.remove("attn-cell-hover");
      if (tooltip) tooltip.style.opacity = "0";
    }
  });

  // ═══ RESPONSIVE ═══
  var resizeTimer;
  var ro = new ResizeObserver(function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      goToStep(currentStep, false);
    }, 100);
  });
  ro.observe(viz);

  // Theme change observer
  var themeObserver = new MutationObserver(function () {
    goToStep(currentStep, false);
  });
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"]
  });

  // ═══ INIT ═══
  createPool();
  measure();

  // Set all elements invisible initially
  getAllPoolEls().forEach(function (e) {
    if (e) {
      e.style.opacity = "0";
      e.style.left = "0px";
      e.style.top = "0px";
    }
  });

  // Show step 1
  goToStep(1, false);
  // After a brief moment, re-render with animation ready
  setTimeout(function () {
    goToStep(1, false);
  }, 50);
});
</script>
