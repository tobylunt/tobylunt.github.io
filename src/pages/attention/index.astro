    miscLabels[5].textContent = "";
    miscLabels[5].style.width = "0px";
    miscLabels[5].style.height = (pathBotY - pathTopY) + "px";
    miscLabels[5].style.borderLeft = dashStyle;
    state[miscLabels[5].id] = { x: pathRightX, y: pathTopY, opacity: 1 };

