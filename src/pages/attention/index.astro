    arrowEls[0].style.fontSize = "1.3rem";
    arrowEls[0].style.color = "var(--attn-text-muted)";
    state[arrowEls[0].id] = {
      x: arrowX, y: centerY - 10, opacity: 0.7
    };

    // ── Right zone: Concatenated output — 4 colored grid sections, no text ──
    var concatX = cardsX + totalCardsW + arrowGap + labelW;
    var concatY = centerY - concatMatH / 2;

    // Background rectangles behind each concat section (so gaps show section color, not page bg)
    for (var si = 0; si < 4; si++) {
