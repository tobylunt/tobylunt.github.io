  function computeStep17(goingForward) {
    // Step 17: Head Concatenation — 4 head cards → arrow → gridline concat output
    var state = {};
    hideAll(state);
    var gap = CELL_GAP;
    var dark = isDark();

    // ── Sizing ──
    var oMatH = T * (CELL_H + gap) - gap;
    var cardW = 60;
    var cardH = Math.round(oMatH * 0.65);
    var cardGap = 10;

    // Head card colors (match step 8 palette)
    var hCardColors = [
      { bg: dark ? "hsl(45,55%,28%,0.7)" : "hsl(45,70%,85%)", border: "var(--attn-head-gold)" },
      { bg: dark ? "hsl(275,40%,36%,0.55)" : "hsl(275,45%,79%)", border: "hsl(275,40%,50%,0.5)" },
      { bg: dark ? "hsl(280,35%,30%,0.45)" : "hsl(280,38%,84%)", border: "hsl(280,35%,45%,0.4)" },
      { bg: dark ? "hsl(285,30%,26%,0.35)" : "hsl(285,32%,88%)", border: "hsl(285,30%,42%,0.3)" }
    ];

    // ── Grid cell sizing (shared by head cards AND concat matrix) ──
    var gridCellW = Math.max(8, Math.round((cardW - 8) / D_HEAD)); // ~13
    var gridCellH = Math.max(4, Math.round((cardH - 8) / T));      // ~13
    var gridGap = 1;

    // ── Concat matrix: 4 sections × 3 cols each = 12 cols, no text, gridlines only ──
    var COLS_PER_SECTION = 3;
    var sectionGap = 3;
    var sectionW = COLS_PER_SECTION * (gridCellW + gridGap) - gridGap;
    var concatMatW = 4 * sectionW + 3 * sectionGap;
    var concatMatH = T * (gridCellH + gridGap) - gridGap;

    // ── Layout math ──
    var totalCardsW = 4 * cardW + 3 * cardGap;
    var arrowGap = 28;
    var labelW = 34;
    var totalW = labelW + totalCardsW + arrowGap + labelW + concatMatW + 20;
    var startX = (W - totalW) / 2;
    var centerY = H / 2;

    // ── Left zone: 4 head cards ──
    var cardsX = startX + labelW;
    var cardsTopY = centerY - cardH / 2;

    // Cell pools for each head's grid: outCells(Head1), qCells(Head2), kCells(Head3), vCells(Head4)
    var headGridCells = [outCells, qCells, kCells, vCells];

    // Grid cell colors per head — slightly brighter than card bg so grid gaps show
    var gridColors = [
      { bg: dark ? "hsl(45,55%,34%,0.8)" : "hsl(45,65%,78%)" },
      { bg: dark ? "hsl(275,40%,42%,0.7)" : "hsl(275,42%,73%)" },
      { bg: dark ? "hsl(280,35%,36%,0.6)" : "hsl(280,35%,78%)" },
      { bg: dark ? "hsl(285,30%,32%,0.5)" : "hsl(285,28%,82%)" }
    ];

    for (var ci = 0; ci < 4; ci++) {
      var cx = cardsX + ci * (cardW + cardGap);
      headCards[ci].style.zIndex = "";
      headCards[ci].style.borderRadius = "6px";
      headCards[ci].style.border = ci === 0 ? "none" : "2px solid " + hCardColors[ci].border;
      headCards[ci].style.background = hCardColors[ci].bg;
      headCards[ci].textContent = "";
      state[headCards[ci].id] = {
