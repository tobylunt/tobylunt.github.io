    var hc = cellColors("head");
    // Result color: warm teal — visually distinct from both green and gold
    var rc = {
      bg: dark ? "hsl(165, 28%, 20%, 0.35)" : "hsl(165, 22%, 86%)",
      text: dark ? "hsl(165, 40%, 66%)" : "hsl(165, 35%, 25%)"
    };
    var rcBorder = dark ? "hsl(165, 35%, 42%)" : "hsl(165, 30%, 48%)";

    // ── X matrix (left) ──
    var iX = startX;
    var iY = topY;
    for (var r = 0; r < T; r++) {
      for (var c = 0; c < cols; c++) {
        if (r === T - 2) inputCells2[r][c].textContent = "\u22EE";
        state[inputCells2[r][c].id] = {
          x: iX + c * (cellW + gap),
