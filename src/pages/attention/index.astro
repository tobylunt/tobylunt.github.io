    };
    scoreLabel.innerHTML = "<i>X</i> + MHA(<i>X</i>)";
    state[scoreLabel.id] = { x: hX + matW / 2 - 36, y: hY - 26, opacity: 1 };

    // ── Dimension labels under each matrix ──
    var dimY = topY + matH + 10;
