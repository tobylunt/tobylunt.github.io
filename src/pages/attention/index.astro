    };

    // Animate outLabel ("Head1") from above the matrix to below the Head1 card
    outLabel.innerHTML = "Head<sub>1</sub>";
    outLabel.style.fontSize = "0.6rem";
    outLabel.style.fontWeight = "600";
    outLabel.style.textAlign = "center";
    outLabel.style.color = dark ? "hsl(45,70%,72%)" : "hsl(45,50%,30%)";
    state[outLabel.id] = {
      x: cardsX + cardW / 2 - 16, y: cardsTopY + cardH + 4, opacity: 0.8
    };

    // Hide miscLabels[27] (Head1 below-card label) since outLabel takes its role
    state[miscLabels[27].id] = { x: cardsX + cardW / 2 - 16, y: cardsTopY + cardH + 4, opacity: 0 };

    // ── Token labels left of head cards ──
    var cardRowH = cardH / T;
    for (var i = 0; i < T; i++) {
      miscLabels[37 + i].textContent = TOKENS[i].text;
      miscLabels[37 + i].style.fontSize = "0.42rem";
      miscLabels[37 + i].style.fontWeight = "500";
      miscLabels[37 + i].style.textAlign = "right";
      miscLabels[37 + i].style.width = (labelW - 4) + "px";
