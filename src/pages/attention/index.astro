      miscLabels[dimIdx].style.fontSize = "0.5rem";
      miscLabels[dimIdx].style.textAlign = "center";
      miscLabels[dimIdx].style.color = "var(--attn-text-muted)";
      state[miscLabels[dimIdx].id] = {
