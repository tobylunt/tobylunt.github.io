			var detailedGap = 500;
			var cascadeGap = 60;
			var baseDelay = 1100;

			tokens.forEach(function(tok, i) {
				var delay;
				if (i < detailedCount) {
					delay = baseDelay + i * detailedGap;
				} else {
					delay = baseDelay + detailedCount * detailedGap + (i - detailedCount) * cascadeGap;
				}

				setTimeout(function() {
					// Highlight input column
					inputColEls[i].classList.add('hw-q8-highlight');

					if (i < detailedCount) {
						// Detailed: fly column copy to W_Q, then flash, then fill
						flyCol(inputColEls[i], 250);

						setTimeout(function() {
							wqWrap.classList.add('flash');
							setTimeout(function() { wqWrap.classList.remove('flash'); }, 200);
						}, 250);

						setTimeout(function() {
							outputColEls[i].classList.add('hw-q8-filled');
						}, 350);

						setTimeout(function() {
							if (i === catCol) {
								inputColEls[i].classList.remove('hw-q8-highlight');
								inputColEls[i].classList.add('hw-q8-persistent');
							} else {
								inputColEls[i].classList.remove('hw-q8-highlight');
							}
						}, 450);
					} else {
						// Cascade: quick highlight + flash + fill
						wqWrap.classList.add('flash');
						setTimeout(function() { wqWrap.classList.remove('flash'); }, 40);

						setTimeout(function() {
							outputColEls[i].classList.add('hw-q8-filled');
						}, 30);

						setTimeout(function() {
							inputColEls[i].classList.remove('hw-q8-highlight');
						}, 50);
					}
				}, delay);
			});

			// Phase 4: Equation appears after all animations complete
			var eqDelay = baseDelay + detailedCount * detailedGap + (tokens.length - detailedCount) * cascadeGap + 300;
			setTimeout(function() {
				eqRow.classList.add('visible');
			}, eqDelay);

			return layout;
		}

