							<div class="val-result" style="opacity: 0.88;">[0.11, 0.37, -0.05, ...]</div>
						</div>
						{/* Row 3: weight × V for "sat" */}
						<div class="val-step-row">
							<div class="val-weight" style="opacity: 0.72;">0.33</div>
							<div class="val-times">&times;</div>
							<div class="val-vector val-vector-v">v<sub>3</sub> "sat"</div>
							<div class="val-equals">=</div>
							<div class="val-result" style="opacity: 0.72;">[0.08, 0.13, 0.22, ...]</div>
						</div>

						{/* Sum line */}
						<div class="val-sum-divider"></div>
						<div class="val-step-row val-step-sum">
							<div class="val-sum-label">output<sub>2</sub></div>
