			matrices.forEach((m, mi) => {
				const mx = MATRIX_X;
				const my = ROW_Y[mi];
				addRect(nodeLayer, mx, my - MATRIX_H / 2, MATRIX_W, MATRIX_H, {
					fill: withAlpha(m.color, 0.08),
