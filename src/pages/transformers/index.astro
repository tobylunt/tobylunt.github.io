<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// ===== Feature #13: Head toggle interactive =====
		const headStates = { 1: true, 2: true, 3: true };

		// Output vectors per head (simulated)
		const headOutputs = {
			1: [0.12, 0.45, -0.22, 0.08],
			2: [-0.31, 0.67, 0.19, 0.44],
			3: [0.58, -0.14, 0.33, 0.11],
		};

		// Notes for each combination
		const stateNotes = {
			'111': 'All 3 heads active \u2014 full context from position, syntax, and identity.',
			'110': 'Heads 1+2: positional and syntactic context, but no self-identity preservation.',
			'101': 'Heads 1+3: positional context with identity, but missing syntactic relationships.',
			'011': 'Heads 2+3: syntactic and identity info, but no positional awareness.',
			'100': 'Only positional head \u2014 knows nearby tokens but misses grammar and self-identity.',
			'010': 'Only syntactic head \u2014 captures grammar but loses position and identity.',
			'001': 'Only identity head \u2014 preserves self but gains no context from other tokens.',
			'000': 'All heads disabled \u2014 no attention output. The residual connection still passes through the original input.',
		};

		function getStateKey() {
			return (headStates[1] ? '1' : '0') + (headStates[2] ? '1' : '0') + (headStates[3] ? '1' : '0');
		}

		function computeCombined() {
			const active = Object.entries(headStates).filter(([_, v]) => v).map(([k]) => parseInt(k));
			if (active.length === 0) return [0, 0, 0, 0];
			const result = [0, 0, 0, 0];
			active.forEach((h) => {
				headOutputs[h].forEach((v, i) => { result[i] += v; });
			});
			// Scale by W_O effect (normalize slightly)
			const scale = active.length / 3;
			return result.map((v) => (v * scale));
		}

		function formatVec(vec) {
			const formatted = vec.map((v) => v.toFixed(2)).join(', ');
			return '[' + formatted + ', \u2026]';
		}

		function updateUI() {
			const key = getStateKey();

			// Toggle button states
			[1, 2, 3].forEach((h) => {
				const btn = document.getElementById('mha-toggle-' + h);
				if (btn) {
					btn.classList.toggle('mha-toggle-active', headStates[h]);
				}
			});

			// Concat diagram: dim disabled heads
			[1, 2, 3].forEach((h) => {
				const headVec = document.querySelector('.mha-concat-h' + h);
				if (headVec) headVec.classList.toggle('mha-head-disabled', !headStates[h]);

				const seg = document.querySelector('.mha-seg-h' + h);
				if (seg) seg.classList.toggle('mha-seg-disabled', !headStates[h]);
			});

			// Update result
			const combined = computeCombined();
			const resultVec = document.getElementById('mha-toggle-result-vec');
			const resultNote = document.getElementById('mha-toggle-result-note');

			if (resultVec) {
				resultVec.textContent = formatVec(combined);
				resultVec.style.color = key === '000' ? 'hsl(var(--theme-text) / 0.3)' : '';
			}
			if (resultNote) {
				resultNote.textContent = stateNotes[key] || '';
			}

			// Update output in concat diagram
			const outputVals = document.querySelector('.mha-concat-output-vals');
			if (outputVals) {
				outputVals.textContent = key === '000' ? '[0.00, 0.00, 0.00, 0.00, \u2026]' : formatVec(combined);
			}
		}

		// Attach click handlers
		[1, 2, 3].forEach((h) => {
			const btn = document.getElementById('mha-toggle-' + h);
			if (btn) {
				btn.addEventListener('click', (e) => {
					e.stopPropagation();
					headStates[h] = !headStates[h];
					updateUI();
				});
			}
		});
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// ===== Feature #14: Activation function canvas =====
		const canvas = document.getElementById('ffn-activation-canvas');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		const W = canvas.width;
		const H = canvas.height;

		const descriptions = {
			relu: '<strong>ReLU</strong>: max(0, x). The original transformer used this. Simple and fast, but “dead neurons” (always zero for negative inputs) can waste capacity.',
			gelu: '<strong>GELU</strong>: x · Φ(x). Used in BERT and GPT-2+. Smoothly gates values rather than hard-clipping, letting small negative signals through. Now the most common choice.',
			silu: '<strong>SiLU / Swish</strong>: x · σ(x). Used in LLaMA and PaLM. Similar to GELU but computed differently. Its slight dip below zero for negative inputs can help optimization.',
		};

		function relu(x) { return Math.max(0, x); }
		function gelu(x) {
			// Approximation: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
			const c = Math.sqrt(2 / Math.PI);
			return 0.5 * x * (1 + Math.tanh(c * (x + 0.044715 * x * x * x)));
		}
		function silu(x) { return x / (1 + Math.exp(-x)); }

		const fns = { relu, gelu, silu };
		let activeFn = 'relu';

		function getColors() {
			const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
			return {
				bg: isDark ? '#1a1a2e' : '#fafafa',
				grid: isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)',
				axis: isDark ? 'rgba(255,255,255,0.2)' : 'rgba(0,0,0,0.2)',
				text: isDark ? 'rgba(255,255,255,0.35)' : 'rgba(0,0,0,0.35)',
				curve: 'hsl(150, 55%, 45%)',
				curveShadow: isDark ? 'rgba(72,187,120,0.3)' : 'rgba(72,187,120,0.15)',
				identity: isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)',
			};
		}

		function drawActivation(fnName) {
			const fn = fns[fnName];
			const colors = getColors();

			// Clear
			ctx.fillStyle = colors.bg;
			ctx.fillRect(0, 0, W, H);

			// Coordinate system: x from -4 to 4, y from -2 to 4
			const xMin = -4, xMax = 4, yMin = -2, yMax = 4;
			const pad = { left: 40, right: 20, top: 20, bottom: 30 };
			const plotW = W - pad.left - pad.right;
			const plotH = H - pad.top - pad.bottom;

			function toPixel(x, y) {
				return [
					pad.left + ((x - xMin) / (xMax - xMin)) * plotW,
					pad.top + ((yMax - y) / (yMax - yMin)) * plotH,
				];
			}

			// Grid lines
			ctx.strokeStyle = colors.grid;
			ctx.lineWidth = 1;
			for (let x = -3; x <= 3; x++) {
				const [px] = toPixel(x, 0);
				ctx.beginPath();
				ctx.moveTo(px, pad.top);
				ctx.lineTo(px, H - pad.bottom);
				ctx.stroke();
			}
			for (let y = -1; y <= 3; y++) {
				const [, py] = toPixel(0, y);
				ctx.beginPath();
				ctx.moveTo(pad.left, py);
				ctx.lineTo(W - pad.right, py);
				ctx.stroke();
			}

			// Axes
			ctx.strokeStyle = colors.axis;
			ctx.lineWidth = 1.5;
			// x-axis
			const [, y0] = toPixel(0, 0);
			ctx.beginPath();
			ctx.moveTo(pad.left, y0);
			ctx.lineTo(W - pad.right, y0);
			ctx.stroke();
			// y-axis
			const [x0] = toPixel(0, 0);
			ctx.beginPath();
			ctx.moveTo(x0, pad.top);
			ctx.lineTo(x0, H - pad.bottom);
			ctx.stroke();

			// Axis labels
			ctx.fillStyle = colors.text;
			ctx.font = '11px system-ui, sans-serif';
			ctx.textAlign = 'center';
			for (let x = -3; x <= 3; x++) {
				if (x === 0) continue;
				const [px] = toPixel(x, 0);
				ctx.fillText(x.toString(), px, y0 + 16);
			}
			ctx.textAlign = 'right';
			for (let y = -1; y <= 3; y++) {
				if (y === 0) continue;
				const [, py] = toPixel(0, y);
				ctx.fillText(y.toString(), x0 - 8, py + 4);
			}

			// Identity line (y = x) as faint reference
			ctx.strokeStyle = colors.identity;
			ctx.lineWidth = 1;
			ctx.setLineDash([4, 4]);
			ctx.beginPath();
			const [ix1, iy1] = toPixel(xMin, xMin);
			const [ix2, iy2] = toPixel(xMax, xMax);
			ctx.moveTo(ix1, iy1);
			ctx.lineTo(ix2, iy2);
			ctx.stroke();
			ctx.setLineDash([]);

			// Draw activation curve
			ctx.strokeStyle = colors.curve;
			ctx.lineWidth = 2.5;
			ctx.shadowColor = colors.curveShadow;
			ctx.shadowBlur = 6;
			ctx.beginPath();
			const steps = 200;
			for (let i = 0; i <= steps; i++) {
				const x = xMin + (i / steps) * (xMax - xMin);
				const y = fn(x);
				const [px, py] = toPixel(x, y);
				if (i === 0) ctx.moveTo(px, py);
				else ctx.lineTo(px, py);
			}
			ctx.stroke();
			ctx.shadowBlur = 0;
		}

		// Button click handlers
		const buttons = document.querySelectorAll('.ffn-act-btn');
		const descEl = document.getElementById('ffn-activation-desc');

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const fnName = btn.getAttribute('data-fn');
				activeFn = fnName;

				// Update active button
				buttons.forEach((b) => b.classList.remove('ffn-act-active'));
				btn.classList.add('ffn-act-active');

				// Update description
				if (descEl) descEl.innerHTML = descriptions[fnName];

				// Redraw
				drawActivation(fnName);
			});
		});

		// Initial draw
		drawActivation('relu');

		// Redraw on theme change
		const observer = new MutationObserver(() => {
			drawActivation(activeFn);
		});
		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// ===== Feature #15: Residual stream animations =====

		// --- Layer accumulation animation ---
		const rows = document.querySelectorAll('.res-layer-row');
		const animateBtn = document.getElementById('res-animate-btn');
		const resetBtn = document.getElementById('res-reset-btn');
		let animationTimer = null;

		function resetAnimation() {
			if (animationTimer) { clearTimeout(animationTimer); animationTimer = null; }
			rows.forEach(r => r.classList.remove('res-row-visible'));
		}

		function animateLayers() {
			resetAnimation();
			rows.forEach((row, i) => {
				animationTimer = setTimeout(() => {
					row.classList.add('res-row-visible');
				}, i * 500);
			});
		}

		if (animateBtn) animateBtn.addEventListener('click', animateLayers);
		if (resetBtn) resetBtn.addEventListener('click', resetAnimation);

		// Auto-show all rows after a short delay on load
		setTimeout(() => {
			rows.forEach((row, i) => {
				setTimeout(() => row.classList.add('res-row-visible'), i * 300);
			});
		}, 500);

		// --- Layer norm interactive ---
		const beforeBarsEl = document.getElementById('ln-before-bars');
		const afterBarsEl = document.getElementById('ln-after-bars');
		const beforeStatsEl = document.getElementById('ln-before-stats');
		const afterStatsEl = document.getElementById('ln-after-stats');
		const randomizeBtn = document.getElementById('ln-randomize-btn');

		if (!beforeBarsEl || !afterBarsEl) return;

		const numDims = 8;
		const barHeight = 120; // max bar height in px

		function randomValues() {
			// Random values with varying scales to demonstrate norm's effect
			const scale = 2 + Math.random() * 8;
			const offset = (Math.random() - 0.5) * 6;
			return Array.from({ length: numDims }, () => (Math.random() - 0.5) * scale + offset);
		}

		function layerNorm(values) {
			const mean = values.reduce((a, b) => a + b, 0) / values.length;
			const variance = values.reduce((a, b) => a + (b - mean) ** 2, 0) / values.length;
			const std = Math.sqrt(variance + 1e-5);
			return values.map(v => (v - mean) / std);
		}

		function mean(arr) { return arr.reduce((a, b) => a + b, 0) / arr.length; }
		function std(arr) {
			const m = mean(arr);
			return Math.sqrt(arr.reduce((a, b) => a + (b - m) ** 2, 0) / arr.length);
		}

		function renderBars(container, values, maxAbsVal) {
			container.innerHTML = '';
			const absMax = maxAbsVal || Math.max(...values.map(Math.abs), 0.01);
			values.forEach((v, i) => {
				const bar = document.createElement('div');
				bar.className = 'ln-bar';
				const h = Math.abs(v) / absMax * barHeight;
				const isNeg = v < 0;
				if (isNeg) {
					bar.style.height = h + 'px';
					bar.style.background = 'hsl(350 65% 55% / 0.4)';
					bar.style.alignSelf = 'flex-start';
					bar.style.borderRadius = '0 0 4px 4px';
					bar.style.marginTop = (barHeight - h) + 'px';
				} else {
					bar.style.height = h + 'px';
					bar.style.background = 'hsl(270 50% 58% / 0.4)';
					bar.style.marginTop = (barHeight - h) + 'px';
				}
				const label = document.createElement('div');
				label.className = 'ln-bar-label';
				label.textContent = v.toFixed(1);
				bar.appendChild(label);
				container.appendChild(bar);
			});
		}

		function renderStats(container, values) {
			const m = mean(values);
			const s = std(values);
			container.innerHTML = '\u03bc = ' + m.toFixed(2) + ' &nbsp; \u03c3 = ' + s.toFixed(2);
		}

		function update() {
			const before = randomValues();
			const after = layerNorm(before);
			const maxBefore = Math.max(...before.map(Math.abs), 0.01);
			const maxAfter = Math.max(...after.map(Math.abs), 0.01);
			renderBars(beforeBarsEl, before, maxBefore);
			renderBars(afterBarsEl, after, maxAfter);
			renderStats(beforeStatsEl, before);
			renderStats(afterStatsEl, after);
		}

		if (randomizeBtn) randomizeBtn.addEventListener('click', update);
		update(); // Initial render
	});
</script>

<script is:inline>
	// === Section 08: Output — Temperature & Top-k Predictions ===
	document.addEventListener('DOMContentLoaded', () => {
		const slider = document.getElementById('out-temp-slider');
		const tempDisplay = document.getElementById('out-temp-display');
		const barsContainer = document.getElementById('out-topk-bars');
		const restEl = document.getElementById('out-topk-rest');
		if (!slider || !barsContainer) return;

		// Simulated logits for "The cat sat on the ___"
		// These represent the raw model output before softmax
		const candidates = [
			{ token: 'mat', logit: 5.8 },
			{ token: 'floor', logit: 3.9 },
			{ token: 'bed', logit: 3.2 },
			{ token: 'couch', logit: 2.7 },
			{ token: 'table', logit: 2.3 },
			{ token: 'roof', logit: 1.8 },
			{ token: 'grass', logit: 1.4 },
			{ token: 'chair', logit: 1.1 },
		];

		function softmax(logits, temperature) {
			const t = Math.max(temperature, 0.01);
			const scaled = logits.map(l => l / t);
			const maxVal = Math.max(...scaled);
			const exps = scaled.map(s => Math.exp(s - maxVal));
			const sum = exps.reduce((a, b) => a + b, 0);
			return exps.map(e => e / sum);
		}

		function render(temperature) {
			const logits = candidates.map(c => c.logit);
			const probs = softmax(logits, temperature);
			const topK = 8;
			const maxProb = Math.max(...probs.slice(0, topK));

			barsContainer.innerHTML = '';
			let shownSum = 0;
			for (let i = 0; i < topK; i++) {
				const prob = probs[i];
				shownSum += prob;
				const pct = (prob / maxProb) * 100;

				const row = document.createElement('div');
				row.style.cssText = 'display:flex;align-items:center;gap:8px;';

				const tokenEl = document.createElement('div');
				tokenEl.style.cssText = 'font-size:0.8rem;font-weight:600;width:60px;text-align:right;color:hsl(var(--theme-text)/0.7);';
				tokenEl.textContent = candidates[i].token;

				const trackEl = document.createElement('div');
				trackEl.style.cssText = 'flex:1;height:28px;background:hsl(var(--theme-text)/0.04);border-radius:6px;overflow:hidden;position:relative;';

				const fillEl = document.createElement('div');
				fillEl.style.cssText = 'height:100%;border-radius:6px;background:hsl(350 65% 55%);transition:width 0.4s ease;min-width:2px;width:' + pct + '%;opacity:' + (0.4 + (prob / maxProb) * 0.6) + ';';

				trackEl.appendChild(fillEl);

				const probEl = document.createElement('div');
				probEl.style.cssText = "font-family:'SF Mono','Fira Code',monospace;font-size:0.72rem;width:52px;color:hsl(var(--theme-text)/0.5);";
				probEl.textContent = (prob * 100).toFixed(1) + '%';

				row.appendChild(tokenEl);
				row.appendChild(trackEl);
				row.appendChild(probEl);
				barsContainer.appendChild(row);
			}

			const remaining = (1 - shownSum) * 100;
			if (remaining > 0.1) {
				restEl.textContent = '+ ' + remaining.toFixed(1) + '% spread across ~50,000 other tokens';
			} else {
				restEl.textContent = '';
			}
		}

		slider.addEventListener('input', () => {
			const temp = parseFloat(slider.value);
			tempDisplay.textContent = 'Temperature: ' + temp.toFixed(1);
			render(temp);
		});

		render(1.0);
	});
</script>

<script is:inline>
	// === Section 08b: Putting It All Together — Walkthrough ===
	document.addEventListener('DOMContentLoaded', () => {
		const stages = document.querySelectorAll('[data-wt]');
		const prevBtn = document.getElementById('wt-prev-btn');
		const nextBtn = document.getElementById('wt-next-btn');
		const playBtn = document.getElementById('wt-play-btn');
		const resetBtn = document.getElementById('wt-reset-btn');
		const playLabel = document.getElementById('wt-play-label');
		const playIcon = document.getElementById('wt-play-icon');
		const stepCounter = document.getElementById('wt-step-counter');
		const annTitle = document.getElementById('wt-ann-title');
		const annText = document.getElementById('wt-ann-text');
		const annToken = document.getElementById('wt-ann-token');

		if (!stages.length || !prevBtn) return;

		const TOTAL = stages.length; // 0..11
		let current = -1; // -1 = start state
		let playing = false;
		let timer = null;

		const stepData = [
			{
				title: 'Input tokens',
				text: 'Raw text is split into tokens — the atomic units the model operates on. Our sentence <strong>"The cat sat on the"</strong> becomes 5 tokens. We\'ll follow <strong>"cat"</strong> through the pipeline.',
				token: '"The"  "cat"  "sat"  "on"  "the"  →  focus: "cat"'
			},
			{
				title: 'Token Embedding',
				text: 'Each token is looked up in a learned embedding table, converting it from a discrete ID into a <strong>dense vector</strong> (typically 768 or 1024 dimensions). "Cat" becomes a point in high-dimensional space, near other animals.',
				token: '"cat" → W_E[4821] → [0.23, −0.41, 0.87, 0.05, …]₇₆₈'
			},
			{
				title: '+ Positional Encoding',
				text: 'Sine and cosine waves at different frequencies encode <strong>position</strong>. "Cat" is at position 1, so it gets that position\'s unique fingerprint added to its embedding. Now the vector carries both meaning and position.',
				token: '[0.23, −0.41, …] + PE(pos=1) → [0.31, −0.28, 0.92, …]₇₆₈'
			},
			{
				title: 'Layer Norm',
				text: 'Before attention, <strong>layer normalization</strong> rescales the vector to zero mean and unit variance. This stabilizes training and ensures each sublayer receives well-conditioned inputs.',
				token: 'LayerNorm(x) → μ=0.00, σ=1.00'
			},
			{
				title: 'Multi-Head Attention',
				text: 'The vector is projected into <strong style="color:hsl(210 70% 55%)">Q</strong>, <strong style="color:hsl(25 85% 55%)">K</strong>, and <strong style="color:hsl(150 55% 45%)">V</strong> across multiple heads. Each head computes attention scores (QK<sup>T</sup>/√d<sub>k</sub>), applies softmax, and produces a weighted sum of values. "Cat" attends strongly to "sat" (subject→verb) and to itself.',
				token: 'Q·K^T → softmax → ×V\nHead 1 (positional): cat→The 0.42, cat→cat 0.33\nHead 2 (syntactic): cat→sat 0.62'
			},
			{
				title: '+ Residual Connection',
				text: 'The attention output is <strong>added back</strong> to the original input via the residual stream — the information highway. The original signal is never destroyed; it just accumulates new context. Gradients flow through the shortcut, keeping training stable.',
				token: 'x + MHA(x) → enriched vector (meaning + position + context)'
			},
			{
				title: 'Layer Norm',
				text: 'A second layer normalization before the feed-forward network. Same principle: stabilize the scale before the next computation.',
				token: 'LayerNorm(x + MHA(x)) → μ=0.00, σ=1.00'
			},
			{
				title: 'Feed-Forward Network',
				text: 'The vector <strong>expands</strong> to 4× its size (768→3072), passes through a nonlinear activation (GELU), then <strong>compresses</strong> back. This is where factual knowledge lives — each neuron acts as a pattern detector. "Cat" activates animal-related features.',
				token: 'x → W₁(768→3072) → GELU → W₂(3072→768) → FFN(x)'
			},
			{
				title: '+ Residual Connection',
				text: 'The FFN output is added back to the stream. One full transformer layer is now complete: attention for cross-token communication, FFN for per-token processing, both connected by residual additions. <strong>This cycle repeats N times</strong> (12–96 layers).',
				token: 'x\' = x + MHA(x) + FFN(x + MHA(x))\n→ flows into the next layer…'
			},
			{
				title: 'Final Layer Norm',
				text: 'After all N layers, one final normalization prepares the vector for the output projection. The vector now carries a rich, abstract representation — meaning, position, context from every token, processed through dozens of attention and FFN cycles.',
				token: 'LayerNorm(final residual) → stable vector for unembedding'
			},
			{
				title: 'Unembedding',
				text: 'The <strong>reverse of embedding</strong>: multiply by W<sub>U</sub> (often ≈ W<sub>E</sub><sup>T</sup>) to project the d<sub>model</sub> vector back to vocabulary size. Each entry is a <strong>logit</strong> — a raw score for how likely that token is to come next.',
				token: '[…]₇₆₈ × W_U → [3.2, −1.1, 0.4, 5.8, …]₅₀ₖ (logits)'
			},
			{
				title: 'Softmax → Prediction',
				text: 'Softmax converts logits into a <strong>probability distribution</strong> over the full vocabulary. At temperature 1.0, "mat" gets 74.7% — the model\'s best guess for "The cat sat on the ___". Sample from this distribution, append the token, and repeat. <strong>That\'s autoregressive generation.</strong>',
				token: 'softmax([…, 5.8, …]) →  mat: 74.7%  floor: 11.2%  bed: 5.5%\n→ sample: "mat"  →  "The cat sat on the mat"'
			}
		];

		function updateUI() {
			// Update stage highlights
			stages.forEach((s, i) => {
				s.classList.remove('active', 'visited');
				if (i === current) s.classList.add('active');
				else if (i < current) s.classList.add('visited');
			});

			// Update buttons
			prevBtn.disabled = current <= 0;
			nextBtn.disabled = current >= TOTAL - 1;

			// Update counter
			if (current < 0) {
				stepCounter.textContent = 'Start';
			} else {
				stepCounter.textContent = 'Step ' + (current + 1) + ' / ' + TOTAL;
			}

			// Update annotation
			if (current >= 0 && current < stepData.length) {
				const d = stepData[current];
				annTitle.innerHTML = d.title;
				annText.innerHTML = d.text;
				annToken.textContent = d.token;
			} else if (current < 0) {
				annTitle.textContent = 'The black box, opened';
				annText.innerHTML = 'In section 01, the transformer was a mystery: tokens in, prediction out. Now you know every step. Press <strong>Play</strong> or <strong>Step</strong> to watch "cat" flow through the pipeline.';
				annToken.textContent = '';
			}

			// Auto-stop play at end
			if (current >= TOTAL - 1 && playing) {
				stopPlay();
			}
		}

		function goTo(step) {
			current = Math.max(-1, Math.min(TOTAL - 1, step));
			updateUI();
		}

		function stopPlay() {
			playing = false;
			clearInterval(timer);
			timer = null;
			playLabel.textContent = 'Play';
			playIcon.innerHTML = '<polygon points="2,1 10,6 2,11" fill="currentColor"/>';
			playBtn.classList.remove('playing');
		}

		function startPlay() {
			if (current >= TOTAL - 1) goTo(-1); // reset if at end
			playing = true;
			playLabel.textContent = 'Pause';
			playIcon.innerHTML = '<rect x="2" y="1" width="3" height="10" fill="currentColor"/><rect x="7" y="1" width="3" height="10" fill="currentColor"/>';
			playBtn.classList.add('playing');
			// Advance immediately once, then on interval
			goTo(current + 1);
			timer = setInterval(() => {
				if (current >= TOTAL - 1) { stopPlay(); return; }
				goTo(current + 1);
			}, 2200);
		}

		nextBtn.addEventListener('click', () => { stopPlay(); goTo(current + 1); });
		prevBtn.addEventListener('click', () => { stopPlay(); goTo(current - 1); });
		resetBtn.addEventListener('click', () => { stopPlay(); goTo(-1); });
		playBtn.addEventListener('click', () => { playing ? stopPlay() : startPlay(); });

		// Clicking a stage jumps to it
		stages.forEach(s => {
			s.addEventListener('click', () => {
				stopPlay();
				goTo(parseInt(s.getAttribute('data-wt')));
			});
		});

		updateUI();
	});
</script>
