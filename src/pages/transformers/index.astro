	.toc-dot-link:hover {
		color: hsl(var(--theme-text) / 0.55);
	}

	/* Read state: sections above current */
	.toc-dot-link.read {
		color: hsl(var(--theme-text) / 0.35);
	}

	/* Active state: current section */
	.toc-dot-link.active {
		color: hsl(var(--theme-text) / 0.85);
	}

	.toc-dot {
		flex-shrink: 0;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: hsl(var(--theme-bg) / 1);
		border: 1.5px solid hsl(var(--theme-text) / 0.18);
