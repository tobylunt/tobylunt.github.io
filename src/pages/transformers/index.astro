		// --- Positional encoding interactive ---
		const posSlider = document.getElementById('posenc-slider');
		const posValue = document.getElementById('posenc-pos-value');
		const posWavePos = document.getElementById('posenc-wave-pos');
		const posWavesSvg = document.getElementById('posenc-waves');
		const posHeatmap = document.getElementById('posenc-heatmap');

		if (posSlider && posWavesSvg) {
			const svgNS = 'http://www.w3.org/2000/svg';
			const dModel = 32; // dimensions to show
			const maxPos = 32;

			function posEnc(pos, i, d) {
				const angle = pos / Math.pow(10000, (2 * Math.floor(i / 2)) / d);
				return i % 2 === 0 ? Math.sin(angle) : Math.cos(angle);
			}

			function renderWaves(pos) {
				// Clear previous bars
				posWavesSvg.querySelectorAll('.posenc-bar').forEach(el => el.remove());

				const barWidth = 540 / dModel;
				const startX = 30;
				const centerY = 80;
				const maxH = 65;

				for (let i = 0; i < dModel; i++) {
					const val = posEnc(pos, i, dModel);
					const barH = val * maxH;
					const x = startX + i * barWidth + 1;
					const w = barWidth - 2;

					const rect = document.createElementNS(svgNS, 'rect');
					rect.setAttribute('class', 'posenc-bar');
					rect.setAttribute('x', x);
					rect.setAttribute('width', Math.max(w, 2));
					rect.setAttribute('rx', '2');

					if (val >= 0) {
						rect.setAttribute('y', centerY - barH);
						rect.setAttribute('height', barH);
						rect.setAttribute('fill', 'hsl(210 70% 55%)');
						rect.setAttribute('fill-opacity', 0.3 + Math.abs(val) * 0.5);
					} else {
						rect.setAttribute('y', centerY);
						rect.setAttribute('height', -barH);
						rect.setAttribute('fill', 'hsl(35 90% 55%)');
						rect.setAttribute('fill-opacity', 0.3 + Math.abs(val) * 0.5);
					}

					posWavesSvg.appendChild(rect);
				}
			}

			posSlider.addEventListener('input', () => {
				const pos = parseInt(posSlider.value);
				posValue.textContent = pos;
				posWavePos.textContent = pos;
				renderWaves(pos);
			});

			// Initial render
			renderWaves(0);
		}

		// --- Heatmap ---
		if (posHeatmap) {
			const ctx = posHeatmap.getContext('2d');
			const dModel = 32;
			const maxPos = 32;
			const cellW = posHeatmap.width / dModel;
			const cellH = posHeatmap.height / maxPos;

			function posEnc(pos, i, d) {
				const angle = pos / Math.pow(10000, (2 * Math.floor(i / 2)) / d);
				return i % 2 === 0 ? Math.sin(angle) : Math.cos(angle);
			}

			for (let p = 0; p < maxPos; p++) {
				for (let i = 0; i < dModel; i++) {
					const val = posEnc(p, i, dModel);
					// Map [-1, 1] to color: blue (-1) → transparent (0) → amber (+1)
					let r, g, b;
					if (val >= 0) {
						// Amber: hsl(35, 90%, 55%) ≈ rgb(240, 165, 35)
						r = Math.round(240 * val + (1 - val) * 128);
						g = Math.round(165 * val + (1 - val) * 128);
						b = Math.round(35 * val + (1 - val) * 128);
					} else {
						// Blue: hsl(210, 70%, 55%) ≈ rgb(55, 130, 210)
						const v = -val;
						r = Math.round(55 * v + (1 - v) * 128);
						g = Math.round(130 * v + (1 - v) * 128);
						b = Math.round(210 * v + (1 - v) * 128);
					}
					ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
					ctx.fillRect(i * cellW, p * cellH, cellW, cellH);
				}
			}
		}

		// --- Architecture diagram: tooltips + animation ---
		const archDiagram = document.getElementById('arch-diagram');
		const archTooltip = document.getElementById('arch-tooltip');
		const animateBtn = document.getElementById('arch-animate-btn');

		if (archDiagram && archTooltip) {
			// Tooltip on hover/click
			const allBlocks = archDiagram.querySelectorAll('[data-tip]');

			function showTooltip(el) {
				const tip = el.getAttribute('data-tip');
				if (!tip) return;
				archTooltip.textContent = tip;
				archTooltip.classList.add('visible');
				// Position relative to diagram wrap
				const wrap = archDiagram.parentElement;
				const wrapRect = wrap.getBoundingClientRect();
				const elRect = el.getBoundingClientRect();
				const tooltipLeft = elRect.left + elRect.width / 2 - wrapRect.left;
				const tooltipTop = elRect.top - wrapRect.top - 8;
				archTooltip.style.left = tooltipLeft + 'px';
				archTooltip.style.top = tooltipTop + 'px';
				archTooltip.style.bottom = 'auto';
				archTooltip.style.transform = 'translateX(-50%)';
			}

			function hideTooltip() {
				archTooltip.classList.remove('visible');
			}

			allBlocks.forEach(block => {
				block.addEventListener('mouseenter', () => showTooltip(block));
				block.addEventListener('mouseleave', hideTooltip);
				block.addEventListener('click', () => showTooltip(block));
			});

			// Close tooltip on click outside
			document.addEventListener('click', (e) => {
				if (!e.target.closest('[data-tip]')) hideTooltip();
			});
		}

		// Animate data flow
		if (animateBtn && archDiagram) {
			animateBtn.addEventListener('click', () => {
				if (animateBtn.classList.contains('running')) return;
				animateBtn.classList.add('running');

				// Collect blocks in bottom-to-top visual order (column-reverse means DOM order is top-to-bottom visual, so reverse)
				const blocks = Array.from(archDiagram.querySelectorAll('.arch-block'));
				const orderedBlocks = blocks.reverse(); // now bottom-to-top

				let i = 0;
				function pulseNext() {
					if (i >= orderedBlocks.length) {
						animateBtn.classList.remove('running');
						return;
					}
					const block = orderedBlocks[i];
					block.classList.remove('arch-flow-active');
					void block.offsetWidth; // force reflow
					block.classList.add('arch-flow-active');
					block.addEventListener('animationend', () => {
						block.classList.remove('arch-flow-active');
					}, { once: true });
					i++;
					setTimeout(pulseNext, 300);
				}
				pulseNext();
			});
		}
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// --- QKV projection animation ---
		const svg = document.getElementById('qkv-svg');
		if (!svg) return;

		const stepBtn = document.getElementById('qkv-step-btn');
		const playBtn = document.getElementById('qkv-play-btn');
		const resetBtn = document.getElementById('qkv-reset-btn');
		const stepLabel = document.getElementById('qkv-step-label');

		// Colors — use space-separated HSL for alpha support
		const COL_INPUT = 'hsl(35 90% 55%)';   // amber — input vectors
		const COL_Q = 'hsl(210 70% 55%)';       // blue — queries
		const COL_K = 'hsl(25 85% 55%)';        // orange — keys
		const COL_V = 'hsl(150 55% 45%)';       // green — values

		// Theme-aware colors: read computed style
		const cs = getComputedStyle(document.documentElement);
		const themeText = cs.getPropertyValue('--theme-text').trim();
		const themeBg = cs.getPropertyValue('--theme-bg').trim();
		const COL_MATRIX = `hsl(${themeText} / 0.65)`;
		const COL_DIM = `hsl(${themeText} / 0.35)`;
		const COL_BG = `hsl(${themeBg})`;

		// Helper: add alpha to an HSL color
		function withAlpha(hsl, alpha) {
			// hsl(210 70% 55%) → hsl(210 70% 55% / 0.15)
			return hsl.replace(')', ` / ${alpha})`);
		}

		// Layout
		const tokens = ['The', 'cat', 'sat'];
		const TOTAL_STEPS = 9; // 3 tokens × 3 projections (Q, K, V)
		let currentStep = 0;
		let playInterval = null;

		// Positions
		const INPUT_X = 60;
		const MATRIX_X = 250;
		const OUTPUT_X = 530;
		const ROW_Y = [100, 210, 320]; // y positions for 3 tokens
		const MATRIX_W = 120;
		const MATRIX_H = 55;
		const VEC_W = 80;
		const VEC_H = 30;

		function ns(tag) {
			return document.createElementNS('http://www.w3.org/2000/svg', tag);
		}

		function addText(parent, x, y, text, opts = {}) {
			const el = ns('text');
			el.setAttribute('x', x);
			el.setAttribute('y', y);
			el.textContent = text;
			el.setAttribute('font-size', opts.size || '13');
			el.setAttribute('fill', opts.fill || COL_DIM);
			el.setAttribute('text-anchor', opts.anchor || 'middle');
			el.setAttribute('font-family', opts.family || 'system-ui, sans-serif');
			if (opts.weight) el.setAttribute('font-weight', opts.weight);
			if (opts.cls) el.setAttribute('class', opts.cls);
			parent.appendChild(el);
			return el;
		}

		function addRect(parent, x, y, w, h, opts = {}) {
			const el = ns('rect');
			el.setAttribute('x', x);
			el.setAttribute('y', y);
			el.setAttribute('width', w);
			el.setAttribute('height', h);
			el.setAttribute('rx', opts.rx || 5);
			el.setAttribute('fill', opts.fill || 'none');
			el.setAttribute('stroke', opts.stroke || COL_DIM);
			el.setAttribute('stroke-width', opts.sw || 1.5);
			if (opts.opacity) el.setAttribute('opacity', opts.opacity);
			if (opts.dash) el.setAttribute('stroke-dasharray', opts.dash);
			if (opts.cls) el.setAttribute('class', opts.cls);
			parent.appendChild(el);
			return el;
		}

		function addArrow(parent, x1, y1, x2, y2, color, opts = {}) {
			const el = ns('line');
			el.setAttribute('x1', x1);
			el.setAttribute('y1', y1);
			el.setAttribute('x2', x2);
			el.setAttribute('y2', y2);
			el.setAttribute('stroke', color);
			el.setAttribute('stroke-width', opts.sw || 1.5);
			if (opts.dash) el.setAttribute('stroke-dasharray', opts.dash);
			if (opts.cls) el.setAttribute('class', opts.cls);
			if (opts.opacity) el.setAttribute('opacity', opts.opacity);
			parent.appendChild(el);

			// arrowhead
			if (!opts.noHead) {
				const head = ns('polygon');
				const dx = x2 - x1;
				const dy = y2 - y1;
				const len = Math.sqrt(dx * dx + dy * dy);
				const ux = dx / len;
				const uy = dy / len;
				const sz = 5;
				const px = x2 - ux * 2;
				const py = y2 - uy * 2;
				head.setAttribute('points',
					`${x2},${y2} ${px - uy * sz},${py + ux * sz} ${px + uy * sz},${py - ux * sz}`
				);
				head.setAttribute('fill', color);
				if (opts.cls) head.setAttribute('class', opts.cls);
				if (opts.opacity) head.setAttribute('opacity', opts.opacity);
				parent.appendChild(head);
			}
			return el;
		}

		function drawBase() {
			svg.innerHTML = '';

			// Column labels
			addText(svg, INPUT_X + VEC_W / 2, 35, 'Input Vectors', { size: '12', fill: COL_INPUT, weight: '600' });
			addText(svg, INPUT_X + VEC_W / 2, 50, '(embedding + position)', { size: '10', fill: COL_DIM });
			addText(svg, MATRIX_X + MATRIX_W / 2, 35, 'Weight Matrices', { size: '12', fill: COL_DIM, weight: '600' });
			addText(svg, OUTPUT_X + VEC_W / 2, 35, 'Projections', { size: '12', fill: COL_DIM, weight: '600' });

			// Draw input vectors (always visible)
			tokens.forEach((tok, i) => {
				const y = ROW_Y[i];
				addRect(svg, INPUT_X, y - VEC_H / 2, VEC_W, VEC_H, {
					fill: withAlpha(COL_INPUT, 0.15),
					stroke: COL_INPUT,
					sw: 1.5
				});
				addText(svg, INPUT_X + VEC_W / 2, y + 1, `x${String.fromCharCode(8321 + i)}`, {
					size: '14', fill: COL_INPUT, weight: '600', family: 'Georgia, serif'
				});
				// Token label below
				addText(svg, INPUT_X + VEC_W / 2, y + VEC_H / 2 + 16, `"${tok}"`, {
					size: '11', fill: COL_DIM
				});
			});

			// Draw weight matrix placeholders (3 matrices stacked per row, but we show them as columns for clarity)
			const matrices = [
				{ label: 'W_Q', sub: 'Q', color: COL_Q },
				{ label: 'W_K', sub: 'K', color: COL_K },
				{ label: 'W_V', sub: 'V', color: COL_V },
			];

			matrices.forEach((m, mi) => {
				const mx = MATRIX_X;
				const my = ROW_Y[mi];
				addRect(svg, mx, my - MATRIX_H / 2, MATRIX_W, MATRIX_H, {
					fill: withAlpha(m.color, 0.08),
					stroke: m.color,
					sw: 1.5,
					dash: '4 3'
				});
				// W subscript label
				const wText = ns('text');
				wText.setAttribute('x', mx + MATRIX_W / 2);
				wText.setAttribute('y', my + 2);
				wText.setAttribute('text-anchor', 'middle');
				wText.setAttribute('font-size', '15');
				wText.setAttribute('fill', m.color);
				wText.setAttribute('font-weight', '600');
				wText.setAttribute('font-family', 'Georgia, serif');
				wText.innerHTML = `W<tspan baseline-shift="sub" font-size="11">${m.sub}</tspan>`;
				svg.appendChild(wText);
			});

			// Draw output placeholders (3 outputs per token = 9 boxes arranged in grid)
			const projections = [
				{ label: 'Q', color: COL_Q },
				{ label: 'K', color: COL_K },
				{ label: 'V', color: COL_V },
			];

			tokens.forEach((tok, ti) => {
				projections.forEach((p, pi) => {
					const ox = OUTPUT_X + pi * (VEC_W + 12);
					const oy = ROW_Y[ti];
					addRect(svg, ox, oy - VEC_H / 2, VEC_W, VEC_H, {
						fill: 'transparent',
						stroke: COL_DIM,
						sw: 1,
						dash: '3 3',
						opacity: '0.3',
						cls: `qkv-output-box qkv-out-${ti}-${pi}`
					});
				});
			});

			// Output column sub-labels
			projections.forEach((p, pi) => {
				const ox = OUTPUT_X + pi * (VEC_W + 12);
				addText(svg, ox + VEC_W / 2, 50, p.label, {
					size: '13', fill: p.color, weight: '700', family: 'Georgia, serif'
				});
			});
		}

		function showStep(step) {
			// step 0 = base state
			// steps 1-9: token (0-2) × projection (Q=0, K=1, V=2)
			// step 1: token0→Q, step 2: token0→K, step 3: token0→V
			// step 4: token1→Q, step 5: token1→K, step 6: token1→V
			// etc.

			drawBase();

			const projColors = [COL_Q, COL_K, COL_V];
			const projLabels = ['q', 'k', 'v'];

			for (let s = 1; s <= Math.min(step, TOTAL_STEPS); s++) {
				const ti = Math.floor((s - 1) / 3);  // token index
				const pi = (s - 1) % 3;              // projection index (Q/K/V)
				const col = projColors[pi];
				const isActive = (s === step);

				const inputY = ROW_Y[ti];
				const matrixY = ROW_Y[pi];
				const outputY = ROW_Y[ti];
				const ox = OUTPUT_X + pi * (VEC_W + 12);

				// Arrow: input → matrix
				addArrow(svg, INPUT_X + VEC_W, inputY, MATRIX_X, matrixY, col, {
					sw: isActive ? 2 : 1.2,
					opacity: isActive ? '1' : '0.35',
					cls: isActive ? 'qkv-arrow-active' : ''
				});

				// Arrow: matrix → output
				addArrow(svg, MATRIX_X + MATRIX_W, matrixY, ox, outputY, col, {
					sw: isActive ? 2 : 1.2,
					opacity: isActive ? '1' : '0.35',
					cls: isActive ? 'qkv-arrow-active' : ''
				});

				// Fill the output box
				addRect(svg, ox, outputY - VEC_H / 2, VEC_W, VEC_H, {
					fill: withAlpha(col, isActive ? 0.2 : 0.1),
					stroke: col,
					sw: isActive ? 2 : 1.2,
					opacity: isActive ? '1' : '0.6'
				});
				const subscript = String.fromCharCode(8321 + ti);
				addText(svg, ox + VEC_W / 2, outputY + 1, `${projLabels[pi]}${subscript}`, {
					size: '13',
					fill: col,
					weight: isActive ? '700' : '500',
					family: 'Georgia, serif'
				});
			}

			stepLabel.textContent = `Step ${step} / ${TOTAL_STEPS}`;
		}

		function stepForward() {
			if (currentStep < TOTAL_STEPS) {
				currentStep++;
				showStep(currentStep);
			}
		}

		function play() {
			if (playInterval) {
				clearInterval(playInterval);
				playInterval = null;
				playBtn.textContent = 'Play';
				return;
			}
			if (currentStep >= TOTAL_STEPS) {
				currentStep = 0;
			}
			playBtn.textContent = 'Pause';
			playInterval = setInterval(() => {
				currentStep++;
				showStep(currentStep);
				if (currentStep >= TOTAL_STEPS) {
					clearInterval(playInterval);
					playInterval = null;
					playBtn.textContent = 'Play';
				}
			}, 500);
		}

		function reset() {
			if (playInterval) {
				clearInterval(playInterval);
				playInterval = null;
				playBtn.textContent = 'Play';
			}
			currentStep = 0;
			showStep(0);
		}

		stepBtn.addEventListener('click', stepForward);
		playBtn.addEventListener('click', play);
		resetBtn.addEventListener('click', reset);

		// Initial render
		showStep(0);
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// --- Dot product attention + softmax interactive ---
		const rawScoresEl = document.getElementById('attn-raw-scores');
		const scaledScoresEl = document.getElementById('attn-scaled-scores');
		const barsEl = document.getElementById('attn-bars');
		const sumEl = document.getElementById('attn-sum');
		const tempSlider = document.getElementById('attn-temp-slider');
		const tempDisplay = document.getElementById('attn-temp-display');

		if (!rawScoresEl || !scaledScoresEl || !barsEl || !tempSlider) return;

		// Simulated dot product scores for q2 ("cat") attending to ["The", "cat", "sat"]
		const tokens = ['The', 'cat', 'sat'];
		const rawScores = [2.1, 8.4, 5.7]; // q2·k1, q2·k2, q2·k3
		const dk = 64; // typical d_k
		const sqrtDk = Math.sqrt(dk); // 8

		const scaledBase = rawScores.map(s => s / sqrtDk);

		function softmax(scores, temperature) {
			const scaled = scores.map(s => s / temperature);
			const maxS = Math.max(...scaled);
			const exps = scaled.map(s => Math.exp(s - maxS));
			const sum = exps.reduce((a, b) => a + b, 0);
			return exps.map(e => e / sum);
		}

		// Render raw score cells
		function renderRawScores() {
			rawScoresEl.innerHTML = '';
			tokens.forEach((tok, i) => {
				const cell = document.createElement('div');
				cell.className = 'attn-score-cell';
				const highlight = rawScores[i] === Math.max(...rawScores) ? ' style="border-color: hsl(35 90% 55% / 0.4); background: hsl(35 90% 55% / 0.06)"' : '';
				cell.innerHTML = '<div class="attn-score-token">q\u2082 \u00b7 k' + String.fromCharCode(8321 + i) + ' ("' + tok + '")</div>' +
					'<div class="attn-score-value"' + highlight + '>' + rawScores[i].toFixed(1) + '</div>';
				rawScoresEl.appendChild(cell);
			});
		}

		// Render scaled score cells
		function renderScaledScores() {
			scaledScoresEl.innerHTML = '';
			tokens.forEach((tok, i) => {
				const cell = document.createElement('div');
				cell.className = 'attn-score-cell';
				cell.innerHTML = '<div class="attn-score-token">"' + tok + '"</div>' +
					'<div class="attn-score-value">' + scaledBase[i].toFixed(3) + '</div>';
				scaledScoresEl.appendChild(cell);
			});
		}

		// Render softmax bars
		function renderBars(temperature) {
			const weights = softmax(scaledBase, temperature);
			barsEl.innerHTML = '';

			const maxWeight = Math.max(...weights);

			tokens.forEach((tok, i) => {
				const col = document.createElement('div');
				col.className = 'attn-bar-col';

				const valLabel = document.createElement('div');
				valLabel.className = 'attn-bar-value';
				valLabel.textContent = weights[i].toFixed(3);

				const bar = document.createElement('div');
				bar.className = 'attn-bar';
				const heightPct = (weights[i] / maxWeight) * 100;
				const intensity = 0.3 + weights[i] * 0.7;
				bar.style.height = Math.max(heightPct, 2) + '%';
				bar.style.background = 'hsl(35 90% 55% / ' + intensity.toFixed(2) + ')';

				const tokLabel = document.createElement('div');
				tokLabel.className = 'attn-bar-token';
				tokLabel.textContent = '"' + tok + '"';

				col.appendChild(valLabel);
				col.appendChild(bar);
				col.appendChild(tokLabel);
				barsEl.appendChild(col);
			});

			if (sumEl) {
				const sum = weights.reduce((a, b) => a + b, 0);
				sumEl.textContent = 'Sum = ' + sum.toFixed(3);
			}
		}

		// Temperature slider handler
		tempSlider.addEventListener('input', () => {
			const temp = parseFloat(tempSlider.value);
			if (tempDisplay) tempDisplay.textContent = 'Temperature: ' + temp.toFixed(1);
			renderBars(temp);
		});

		// Initial render
		renderRawScores();
		renderScaledScores();
		renderBars(1.0);
	});
</script>

<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		// ===== Feature #10: Attention pattern heatmap =====
		const tokens = ['The', 'cat', 'sat'];
		// Realistic attention weights (each row sums to ~1.0)
		// Row = query token, Col = key token
		const attnWeights = [
			[0.42, 0.31, 0.27],  // "The" attends to: self (0.42), cat (0.31), sat (0.27)
			[0.21, 0.46, 0.33],  // "cat" attends to: The (0.21), self (0.46), sat (0.33)
			[0.15, 0.38, 0.47],  // "sat" attends to: The (0.15), cat (0.38), self (0.47)
		];

		const gridEl = document.getElementById('heatmap-grid');
		const tooltipEl = document.getElementById('heatmap-tooltip');
		if (!gridEl || !tooltipEl) return;

		const allCells = [];
		const allRowLabels = [];
		const allColLabels = [];

		// Row 0: corner + column labels
		const corner = document.createElement('div');
		corner.className = 'attn-heatmap-corner';
		corner.innerHTML = 'Key →<br>Query ↓';
		gridEl.appendChild(corner);

		tokens.forEach((tok) => {
			const label = document.createElement('div');
			label.className = 'attn-heatmap-col-label';
			label.textContent = '"' + tok + '"';
			gridEl.appendChild(label);
			allColLabels.push(label);
		});

		// Rows 1-3: row label + cells
		for (let ri = 0; ri < tokens.length; ri++) {
			const rowLabel = document.createElement('div');
			rowLabel.className = 'attn-heatmap-row-label';
			rowLabel.textContent = '"' + tokens[ri] + '"';
			gridEl.appendChild(rowLabel);
			allRowLabels.push(rowLabel);

			for (let ci = 0; ci < tokens.length; ci++) {
				const weight = attnWeights[ri][ci];
				const cell = document.createElement('div');
				cell.className = 'attn-heatmap-cell';
				cell.textContent = weight.toFixed(2);
				cell.dataset.row = ri;
				cell.dataset.col = ci;

				// Amber color with opacity proportional to weight
				const alpha = 0.08 + weight * 0.85;
				cell.style.background = 'hsl(35 90% 55% / ' + alpha.toFixed(2) + ')';

				// Text color: dark on strong, light on weak
				if (weight > 0.35) {
					cell.style.color = 'hsl(35 20% 15%)';
				} else {
					cell.style.color = 'hsl(var(--theme-text) / 0.7)';
				}

				cell.addEventListener('mouseenter', () => highlightCell(ri, ci));
				cell.addEventListener('mouseleave', clearHighlight);
				cell.addEventListener('click', (e) => {
					e.stopPropagation();
					highlightCell(ri, ci);
				});

				gridEl.appendChild(cell);
				allCells.push(cell);
			}
		}

		function highlightCell(row, col) {
			const weight = attnWeights[row][col];

			allRowLabels.forEach((label, i) => {
				label.classList.toggle('highlight', i === row);
				label.classList.toggle('dimmed', i !== row);
			});
			allColLabels.forEach((label, i) => {
				label.classList.toggle('highlight', i === col);
				label.classList.toggle('dimmed', i !== col);
			});

			allCells.forEach((c) => {
				const cr = parseInt(c.dataset.row);
				const cc = parseInt(c.dataset.col);
				c.classList.toggle('dimmed', cr !== row || cc !== col);
			});

			tooltipEl.textContent = '"' + tokens[row] + '" → "' + tokens[col] + '": ' + weight.toFixed(3);
			tooltipEl.classList.add('visible');
		}

		function clearHighlight() {
			allRowLabels.forEach((label) => {
				label.classList.remove('highlight', 'dimmed');
			});
			allColLabels.forEach((label) => {
				label.classList.remove('highlight', 'dimmed');
			});
			allCells.forEach((c) => {
				c.classList.remove('dimmed');
			});
			tooltipEl.classList.remove('visible');
		}

		document.addEventListener('click', clearHighlight);
	});
</script>

