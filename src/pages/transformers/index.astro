			<rect x="2" y="13.5" width="6" height="1.5" rx="0.75" fill="currentColor"/>
		</svg>
	</button>
	<div id="mobile-toc-backdrop" class="mobile-toc-backdrop" aria-hidden="true"></div>
	<div id="mobile-toc-drawer" class="mobile-toc-drawer" aria-hidden="true">
		<div class="mobile-toc-header">
