								<div class="val-bar-pct">21%</div>
							</div>
							<div class="val-bar-row">
								<div class="val-bar-label">"cat"</div>
								<div class="val-bar-track"><div class="val-bar-fill" style="width: 46%;"></div></div>
								<div class="val-bar-pct">46%</div>
							</div>
							<div class="val-bar-row">
								<div class="val-bar-label">"sat"</div>
