	.hw-residual-phase {
		font-size: 0.55rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		text-align: center;
	}

	/* Additive flow: Input + Attn Output = Enriched */
	.hw-residual-flow {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		justify-content: center;
		width: 100%;
	}

	/* Shared box wrapper for Input, Attn Output, Enriched */
	.hw-residual-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
		flex-shrink: 0;
	}

	.hw-residual-box-label {
		font-size: 0.5rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	/* Input matrix (purple — the original normalized input X̂) */
	.hw-residual-input-label { color: hsl(270 50% 58%); }

	.hw-residual-input-grid {
		display: grid;
		gap: 1px;
		background: hsl(270 50% 58% / 0.06);
		border: 1.5px solid hsl(270 50% 58% / 0.25);
		border-radius: 3px;
		overflow: hidden;
	}

	.hw-residual-input-cell {
		background: hsl(270 50% 58% / 0.06);
		color: hsl(270 50% 58% / 0.7);
		font-size: 0.38rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		padding: 1px 1px;
		text-align: center;
		min-width: 18px;
		min-height: 14px;
	}

	.hw-residual-input-cell.dots-cell {
		font-size: 0.45rem;
		color: hsl(270 50% 58% / 0.4);
		padding: 0px 1px;
	}

	.hw-residual-input-dim {
		font-size: 0.42rem;
		color: hsl(var(--theme-text) / 0.35);
	}

	/* Attention output matrix (green — from Step 11) */
	.hw-residual-attn-label { color: hsl(145 55% 42%); }

	.hw-residual-attn-grid {
		display: grid;
		gap: 1px;
		background: hsl(145 55% 42% / 0.06);
		border: 1.5px solid hsl(145 55% 42% / 0.25);
		border-radius: 3px;
		overflow: hidden;
	}

	.hw-residual-attn-cell {
		background: hsl(145 55% 42% / 0.08);
		color: hsl(145 55% 42% / 0.75);
		font-size: 0.38rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		padding: 1px 1px;
		text-align: center;
		min-width: 18px;
		min-height: 14px;
	}

	.hw-residual-attn-cell.dots-cell {
		font-size: 0.45rem;
		color: hsl(145 55% 42% / 0.4);
		padding: 0px 1px;
	}

	.hw-residual-attn-dim {
		font-size: 0.42rem;
		color: hsl(var(--theme-text) / 0.35);
	}

	/* Plus / equals operators */
	.hw-residual-plus {
		font-size: 0.9rem;
		font-weight: 700;
		color: hsl(var(--theme-text) / 0.35);
		align-self: center;
		padding: 0 2px;
		padding-top: 14px;
		transition: color 0.4s ease, transform 0.4s ease;
	}

	.hw-residual-plus.pulse {
		color: hsl(35 90% 55%);
		transform: scale(1.3);
	}

	.hw-residual-equals {
		font-size: 0.9rem;
		font-weight: 700;
		color: hsl(var(--theme-text) / 0.35);
		align-self: center;
		padding: 0 2px;
		padding-top: 14px;
	}

	/* Enriched output matrix (warm purple/gold blend — hsl 35 for "enriched") */
	.hw-residual-result-wrap {
		opacity: 0;
		transform: translateX(8px);
		transition: opacity 0.5s ease, transform 0.5s ease;
	}

	.hw-residual-result-wrap.visible {
		opacity: 1;
		transform: translateX(0);
	}

	.hw-residual-result-label { color: hsl(35 90% 55%); }

	.hw-residual-result-grid {
		display: grid;
		gap: 1px;
		background: hsl(35 90% 55% / 0.06);
		border: 2px solid hsl(35 90% 55% / 0.3);
		border-radius: 3px;
		overflow: hidden;
	}

	.hw-residual-result-cell {
		background: hsl(35 90% 55% / 0.08);
		color: hsl(35 90% 55% / 0.8);
		font-size: 0.38rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		padding: 1px 1px;
		text-align: center;
		min-width: 18px;
		min-height: 14px;
	}

	.hw-residual-result-cell.dots-cell {
		font-size: 0.45rem;
		color: hsl(35 90% 55% / 0.4);
		padding: 0px 1px;
	}

	.hw-residual-result-dim {
		font-size: 0.42rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 2px;
	}

	/* Token column labels for result */
	.hw-residual-result-col-labels {
		display: grid;
		gap: 1px;
	}

	.hw-residual-result-col-label {
		font-size: 0.36rem;
		text-align: center;
		color: hsl(35 90% 55% / 0.6);
		min-width: 18px;
		padding: 0 1px;
	}

	/* Equation row */
	.hw-residual-equation {
		font-size: 0.55rem;
		color: hsl(var(--theme-text) / 0.5);
		text-align: center;
		margin-top: 2px;
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.hw-residual-equation.visible {
		opacity: 1;
	}

	.hw-residual-eq-input { color: hsl(270 50% 58%); font-weight: 600; }
	.hw-residual-eq-attn { color: hsl(145 55% 42%); font-weight: 600; }
	.hw-residual-eq-result { color: hsl(35 90% 55%); font-weight: 600; }

	/* Feed-forward arrow and next layer preview */
	.hw-residual-forward {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.6s ease, transform 0.6s ease;
	}

	.hw-residual-forward.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.hw-residual-forward-arrow {
		font-size: 1.1rem;
		color: hsl(var(--theme-text) / 0.25);
	}

	.hw-residual-next-layer {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		background: hsl(var(--theme-text) / 0.03);
		border: 1.5px dashed hsl(var(--theme-text) / 0.12);
		border-radius: 6px;
	}

	.hw-residual-next-label {
		font-size: 0.5rem;
		color: hsl(var(--theme-text) / 0.35);
		font-weight: 500;
	}

	.hw-residual-next-blocks {
		display: flex;
		gap: 4px;
	}

	.hw-residual-next-block {
		padding: 3px 8px;
		border-radius: 3px;
		font-size: 0.4rem;
		font-weight: 600;
		letter-spacing: 0.03em;
	}

	.hw-residual-next-ffn {
		background: hsl(150 55% 45% / 0.1);
		color: hsl(150 55% 45% / 0.6);
		border: 1px solid hsl(150 55% 45% / 0.2);
	}

	.hw-residual-next-more {
		background: hsl(var(--theme-text) / 0.04);
		color: hsl(var(--theme-text) / 0.3);
		border: 1px solid hsl(var(--theme-text) / 0.1);
	}

	/* Responsive */
	@media (max-width: 480px) {
		.hw-residual-flow {
			flex-direction: column;
			align-items: center;
			gap: 8px;
		}
		.hw-residual-plus, .hw-residual-equals {
			transform: rotate(90deg);
			padding-top: 0;
		}
		.hw-residual-plus.pulse {
			transform: rotate(90deg) scale(1.3);
		}
		.hw-residual-input-cell, .hw-residual-attn-cell, .hw-residual-result-cell {
			font-size: 0.34rem;
			min-width: 16px;
		}
		.hw-residual-result-col-label {
			font-size: 0.32rem;
			min-width: 16px;
		}
	}

	/* Step 1 placeholder viz */
	.hw-step-placeholder {
		text-align: center;
		color: hsl(var(--theme-text) / 0.4);
		font-size: 0.85rem;
		font-style: italic;
	}

	/* (640px head-walk-body stacking removed — body is now single-column always, annotation in gutter on desktop) */

	@media (max-width: 480px) {
		.head-walk-viz {
			min-width: 400px;
		}
		.head-walk-container {
			padding: 1rem;
		}
	}

	@media (max-width: 480px) {
		.val-output-container {
			padding: 1rem;
		}
		.val-step-row {
			font-size: 0.72rem;
			gap: 0.3rem;
		}
		.val-sum-divider {
			margin: 0.4rem 1rem;
		}
		.attn-pipeline-flow {
			gap: 0.2rem;
		}
		.attn-pipeline-box {
			padding: 0.35rem 0.5rem;
			font-size: 0.65rem;
		}
	}

	/* ===== Feature #12: Multi-Head Attention ===== */

	/* Parallel heads intro diagram */
	.mha-parallel-intro {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		text-align: center;
	}

	.mha-parallel-title {
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1.2rem;
	}

	.mha-parallel-diagram {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
	}

	.mha-single-head-box {
		padding: 0.8rem 1.2rem;
		border: 2px solid hsl(35 90% 55% / 0.3);
		border-radius: 8px;
		background: hsl(35 90% 55% / 0.06);
	}

	.mha-head-label {
		font-size: 0.72rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 0.4rem;
	}

	.mha-head-pipeline {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		justify-content: center;
	}

	.mha-mini-box {
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 600;
	}

	.mha-mini-qkv {
		background: hsl(var(--theme-text) / 0.05);
		border: 1px solid hsl(var(--theme-text) / 0.15);
		display: flex;
		gap: 0.2rem;
	}

	.mha-mini-attn {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.mha-mini-out {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.mha-mini-arrow {
		color: hsl(var(--theme-text) / 0.3);
		font-size: 0.8rem;
	}

	.mha-duplicate-arrow {
		font-size: 1rem;
		color: hsl(var(--theme-text) / 0.3);
		font-weight: 600;
	}

	.mha-multi-head-stack {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
		max-width: 360px;
	}

	.mha-head-slot {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		justify-content: center;
		padding: 0.5rem 0.8rem;
		border-radius: 8px;
		border: 1px solid hsl(35 90% 55% / 0.2);
		background: hsl(35 90% 55% / 0.04);
	}

	.mha-head-tag {
		font-size: 0.65rem;
		font-weight: 700;
		color: hsl(35 90% 55%);
		min-width: 3.5rem;
		text-align: right;
	}

	/* Head heatmap gallery */
	.mha-heads-gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin: 2rem 0;
	}

	.mha-head-card {
		background: hsl(var(--theme-bg));
		border: 1px solid hsl(var(--theme-text) / 0.1);
		border-radius: 10px;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.mha-head-card-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.mha-head-number {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		color: hsl(35 90% 55%);
	}

	.mha-head-role {
		font-size: 0.75rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.6);
	}

	.mha-head-card-desc {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
		line-height: 1.4;
	}

	/* Mini heatmap grids (3x3, smaller than Feature #10) */
	.mha-heatmap-grid {
		display: grid;
		grid-template-columns: auto repeat(3, 1fr);
		grid-template-rows: auto repeat(3, 1fr);
		gap: 2px;
		align-items: center;
		justify-items: center;
		margin-top: auto;
	}

	.mha-heatmap-corner {
		font-size: 0.5rem;
		color: hsl(var(--theme-text) / 0.25);
		text-align: center;
		line-height: 1.2;
	}

	.mha-heatmap-col-label,
	.mha-heatmap-row-label {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.6rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		padding: 2px;
	}

	.mha-heatmap-cell {
		width: 100%;
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 3px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.58rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.7);
		cursor: default;
		transition: transform 0.15s ease;
		min-height: 36px;
	}

	.mha-heatmap-cell:hover {
		transform: scale(1.08);
	}

	@media (max-width: 768px) {
		.mha-heads-gallery {
			grid-template-columns: 1fr;
			max-width: 320px;
			margin-left: auto;
			margin-right: auto;
		}
	}

	@media (max-width: 480px) {
		.mha-parallel-intro {
			padding: 1rem;
		}
		.mha-head-card {
			padding: 0.8rem;
		}
	}

	/* ===== Feature #13: Concatenation & Projection ===== */

	.mha-formula {
		text-align: center;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.88rem;
		color: hsl(35 90% 55%);
		padding: 1rem;
		margin: 1.5rem 0;
		background: hsl(35 90% 55% / 0.06);
		border: 1px solid hsl(35 90% 55% / 0.15);
		border-radius: 8px;
	}

	/* Concat diagram */
	.mha-concat-diagram {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
	}

	.mha-concat-title {
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.mha-concat-heads {
		display: flex;
		gap: 0.6rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.mha-concat-head-vec {
		padding: 0.6rem 0.8rem;
		border-radius: 8px;
		text-align: center;
		min-width: 120px;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.mha-concat-head-vec.mha-head-disabled {
		opacity: 0.2;
		transform: scale(0.95);
	}

	.mha-concat-h1 {
		background: hsl(200 60% 50% / 0.12);
		border: 1px solid hsl(200 60% 50% / 0.3);
	}
	.mha-concat-h2 {
		background: hsl(35 90% 55% / 0.12);
		border: 1px solid hsl(35 90% 55% / 0.3);
	}
	.mha-concat-h3 {
		background: hsl(280 50% 55% / 0.12);
		border: 1px solid hsl(280 50% 55% / 0.3);
	}

	.mha-concat-head-label {
		font-weight: 700;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.6);
		margin-bottom: 0.2rem;
	}

	.mha-concat-head-vals {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		color: hsl(var(--theme-text) / 0.5);
	}

	.mha-concat-head-dim {
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 0.2rem;
	}

	.mha-concat-arrow {
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.4);
		font-weight: 600;
	}

	/* Wide concatenated bar */
	.mha-concat-wide {
		text-align: center;
	}

	.mha-concat-wide-label {
		font-size: 0.72rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		margin-bottom: 0.3rem;
	}

	.mha-concat-wide-bar {
		display: flex;
		border-radius: 6px;
		overflow: hidden;
		max-width: 400px;
		margin: 0 auto;
	}

	.mha-concat-wide-seg {
		flex: 1;
		padding: 0.5rem 0.8rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		text-align: center;
		transition: opacity 0.3s ease;
	}

	.mha-concat-wide-seg.mha-seg-disabled {
		opacity: 0.15;
	}

	.mha-seg-h1 {
		background: hsl(200 60% 50% / 0.25);
		color: hsl(200 60% 50%);
	}
	.mha-seg-h2 {
		background: hsl(35 90% 55% / 0.25);
		color: hsl(35 90% 55%);
	}
	.mha-seg-h3 {
		background: hsl(280 50% 55% / 0.25);
		color: hsl(280 50% 55%);
	}

	.mha-concat-wide-dim {
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 0.3rem;
	}

	/* Output vector */
	.mha-concat-output {
		text-align: center;
		padding: 0.7rem 1.2rem;
		background: hsl(35 90% 55% / 0.1);
		border: 2px solid hsl(35 90% 55% / 0.3);
		border-radius: 8px;
		transition: all 0.3s ease;
	}

	.mha-concat-output-label {
		font-weight: 700;
		font-size: 0.75rem;
		color: hsl(35 90% 55%);
		margin-bottom: 0.15rem;
	}

	.mha-concat-output-vals {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.6);
		transition: color 0.3s ease;
	}

	.mha-concat-output-dim {
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 0.15rem;
	}


	/* Residual stream handoff */
	.mha-residual-handoff {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(270 50% 58% / 0.05);
		border: 1px solid hsl(270 50% 58% / 0.15);
		border-radius: 12px;
	}

	.mha-residual-title {
		text-align: center;
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
	}

	.mha-residual-flow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.mha-residual-box {
		padding: 0.6rem 1rem;
		border-radius: 8px;
		text-align: center;
	}

	.mha-residual-box-label {
		font-size: 0.65rem;
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.mha-residual-box-val {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 700;
	}

	.mha-residual-input {
		background: hsl(270 50% 58% / 0.1);
		border: 1px solid hsl(270 50% 58% / 0.25);
	}
	.mha-residual-input .mha-residual-box-label { color: hsl(270 50% 58%); }
	.mha-residual-input .mha-residual-box-val { color: hsl(270 50% 58%); }

	.mha-residual-attn {
		background: hsl(35 90% 55% / 0.1);
