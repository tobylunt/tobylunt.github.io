		function showStep(step) {
			// step 0 = base state
			// steps 1-9: token (0-2) × projection (Q=0, K=1, V=2)
			// step 1: token0→Q, step 2: token0→K, step 3: token0→V
			// step 4: token1→Q, step 5: token1→K, step 6: token1→V
			// etc.

			drawBase();

			const projColors = [COL_Q, COL_K, COL_V];
			const projLabels = ['q', 'k', 'v'];

			for (let s = 1; s <= Math.min(step, TOTAL_STEPS); s++) {
				const ti = Math.floor((s - 1) / 3);  // token index
				const pi = (s - 1) % 3;              // projection index (Q/K/V)
				const col = projColors[pi];
				const isActive = (s === step);

				const inputY = ROW_Y[ti];
				const matrixY = ROW_Y[pi];
				const outputY = ROW_Y[ti];
				const ox = OUTPUT_X + pi * (VEC_W + 12);

				// Arrows go into edgeLayer (rendered behind nodes)
				addArrow(edgeLayer, INPUT_X + VEC_W, inputY, MATRIX_X, matrixY, col, {
					sw: isActive ? 2 : 1.2,
					opacity: isActive ? '1' : '0.35',
					cls: isActive ? 'qkv-arrow-active' : ''
				});

				addArrow(edgeLayer, MATRIX_X + MATRIX_W, matrixY, ox, outputY, col, {
					sw: isActive ? 2 : 1.2,
					opacity: isActive ? '1' : '0.35',
					cls: isActive ? 'qkv-arrow-active' : ''
				});

				// Output boxes + labels go into nodeLayer (rendered in front)
				addRect(nodeLayer, ox, outputY - VEC_H / 2, VEC_W, VEC_H, {
					fill: withAlpha(col, isActive ? 0.2 : 0.1),
					stroke: col,
					sw: isActive ? 2 : 1.2,
					opacity: isActive ? '1' : '0.6',
					opaque: true
				});
				const subscript = String.fromCharCode(8321 + ti);
				addText(nodeLayer, ox + VEC_W / 2, outputY + 1, `${projLabels[pi]}${subscript}`, {
					size: '13',
					fill: col,
					weight: isActive ? '700' : '500',
					family: 'Georgia, serif'
				});
			}

			stepLabel.textContent = `Step ${step} / ${TOTAL_STEPS}`;
		}

		function stepForward() {
			if (currentStep < TOTAL_STEPS) {
				currentStep++;
				showStep(currentStep);
			}
		}

		function play() {
			if (playInterval) {
				clearInterval(playInterval);
				playInterval = null;
				playBtn.textContent = 'Play';
				return;
			}
			if (currentStep >= TOTAL_STEPS) {
				currentStep = 0;
			}
			playBtn.textContent = 'Pause';
			playInterval = setInterval(() => {
				currentStep++;
				showStep(currentStep);
				if (currentStep >= TOTAL_STEPS) {
					clearInterval(playInterval);
					playInterval = null;
					playBtn.textContent = 'Play';
				}
			}, 500);
		}

		function reset() {
			if (playInterval) {
				clearInterval(playInterval);
				playInterval = null;
				playBtn.textContent = 'Play';
			}
			currentStep = 0;
			showStep(0);
		}

		stepBtn.addEventListener('click', stepForward);
		playBtn.addEventListener('click', play);
		resetBtn.addEventListener('click', reset);

		// Initial render
		showStep(0);
		}
		// Lazy: init now if near viewport, else wait
		var _r = _lazyEl.getBoundingClientRect();
		if (_r.top < window.innerHeight * 1.5) {
			_lazyInit();
		} else {
			var _lio = new IntersectionObserver(function(entries) {
				if (entries[0].isIntersecting) { _lio.disconnect(); _lazyInit(); }
			}, { rootMargin: '200px 0px' });
			_lio.observe(_lazyEl);
		}
	});
</script>

