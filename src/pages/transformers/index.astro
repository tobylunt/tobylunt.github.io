		padding: 4px 0;
		color: hsl(var(--theme-text) / 0.7);
		transition: color 0.15s, opacity 0.15s;
	}

	.attn-heatmap-col-label.highlight {
		color: hsl(35 90% 55%);
	}

	.attn-heatmap-col-label.dimmed {
		opacity: 0.3;
	}

	.attn-heatmap-row-label {
		font-size: 0.82rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.7);
		text-align: right;
		padding-right: 10px;
		transition: color 0.15s, opacity 0.15s;
	}

