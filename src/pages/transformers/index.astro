			qItem.appendChild(el('div', 'hw-kproj-staged-dim', 'Step 7'));
			staging.appendChild(qItem);

			// K^T staged box
			var ktItem = el('div', 'hw-kproj-staged-item');
			var ktLabel = el('div', 'hw-kproj-staged-label hw-kproj-staged-label-kt');
			ktLabel.innerHTML = 'K<sup>T</sup>';
			if (astroAttr) ktLabel.querySelector('sup').setAttribute(astroAttr, '');
			ktItem.appendChild(ktLabel);
			ktItem.appendChild(el('div', 'hw-kproj-staged-box hw-kproj-staged-box-kt', 'd\u00d7T'));
			ktItem.appendChild(el('div', 'hw-kproj-staged-dim', 'new'));
			staging.appendChild(ktItem);

			// V staged box
			var vItem = el('div', 'hw-kproj-staged-item');
			vItem.appendChild(el('div', 'hw-kproj-staged-label hw-kproj-staged-label-v', 'V'));
			vItem.appendChild(el('div', 'hw-kproj-staged-box hw-kproj-staged-box-v', 'T\u00d7d'));
			vItem.appendChild(el('div', 'hw-kproj-staged-dim', 'Step 8'));
			staging.appendChild(vItem);

			layout.appendChild(staging);

			// === Animation sequence ===
			// Phase 1 (immediate): matrix + W_K shown, "cat" column highlighted in orange
			// Phase 2 (600ms): pulse on highlighted column
			setTimeout(function() {
				matCells.forEach(function(mc) {
					if (mc.col === highlightCol) mc.el.classList.add('pulse');
				});
			}, 600);

			// Phase 3 (1200ms): K output appears
			setTimeout(function() {
				outWrap.classList.add('visible');
			}, 1200);

			// Phase 4 (1800ms): equation appears
			setTimeout(function() {
				eqRow.classList.add('visible');
			}, 1800);

			// Phase 5 (2400ms): transpose section appears with flip animation
			setTimeout(function() {
				transposeSection.classList.add('visible');
				tWrap.classList.add('flip-in');
			}, 2400);

			// Phase 6 (3200ms): staging area with Q, K^T, V boxes
			setTimeout(function() {
				staging.classList.add('visible');
			}, 3200);

			return layout;
		}


