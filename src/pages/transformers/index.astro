	}

	.arch-outro {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
		max-width: 42rem;
		margin-top: 2rem;
	}

	.arch-diagram-wrap {
		position: relative;
		margin: 1.5rem 0;
	}

	.arch-controls {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.75rem;
	}

	.arch-animate-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 14px;
		border-radius: 6px;
		border: 1px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-text) / 0.03);
		color: hsl(var(--theme-text) / 0.65);
		font-size: 0.78rem;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.arch-animate-btn:hover {
		background: hsl(var(--theme-accent) / 0.08);
		color: hsl(var(--theme-accent));
	}

	.arch-animate-btn.running {
		color: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent) / 0.3);
	}

	.arch-diagram {
		display: flex;
		flex-direction: column-reverse; /* bottom-to-top flow */
		align-items: center;
		gap: 6px;
		padding: 2rem 1rem;
		border-radius: 12px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
	}

	.arch-block {
		position: relative;
		width: 100%;
		max-width: 320px;
		padding: 12px 16px;
		border-radius: 8px;
		text-align: center;
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.2s ease, opacity 0.3s ease;
		border: 1.5px solid transparent;
	}

	.arch-block:hover {
		transform: scale(1.03);
		z-index: 2;
	}

	.arch-block-label {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	/* Block colors matching preamble vocabulary */
	.arch-embedding {
		background: hsl(210 70% 55% / 0.12);
		border-color: hsl(210 70% 55% / 0.3);
		color: hsl(210 70% 55%);
	}
	.arch-embedding:hover {
		box-shadow: 0 0 0 3px hsl(210 70% 55% / 0.12);
	}

	.arch-attention {
		background: hsl(35 90% 55% / 0.12);
		border-color: hsl(35 90% 55% / 0.3);
		color: hsl(35 90% 55%);
	}
	.arch-attention:hover {
		box-shadow: 0 0 0 3px hsl(35 90% 55% / 0.12);
	}

	.arch-ffn {
		background: hsl(150 55% 45% / 0.12);
		border-color: hsl(150 55% 45% / 0.3);
		color: hsl(150 55% 45%);
	}
	.arch-ffn:hover {
		box-shadow: 0 0 0 3px hsl(150 55% 45% / 0.12);
	}

	.arch-output {
		background: hsl(350 65% 55% / 0.12);
		border-color: hsl(350 65% 55% / 0.3);
		color: hsl(350 65% 55%);
	}
	.arch-output:hover {
		box-shadow: 0 0 0 3px hsl(350 65% 55% / 0.12);
	}

	.arch-norm {
		background: hsl(var(--theme-text) / 0.04);
		border-color: hsl(var(--theme-text) / 0.1);
		color: hsl(var(--theme-text) / 0.55);
		padding: 8px 16px;
	}
	.arch-norm:hover {
		box-shadow: 0 0 0 3px hsl(var(--theme-text) / 0.06);
	}

	.arch-norm-sm {
		max-width: 240px;
		padding: 6px 12px;
	}

	.arch-norm-sm .arch-block-label {
		font-size: 0.72rem;
	}

	.arch-arrow {
		font-size: 1.1rem;
		color: hsl(var(--theme-text) / 0.2);
		line-height: 1;
		user-select: none;
	}

	.arch-input-label {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.4);
		padding: 4px 0;
	}

	/* Layer group (repeated block) */
	.arch-layer-group {
		position: relative;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 6px;
		width: 100%;
		padding: 16px 12px;
		border: 1.5px dashed hsl(270 50% 58% / 0.25);
		border-radius: 10px;
		background: hsl(270 50% 58% / 0.03);
	}

	.arch-layer-bracket {
		position: absolute;
		top: 8px;
		right: 12px;
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		color: hsl(270 50% 58% / 0.55);
		letter-spacing: 0.02em;
	}

	.arch-add-label {
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		color: hsl(270 50% 58% / 0.5);
		user-select: none;
	}

	/* Residual connection wrapper */
	.arch-residual-wrap {
		position: relative;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 6px;
		width: 100%;
		padding-left: 24px;
	}

	.arch-residual-line {
		position: absolute;
		left: 6px;
		top: 8px;
		bottom: 8px;
		width: 3px;
		border-radius: 2px;
		background: hsl(270 50% 58% / 0.18);
	}

	/* Tooltip */
	.arch-tooltip {
		position: absolute;
		bottom: 100%;
		left: 50%;
		transform: translateX(-50%) translateY(-8px);
		max-width: 320px;
		padding: 10px 14px;
		border-radius: 8px;
		background: hsl(var(--theme-text) / 0.92);
		color: hsl(var(--theme-bg));
		font-size: 0.8rem;
		line-height: 1.5;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
		z-index: 10;
		white-space: normal;
	}

	.arch-tooltip.visible {
		opacity: 1;
	}

	/* Animation: data flow pulse */
	.arch-block.arch-flow-active {
		animation: archPulse 0.5s ease;
	}

	@keyframes archPulse {
		0%   { transform: scale(1); box-shadow: none; }
		50%  { transform: scale(1.06); box-shadow: 0 0 12px hsl(var(--theme-accent) / 0.3); }
		100% { transform: scale(1); box-shadow: none; }
	}

	@media (max-width: 640px) {
		.arch-block {
			max-width: none;
			padding: 10px 12px;
		}
		.arch-block-label {
			font-size: 0.75rem;
		}
		.arch-norm-sm {
			max-width: none;
		}
		.arch-residual-wrap {
			padding-left: 18px;
		}
		.arch-tooltip {
			max-width: 260px;
			font-size: 0.75rem;
		}
	}

	/* ===== Shared section prose ===== */
	.section-prose {
		max-width: 42rem;
	}

	.section-prose p {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
		margin-bottom: 1.25rem;
	}

	.section-prose strong {
		color: hsl(var(--theme-text) / 0.95);
		font-weight: 600;
	}

	.section-prose code {
		font-size: 0.9em;
		padding: 2px 5px;
		border-radius: 4px;
		background: hsl(var(--theme-text) / 0.06);
		color: hsl(var(--theme-text) / 0.85);
	}

	/* ===== Linkage callout ===== */
	.linkage-callout {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 12px 16px;
		border-radius: 8px;
		margin-bottom: 1.5rem;
		font-size: 0.88rem;
		line-height: 1.55;
		max-width: 42rem;
	}

	.linkage-callout strong {
		font-weight: 600;
	}

	.linkage-icon {
		flex-shrink: 0;
		font-size: 1rem;
		margin-top: 1px;
	}

	.linkage-embedding {
		background: hsl(210 70% 55% / 0.08);
		border: 1px solid hsl(210 70% 55% / 0.2);
		color: hsl(210 70% 55% / 0.85);
	}

	.linkage-embedding strong {
		color: hsl(210 70% 55%);
	}

	/* ===== Tokenizer widget ===== */
	.tokenizer-widget {
		margin: 2rem 0;
		max-width: 42rem;
	}

	.tokenizer-label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 6px;
	}

	.tokenizer-input {
		width: 100%;
		padding: 12px 14px;
		border-radius: 8px;
		border: 1.5px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-text) / 0.03);
		color: hsl(var(--theme-text) / 0.9);
		font-family: ui-monospace, monospace;
		font-size: 0.95rem;
		line-height: 1.5;
		resize: vertical;
		transition: border-color 0.15s ease;
	}

	.tokenizer-input:focus {
		outline: none;
		border-color: hsl(210 70% 55% / 0.5);
		box-shadow: 0 0 0 3px hsl(210 70% 55% / 0.1);
	}

	.tokenizer-input::placeholder {
		color: hsl(var(--theme-text) / 0.25);
	}

	.tokenizer-output-wrap {
		margin-top: 12px;
	}

	.tokenizer-output-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 8px;
	}

	.tokenizer-count {
		font-weight: 400;
		color: hsl(var(--theme-text) / 0.3);
	}

	.tokenizer-output {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		min-height: 44px;
		padding: 10px 12px;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
	}

	.tokenizer-placeholder {
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.25);
		font-style: italic;
	}

	/* Token chips — color scheme for reuse in later sections */
	.token-chip {
		display: inline-block;
		padding: 3px 8px;
		border-radius: 4px;
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.4;
		white-space: pre;
	}

	/* Whole word token */
	.token-whole {
		background: hsl(210 60% 55% / 0.12);
		color: hsl(210 60% 55%);
		border: 1px solid hsl(210 60% 55% / 0.2);
	}

	/* Subword piece */
	.token-sub {
		background: hsl(35 80% 50% / 0.12);
		color: hsl(35 80% 50%);
		border: 1px solid hsl(35 80% 50% / 0.2);
	}

	/* Punctuation / special */
	.token-special {
		background: hsl(var(--theme-text) / 0.06);
		color: hsl(var(--theme-text) / 0.5);
		border: 1px solid hsl(var(--theme-text) / 0.1);
	}

	/* Legend swatches */
	.tokenizer-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 10px;
	}

	.tokenizer-legend-item {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	.token-whole-example { background: hsl(210 60% 55% / 0.25); width: 12px; height: 12px; border-radius: 3px; }
	.token-sub-example { background: hsl(35 80% 50% / 0.25); width: 12px; height: 12px; border-radius: 3px; }
	.token-special-example { background: hsl(var(--theme-text) / 0.15); width: 12px; height: 12px; border-radius: 3px; }

	/* ===== Embedding transition (token → vector) ===== */
	.embed-transition {
		margin: 2.5rem 0 2rem;
		max-width: 42rem;
	}

	.embed-transition-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 10px;
	}

	.embed-transition-rows {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 1.25rem;
	}

	.embed-transition-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.embed-arrow {
		color: hsl(var(--theme-text) / 0.3);
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	.embed-vector {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		color: hsl(210 70% 55% / 0.7);
		background: hsl(210 70% 55% / 0.06);
		padding: 4px 10px;
		border-radius: 5px;
		border: 1px solid hsl(210 70% 55% / 0.12);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.embed-transition-note {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
	}

	.embed-transition-note strong {
		color: hsl(var(--theme-text) / 0.95);
		font-weight: 600;
	}

	/* ===== Embedding scatter plot ===== */
	.embed-scatter-wrap {
		margin: 2rem 0;
		max-width: 42rem;
	}

	.embed-scatter-header {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-bottom: 8px;
		flex-wrap: wrap;
	}

	.embed-scatter-title {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
	}

	.embed-scatter-subtitle {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.25);
		font-style: italic;
	}

	.embed-scatter {
		width: 100%;
		border-radius: 10px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
		color: hsl(var(--theme-text));
	}

	/* SVG point styling */
	.embed-scatter :global(.embed-point) {
		cursor: pointer;
		transition: r 0.15s ease, fill-opacity 0.15s ease;
	}

	.embed-scatter :global(.embed-point:hover) {
		fill-opacity: 1;
	}

	.embed-scatter :global(.embed-label) {
		font-family: ui-monospace, monospace;
		font-size: 10px;
		fill: hsl(var(--theme-text) / 0.85);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.embed-scatter :global(.embed-label.visible) {
		opacity: 1;
	}

	.embed-scatter :global(.embed-cluster-label) {
		font-size: 9px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		fill: currentColor;
		fill-opacity: 0.25;
		pointer-events: none;
	}

	.embed-scatter-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 8px;
	}

	.embed-scatter-legend :global(.scatter-legend-item) {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	.embed-scatter-legend :global(.scatter-legend-dot) {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	@media (max-width: 480px) {
		.embed-transition-row {
			flex-wrap: wrap;
		}
		.embed-vector {
			font-size: 0.72rem;
		}
	}

	/* ===== Subsection divider ===== */
	.subsection-divider {
		width: 60px;
		height: 1px;
		background: hsl(var(--theme-text) / 0.1);
		margin: 3rem 0 2rem;
	}

	.subsection-title {
		font-size: 1.5rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.9);
		margin-bottom: 1rem;
		display: flex;
		align-items: baseline;
		gap: 10px;
	}

	.subsection-label {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 500;
		color: hsl(var(--theme-accent) / 0.6);
	}

	/* ===== Positional encoding formula ===== */
	.posenc-formula {
		max-width: 42rem;
		margin: 1rem 0 1.5rem;
		padding: 14px 20px;
		border-radius: 8px;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.06);
		font-family: ui-monospace, monospace;
		font-size: 0.88rem;
		color: hsl(var(--theme-text) / 0.75);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.posenc-formula-row {
		display: flex;
		align-items: baseline;
		gap: 2px;
	}

	.posenc-fn {
		color: hsl(210 70% 55%);
		font-weight: 600;
	}

	.posenc-formula sub,
	.posenc-formula sup {
		font-size: 0.72em;
		color: hsl(var(--theme-text) / 0.5);
	}

	/* ===== Positional encoding interactive ===== */
	.posenc-interactive {
		max-width: 42rem;
		margin: 1.5rem 0;
	}

	.posenc-slider-wrap {
		margin-bottom: 12px;
	}

	.posenc-slider-label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 6px;
	}

	.posenc-pos-value {
		color: hsl(210 70% 55%);
		font-weight: 700;
		font-family: ui-monospace, monospace;
	}

	.posenc-slider {
		width: 100%;
		height: 6px;
		-webkit-appearance: none;
		appearance: none;
		background: hsl(var(--theme-text) / 0.08);
		border-radius: 3px;
		outline: none;
		cursor: pointer;
	}

	.posenc-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(210 70% 55%);
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 4px hsl(0 0% 0% / 0.15);
		cursor: pointer;
	}

	.posenc-slider::-moz-range-thumb {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(210 70% 55%);
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 4px hsl(0 0% 0% / 0.15);
		cursor: pointer;
	}

	.posenc-slider-range {
		display: flex;
		justify-content: space-between;
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.25);
		font-family: ui-monospace, monospace;
		margin-top: 2px;
	}

	/* Wave bars */
	.posenc-waves-wrap {
		margin-top: 8px;
	}

	.posenc-waves-label {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-bottom: 4px;
	}

	.posenc-waves-label span {
		color: hsl(210 70% 55%);
		font-weight: 600;
		font-family: ui-monospace, monospace;
	}

	.posenc-waves {
		width: 100%;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
		color: hsl(var(--theme-text));
	}

	/* ===== Heatmap ===== */
	.posenc-heatmap-wrap {
		max-width: 42rem;
		margin: 2rem 0;
	}

	.posenc-heatmap-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 8px;
	}

	.posenc-heatmap {
		width: 100%;
		max-width: 480px;
		border-radius: 6px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		image-rendering: pixelated;
	}

	.posenc-heatmap-axes {
		display: flex;
		justify-content: space-between;
		margin-top: 4px;
	}

	.posenc-axis-label,
	.posenc-axis-label-y {
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.3);
	}

	.posenc-heatmap-scale {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-top: 6px;
	}

	.posenc-scale-label {
		font-size: 0.68rem;
		font-family: ui-monospace, monospace;
		color: hsl(var(--theme-text) / 0.3);
	}

	.posenc-scale-bar {
		flex: 1;
		max-width: 120px;
		height: 8px;
		border-radius: 4px;
		background: linear-gradient(to right,
			hsl(210 80% 35%),
			hsl(210 20% 50%),
			hsl(var(--theme-bg)),
			hsl(35 60% 55%),
			hsl(35 90% 55%)
		);
		border: 1px solid hsl(var(--theme-text) / 0.06);
	}

	/* ===== Handoff diagram ===== */
	.posenc-handoff {
		max-width: 42rem;
		margin: 2.5rem 0 1rem;
		padding: 20px;
		border-radius: 10px;
		border: 1.5px solid hsl(210 70% 55% / 0.15);
		background: hsl(210 70% 55% / 0.03);
	}

	.posenc-handoff-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 14px;
	}

	.posenc-handoff-row {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
		justify-content: center;
		margin-bottom: 16px;
	}

	.posenc-handoff-box {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 14px;
		border-radius: 8px;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.posenc-handoff-icon {
		font-size: 1rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.posenc-handoff-embed {
		background: hsl(210 70% 55% / 0.1);
		border: 1px solid hsl(210 70% 55% / 0.25);
		color: hsl(210 70% 55%);
	}

	.posenc-handoff-pos {
		background: hsl(210 70% 55% / 0.1);
		border: 1px solid hsl(210 70% 55% / 0.25);
		color: hsl(210 70% 55%);
	}

	.posenc-handoff-result {
		background: hsl(35 90% 55% / 0.08);
		border: 1px solid hsl(35 90% 55% / 0.2);
		color: hsl(35 90% 55%);
	}

	.posenc-handoff-plus,
	.posenc-handoff-eq {
		font-size: 1.2rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.3);
	}

	.posenc-handoff-note {
		font-size: 0.95rem;
		line-height: 1.65;
		color: hsl(var(--theme-text) / 0.7);
	}

	.posenc-handoff-note strong {
		color: hsl(var(--theme-text) / 0.9);
		font-weight: 600;
	}

	@media (max-width: 480px) {
		.posenc-handoff-row {
			flex-direction: column;
			gap: 6px;
		}
		.posenc-formula {
			font-size: 0.78rem;
		}
	}
</style>

<script define:vars={{ sectionIds: sections.map(s => s.id) }}>
	document.addEventListener('DOMContentLoaded', () => {
		// --- Scroll-tracking via IntersectionObserver ---
		const tocLinks = document.querySelectorAll('.toc-dot-link');
		const mobileLinks = document.querySelectorAll('.mobile-toc-link');
		let activeId = null;

		function setActive(id) {
			if (id === activeId) return;
			activeId = id;

			const activeIdx = sectionIds.indexOf(id);

			tocLinks.forEach((link, i) => {
				const sectionId = link.dataset.section;
				const idx = sectionIds.indexOf(sectionId);
				link.classList.remove('active', 'read');
				if (sectionId === id) {
					link.classList.add('active');
				} else if (activeIdx >= 0 && idx < activeIdx) {
					link.classList.add('read');
				}
			});

			mobileLinks.forEach(link => {
				link.classList.toggle('active', link.dataset.section === id);
			});
		}

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter(e => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

				if (visible.length > 0) {
					setActive(visible[0].target.id);
				}
			},
			{
				rootMargin: '-10% 0px -60% 0px',
				threshold: 0,
			}
		);

		sectionIds.forEach(id => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});

		// --- Smooth scroll on TOC click ---
		function handleTocClick(e) {
			const link = e.currentTarget;
			const href = link.getAttribute('href');
			const targetId = href ? href.slice(1) : null;
			if (!targetId) return;

			e.preventDefault();
			const target = document.getElementById(targetId);
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			closeMobileDrawer();
		}

		tocLinks.forEach(link => link.addEventListener('click', handleTocClick));
		mobileLinks.forEach(link => link.addEventListener('click', handleTocClick));

		// --- Mobile drawer ---
		const toggle = document.getElementById('mobile-toc-toggle');
		const drawer = document.getElementById('mobile-toc-drawer');
		const backdrop = document.getElementById('mobile-toc-backdrop');
		const closeBtn = document.getElementById('mobile-toc-close');

		function openMobileDrawer() {
			if (!drawer || !backdrop || !toggle) return;
			drawer.classList.add('open');
			backdrop.classList.add('open');
			toggle.setAttribute('aria-expanded', 'true');
			drawer.setAttribute('aria-hidden', 'false');
		}

		function closeMobileDrawer() {
			if (!drawer || !backdrop || !toggle) return;
			drawer.classList.remove('open');
			backdrop.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
			drawer.setAttribute('aria-hidden', 'true');
		}

		toggle?.addEventListener('click', () => {
			const isOpen = drawer?.classList.contains('open');
			isOpen ? closeMobileDrawer() : openMobileDrawer();
		});

		closeBtn?.addEventListener('click', closeMobileDrawer);
		backdrop?.addEventListener('click', closeMobileDrawer);

		// --- Tokenizer widget ---
		const tokInput = document.getElementById('tokenizer-input');
		const tokOutput = document.getElementById('tokenizer-output');
		const tokCount = document.getElementById('tokenizer-count');

		if (tokInput && tokOutput) {
			// Simple BPE-like tokenizer simulation
			// Splits text into tokens that approximate real subword tokenization
			function simpleTokenize(text) {
				if (!text.trim()) return [];

				const tokens = [];
				// Split into words and punctuation, preserving spaces as leading markers
				const parts = text.match(/\s*\S+/g) || [];

				// Common words that stay whole (simulating a BPE vocabulary)
				const wholeWords = new Set([
					'the','a','an','is','are','was','were','be','been','being',
					'have','has','had','do','does','did','will','would','could',
					'should','may','might','can','shall','must','need',
					'and','or','but','not','no','yes','if','then','else',
					'for','in','on','at','to','of','from','by','with','as',
					'it','he','she','we','they','you','i','me','my','your',
					'his','her','its','our','their','this','that','what','which',
					'who','how','when','where','why','all','each','every',
					'cat','dog','sat','mat','man','day','way','time','year',
					'world','life','new','old','big','good','bad','great',
					'first','last','long','little','own','other','right',
					'said','just','know','take','come','make','like','go',
					'see','look','think','give','use','find','tell','ask',
					'work','seem','feel','try','leave','call','keep',
					'help','talk','turn','start','show','hear','play',
					'run','move','live','point','read','open','close',
					'attention','transformer','model','token','input','output',
					'layer','network','data','vector','matrix','learning',
					'hello','thank','please','sorry','happy','love',
				]);

				for (const part of parts) {
					const leading = part.match(/^\s*/)[0];
					const word = part.slice(leading.length);

					if (!word) continue;

					// Split into word chars and punctuation runs
					const segments = word.match(/[a-zA-Z']+|[^a-zA-Z']+/g) || [word];

					for (const seg of segments) {
						// Pure punctuation or number
						if (!/[a-zA-Z]/.test(seg)) {
							tokens.push({ text: (tokens.length === 0 ? '' : leading) + seg, type: 'special' });
							leading && tokens.length > 1; // consume leading space
							continue;
						}

						const lower = seg.toLowerCase();
						const display = (tokens.length === 0 ? '' : leading) + seg;

						if (wholeWords.has(lower) || seg.length <= 3) {
							tokens.push({ text: display, type: 'whole' });
						} else {
							// Simulate subword splitting
							const prefix = seg.slice(0, Math.ceil(seg.length * 0.6));
							const suffix = seg.slice(prefix.length);
							tokens.push({ text: (tokens.length === 0 ? '' : leading) + prefix, type: 'whole' });
							if (suffix) {
								tokens.push({ text: '##' + suffix, type: 'sub' });
							}
						}
					}
				}

				return tokens;
			}

			function renderTokens(text) {
				const tokens = simpleTokenize(text);
				tokOutput.innerHTML = '';

				if (tokens.length === 0) {
					tokOutput.innerHTML = '<span class="tokenizer-placeholder">Type above to see tokens\u2026</span>';
					tokCount.textContent = '';
					return;
				}

				tokCount.textContent = '(' + tokens.length + ')';

				tokens.forEach((tok, i) => {
					const chip = document.createElement('span');
					chip.className = 'token-chip token-' + tok.type;
					chip.textContent = tok.text;
					chip.title = 'Token ' + i + ' [' + tok.type + ']';
					tokOutput.appendChild(chip);
				});
			}

			tokInput.addEventListener('input', () => renderTokens(tokInput.value));

			// Show default example on load
			const defaultText = 'The cat sat on the mat.';
			tokInput.value = defaultText;
			renderTokens(defaultText);
		}

		// --- Embedding scatter plot ---
		const scatterSvg = document.getElementById('embed-scatter');
		const scatterLegend = document.getElementById('embed-scatter-legend');

		if (scatterSvg && scatterLegend) {
			const clusters = [
				{
					name: 'Animals',
					color: 'hsl(210 70% 55%)',
					words: [
						{ word: 'cat', x: 120, y: 300 },
						{ word: 'dog', x: 155, y: 320 },
						{ word: 'fish', x: 95, y: 340 },
						{ word: 'bird', x: 140, y: 270 },
						{ word: 'horse', x: 175, y: 295 },
						{ word: 'mouse', x: 110, y: 330 },
					],
					labelPos: { x: 140, y: 365 },
				},
				{
					name: 'Royalty',
					color: 'hsl(35 90% 55%)',
					words: [
						{ word: 'king', x: 445, y: 95 },
						{ word: 'queen', x: 480, y: 120 },
						{ word: 'prince', x: 420, y: 115 },
						{ word: 'throne', x: 490, y: 90 },
						{ word: 'crown', x: 455, y: 140 },
					],
					labelPos: { x: 460, y: 160 },
				},
				{
					name: 'Emotions',
					color: 'hsl(350 65% 55%)',
					words: [
						{ word: 'happy', x: 130, y: 105 },
						{ word: 'sad', x: 160, y: 130 },
						{ word: 'angry', x: 115, y: 140 },
						{ word: 'love', x: 175, y: 95 },
						{ word: 'fear', x: 140, y: 80 },
					],
					labelPos: { x: 150, y: 165 },
				},
				{
					name: 'Actions',
					color: 'hsl(150 55% 45%)',
					words: [
						{ word: 'run', x: 430, y: 295 },
						{ word: 'walk', x: 465, y: 315 },
						{ word: 'jump', x: 410, y: 325 },
						{ word: 'swim', x: 450, y: 340 },
						{ word: 'climb', x: 475, y: 280 },
					],
					labelPos: { x: 440, y: 360 },
				},
				{
					name: 'Time',
					color: 'hsl(270 50% 58%)',
					words: [
						{ word: 'day', x: 280, y: 200 },
						{ word: 'year', x: 310, y: 220 },
						{ word: 'time', x: 265, y: 230 },
						{ word: 'morning', x: 320, y: 195 },
						{ word: 'night', x: 290, y: 180 },
					],
					labelPos: { x: 300, y: 255 },
				},
			];

			const svgNS = 'http://www.w3.org/2000/svg';

			// Add cluster labels
			clusters.forEach(cluster => {
				const text = document.createElementNS(svgNS, 'text');
				text.setAttribute('x', cluster.labelPos.x);
				text.setAttribute('y', cluster.labelPos.y);
				text.setAttribute('text-anchor', 'middle');
				text.setAttribute('class', 'embed-cluster-label');
				text.style.fill = cluster.color;
				text.style.fillOpacity = '0.3';
				text.textContent = cluster.name;
				scatterSvg.appendChild(text);
			});

			// Add data points with hover labels
			let activeLabel = null;

			clusters.forEach(cluster => {
				cluster.words.forEach(pt => {
					// Create group for point + label
					const g = document.createElementNS(svgNS, 'g');

					// Circle
					const circle = document.createElementNS(svgNS, 'circle');
					circle.setAttribute('cx', pt.x);
					circle.setAttribute('cy', pt.y);
					circle.setAttribute('r', '5');
					circle.setAttribute('fill', cluster.color);
					circle.setAttribute('fill-opacity', '0.65');
					circle.setAttribute('class', 'embed-point');
					circle.setAttribute('data-word', pt.word);

					// Label (hidden by default)
					const label = document.createElementNS(svgNS, 'text');
					label.setAttribute('x', pt.x);
					label.setAttribute('y', pt.y - 10);
					label.setAttribute('text-anchor', 'middle');
					label.setAttribute('class', 'embed-label');
					label.textContent = pt.word;

					// Background rect for label readability
					const bg = document.createElementNS(svgNS, 'rect');
					bg.setAttribute('class', 'embed-label');
					bg.setAttribute('rx', '3');
					bg.setAttribute('ry', '3');
					bg.style.fill = 'hsl(var(--theme-bg))';
					bg.style.fillOpacity = '0.85';

					g.appendChild(bg);
					g.appendChild(label);
					g.appendChild(circle);

					circle.addEventListener('mouseenter', () => {
						if (activeLabel) activeLabel.forEach(el => el.classList.remove('visible'));
						label.classList.add('visible');
						bg.classList.add('visible');
						circle.setAttribute('r', '7');
						circle.setAttribute('fill-opacity', '1');
						// Position bg behind label
						const bbox = label.getBBox();
						bg.setAttribute('x', bbox.x - 3);
						bg.setAttribute('y', bbox.y - 1);
						bg.setAttribute('width', bbox.width + 6);
						bg.setAttribute('height', bbox.height + 2);
						activeLabel = [label, bg];
					});

					circle.addEventListener('mouseleave', () => {
						label.classList.remove('visible');
						bg.classList.remove('visible');
						circle.setAttribute('r', '5');
						circle.setAttribute('fill-opacity', '0.65');
						activeLabel = null;
					});

					// Touch support
					circle.addEventListener('click', (e) => {
						e.stopPropagation();
						if (activeLabel) activeLabel.forEach(el => el.classList.remove('visible'));
						label.classList.add('visible');
						bg.classList.add('visible');
						circle.setAttribute('r', '7');
						circle.setAttribute('fill-opacity', '1');
						const bbox = label.getBBox();
						bg.setAttribute('x', bbox.x - 3);
						bg.setAttribute('y', bbox.y - 1);
						bg.setAttribute('width', bbox.width + 6);
						bg.setAttribute('height', bbox.height + 2);
						activeLabel = [label, bg];
					});

					scatterSvg.appendChild(g);
				});
			});

			// Close labels on click outside
			scatterSvg.addEventListener('click', (e) => {
				if (!e.target.closest('.embed-point') && activeLabel) {
					activeLabel.forEach(el => el.classList.remove('visible'));
					// Reset all circles
					scatterSvg.querySelectorAll('.embed-point').forEach(c => {
						c.setAttribute('r', '5');
						c.setAttribute('fill-opacity', '0.65');
					});
					activeLabel = null;
				}
			});

			// Build legend
			clusters.forEach(cluster => {
				const item = document.createElement('span');
				item.className = 'scatter-legend-item';
				const dot = document.createElement('span');
				dot.className = 'scatter-legend-dot';
				dot.style.background = cluster.color;
				const text = document.createTextNode(cluster.name);
				item.appendChild(dot);
				item.appendChild(text);
				scatterLegend.appendChild(item);
			});
		}

		// --- Positional encoding interactive ---
		const posSlider = document.getElementById('posenc-slider');
		const posValue = document.getElementById('posenc-pos-value');
		const posWavePos = document.getElementById('posenc-wave-pos');
		const posWavesSvg = document.getElementById('posenc-waves');
		const posHeatmap = document.getElementById('posenc-heatmap');

		if (posSlider && posWavesSvg) {
			const svgNS = 'http://www.w3.org/2000/svg';
			const dModel = 32; // dimensions to show
			const maxPos = 32;

			function posEnc(pos, i, d) {
				const angle = pos / Math.pow(10000, (2 * Math.floor(i / 2)) / d);
				return i % 2 === 0 ? Math.sin(angle) : Math.cos(angle);
			}

			function renderWaves(pos) {
				// Clear previous bars
				posWavesSvg.querySelectorAll('.posenc-bar').forEach(el => el.remove());

				const barWidth = 540 / dModel;
				const startX = 30;
				const centerY = 80;
				const maxH = 65;

				for (let i = 0; i < dModel; i++) {
					const val = posEnc(pos, i, dModel);
					const barH = val * maxH;
					const x = startX + i * barWidth + 1;
					const w = barWidth - 2;

					const rect = document.createElementNS(svgNS, 'rect');
					rect.setAttribute('class', 'posenc-bar');
					rect.setAttribute('x', x);
					rect.setAttribute('width', Math.max(w, 2));
					rect.setAttribute('rx', '2');

					if (val >= 0) {
						rect.setAttribute('y', centerY - barH);
						rect.setAttribute('height', barH);
						rect.setAttribute('fill', 'hsl(210 70% 55%)');
						rect.setAttribute('fill-opacity', 0.3 + Math.abs(val) * 0.5);
					} else {
						rect.setAttribute('y', centerY);
						rect.setAttribute('height', -barH);
						rect.setAttribute('fill', 'hsl(35 90% 55%)');
						rect.setAttribute('fill-opacity', 0.3 + Math.abs(val) * 0.5);
					}

					posWavesSvg.appendChild(rect);
				}
			}

			posSlider.addEventListener('input', () => {
				const pos = parseInt(posSlider.value);
				posValue.textContent = pos;
				posWavePos.textContent = pos;
				renderWaves(pos);
			});

			// Initial render
			renderWaves(0);
		}

		// --- Heatmap ---
		if (posHeatmap) {
			const ctx = posHeatmap.getContext('2d');
			const dModel = 32;
			const maxPos = 32;
			const cellW = posHeatmap.width / dModel;
			const cellH = posHeatmap.height / maxPos;

			function posEnc(pos, i, d) {
				const angle = pos / Math.pow(10000, (2 * Math.floor(i / 2)) / d);
				return i % 2 === 0 ? Math.sin(angle) : Math.cos(angle);
			}

			for (let p = 0; p < maxPos; p++) {
				for (let i = 0; i < dModel; i++) {
					const val = posEnc(p, i, dModel);
					// Map [-1, 1] to color: blue (-1) → transparent (0) → amber (+1)
					let r, g, b;
					if (val >= 0) {
						// Amber: hsl(35, 90%, 55%) ≈ rgb(240, 165, 35)
						r = Math.round(240 * val + (1 - val) * 128);
						g = Math.round(165 * val + (1 - val) * 128);
						b = Math.round(35 * val + (1 - val) * 128);
					} else {
						// Blue: hsl(210, 70%, 55%) ≈ rgb(55, 130, 210)
						const v = -val;
						r = Math.round(55 * v + (1 - v) * 128);
						g = Math.round(130 * v + (1 - v) * 128);
						b = Math.round(210 * v + (1 - v) * 128);
					}
					ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
					ctx.fillRect(i * cellW, p * cellH, cellW, cellH);
				}
			}
		}

		// --- Architecture diagram: tooltips + animation ---
		const archDiagram = document.getElementById('arch-diagram');
		const archTooltip = document.getElementById('arch-tooltip');
		const animateBtn = document.getElementById('arch-animate-btn');

		if (archDiagram && archTooltip) {
			// Tooltip on hover/click
			const allBlocks = archDiagram.querySelectorAll('[data-tip]');

			function showTooltip(el) {
				const tip = el.getAttribute('data-tip');
				if (!tip) return;
				archTooltip.textContent = tip;
				archTooltip.classList.add('visible');
				// Position relative to diagram wrap
				const wrap = archDiagram.parentElement;
				const wrapRect = wrap.getBoundingClientRect();
				const elRect = el.getBoundingClientRect();
				const tooltipLeft = elRect.left + elRect.width / 2 - wrapRect.left;
				const tooltipTop = elRect.top - wrapRect.top - 8;
				archTooltip.style.left = tooltipLeft + 'px';
				archTooltip.style.top = tooltipTop + 'px';
				archTooltip.style.bottom = 'auto';
				archTooltip.style.transform = 'translateX(-50%)';
			}

			function hideTooltip() {
				archTooltip.classList.remove('visible');
			}

			allBlocks.forEach(block => {
				block.addEventListener('mouseenter', () => showTooltip(block));
				block.addEventListener('mouseleave', hideTooltip);
				block.addEventListener('click', () => showTooltip(block));
			});

			// Close tooltip on click outside
			document.addEventListener('click', (e) => {
				if (!e.target.closest('[data-tip]')) hideTooltip();
			});
		}

		// Animate data flow
		if (animateBtn && archDiagram) {
			animateBtn.addEventListener('click', () => {
				if (animateBtn.classList.contains('running')) return;
				animateBtn.classList.add('running');

				// Collect blocks in bottom-to-top visual order (column-reverse means DOM order is top-to-bottom visual, so reverse)
				const blocks = Array.from(archDiagram.querySelectorAll('.arch-block'));
				const orderedBlocks = blocks.reverse(); // now bottom-to-top

				let i = 0;
				function pulseNext() {
					if (i >= orderedBlocks.length) {
						animateBtn.classList.remove('running');
						return;
					}
					const block = orderedBlocks[i];
					block.classList.remove('arch-flow-active');
					void block.offsetWidth; // force reflow
					block.classList.add('arch-flow-active');
					block.addEventListener('animationend', () => {
						block.classList.remove('arch-flow-active');
					}, { once: true });
					i++;
					setTimeout(pulseNext, 300);
				}
				pulseNext();
			});
		}
	});
</script>
