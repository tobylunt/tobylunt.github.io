		function stepForward() {
			if (currentStep < TOTAL_STEPS) {
				currentStep++;
				showStep(currentStep);
			}
		}

		function stepBack() {
			if (currentStep > 1) {
				currentStep--;
				showStep(currentStep);
			}
		}

		function resetWalk() {
			currentStep = 1;
			showStep(1);
		}

		backBtn.addEventListener('click', stepBack);
		stepBtn.addEventListener('click', stepForward);
		resetBtn.addEventListener('click', resetWalk);

		// Reposition gutter annotation on resize/load
		window.addEventListener('resize', positionGutterAnn);
		window.addEventListener('load', positionGutterAnn);

		// Initial render
		showStep(1);

		}
		// Lazy: init now if near viewport, else wait
		var _hwr = _hwViz.getBoundingClientRect();
