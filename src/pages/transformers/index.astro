						<div class="rounded-lg border border-dashed border-textColor/15 bg-bgColor/50 px-6 py-16 text-center">
							<div class="mb-3 text-3xl text-textColor/20">&#9671;</div>
							<p class="text-sm text-textColor/40">
								Interactive content coming soon
							</p>
						</div>
					</section>
				))
			}
		</article>

		{/* Right sidenote gutter — desktop only, content added by future features */}
		<aside class="sidenote-gutter" aria-label="Sidenotes">
		</aside>
	</div>

	{/* Mobile TOC — floating button + bottom-sheet drawer */}
	<button
