<script define:vars={{ sectionIds: sections.map(s => s.id) }}>
	document.addEventListener('DOMContentLoaded', () => {
		// --- Scroll-tracking via IntersectionObserver ---
		const tocLinks = document.querySelectorAll('.toc-dot-link');
		const mobileLinks = document.querySelectorAll('.mobile-toc-link');
		let activeId = null;

		function setActive(id) {
			if (id === activeId) return;
			activeId = id;

			const activeIdx = sectionIds.indexOf(id);

			tocLinks.forEach((link, i) => {
				const sectionId = link.dataset.section;
				const idx = sectionIds.indexOf(sectionId);
				link.classList.remove('active', 'read');
				if (sectionId === id) {
					link.classList.add('active');
				} else if (activeIdx >= 0 && idx < activeIdx) {
					link.classList.add('read');
				}
			});

			mobileLinks.forEach(link => {
				link.classList.toggle('active', link.dataset.section === id);
			});
		}

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter(e => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

				if (visible.length > 0) {
					setActive(visible[0].target.id);
				}
			},
			{
				rootMargin: '-10% 0px -60% 0px',
				threshold: 0,
			}
		);

		sectionIds.forEach(id => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});

		// --- Smooth scroll on TOC click ---
		function handleTocClick(e) {
			const link = e.currentTarget;
			const href = link.getAttribute('href');
			const targetId = href ? href.slice(1) : null;
			if (!targetId) return;

			e.preventDefault();
			const target = document.getElementById(targetId);
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			closeMobileDrawer();
		}

		tocLinks.forEach(link => link.addEventListener('click', handleTocClick));
		mobileLinks.forEach(link => link.addEventListener('click', handleTocClick));

		// --- Mobile drawer ---
		const toggle = document.getElementById('mobile-toc-toggle');
		const drawer = document.getElementById('mobile-toc-drawer');
		const backdrop = document.getElementById('mobile-toc-backdrop');
		const closeBtn = document.getElementById('mobile-toc-close');

		function openMobileDrawer() {
			if (!drawer || !backdrop || !toggle) return;
			drawer.classList.add('open');
			backdrop.classList.add('open');
			toggle.setAttribute('aria-expanded', 'true');
			drawer.setAttribute('aria-hidden', 'false');
		}

		function closeMobileDrawer() {
			if (!drawer || !backdrop || !toggle) return;
			drawer.classList.remove('open');
			backdrop.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
			drawer.setAttribute('aria-hidden', 'true');
		}

		toggle?.addEventListener('click', () => {
			const isOpen = drawer?.classList.contains('open');
			isOpen ? closeMobileDrawer() : openMobileDrawer();
		});

		closeBtn?.addEventListener('click', closeMobileDrawer);
		backdrop?.addEventListener('click', closeMobileDrawer);

		// --- Tokenizer widget ---
		const tokInput = document.getElementById('tokenizer-input');
		const tokOutput = document.getElementById('tokenizer-output');
		const tokCount = document.getElementById('tokenizer-count');

		if (tokInput && tokOutput) {
			// Find Astro scoping attribute for dynamic elements
			var tokAstroAttr = null;
			Array.from(tokOutput.attributes).forEach(function(attr) {
				if (attr.name.indexOf('data-astro-cid-') === 0) tokAstroAttr = attr.name;
			});

			// Simple BPE-like tokenizer simulation
			// Splits text into tokens that approximate real subword tokenization
			function simpleTokenize(text) {
				if (!text.trim()) return [];

				const tokens = [];
				// Split into words and punctuation, preserving spaces as leading markers
				const parts = text.match(/\s*\S+/g) || [];

				// Common words that stay whole (simulating a BPE vocabulary)
				const wholeWords = new Set([
					'the','a','an','is','are','was','were','be','been','being',
					'have','has','had','do','does','did','will','would','could',
					'should','may','might','can','shall','must','need',
					'and','or','but','not','no','yes','if','then','else',
					'for','in','on','at','to','of','from','by','with','as',
					'it','he','she','we','they','you','i','me','my','your',
					'his','her','its','our','their','this','that','what','which',
					'who','how','when','where','why','all','each','every',
					'cat','dog','sat','mat','man','day','way','time','year',
					'world','life','new','old','big','good','bad','great',
					'first','last','long','little','own','other','right',
					'said','just','know','take','come','make','like','go',
					'see','look','think','give','use','find','tell','ask',
					'work','seem','feel','try','leave','call','keep',
					'help','talk','turn','start','show','hear','play',
					'run','move','live','point','read','open','close',
					'attention','transformer','model','token','input','output',
					'layer','network','data','vector','matrix','learning',
					'hello','thank','please','sorry','happy','love',
				]);

				for (const part of parts) {
					const leading = part.match(/^\s*/)[0];
					const word = part.slice(leading.length);

					if (!word) continue;

					// Split into word chars and punctuation runs
					const segments = word.match(/[a-zA-Z']+|[^a-zA-Z']+/g) || [word];

					for (const seg of segments) {
						// Pure punctuation or number
						if (!/[a-zA-Z]/.test(seg)) {
							tokens.push({ text: (tokens.length === 0 ? '' : leading) + seg, type: 'special' });
							leading && tokens.length > 1; // consume leading space
							continue;
						}

						const lower = seg.toLowerCase();
						const display = (tokens.length === 0 ? '' : leading) + seg;

						if (wholeWords.has(lower) || seg.length <= 3) {
							tokens.push({ text: display, type: 'whole' });
						} else {
							// Simulate subword splitting
							const prefix = seg.slice(0, Math.ceil(seg.length * 0.6));
							const suffix = seg.slice(prefix.length);
							tokens.push({ text: (tokens.length === 0 ? '' : leading) + prefix, type: 'sub' });
							if (suffix) {
								tokens.push({ text: suffix, type: 'sub' });
							}
						}
					}
				}

				return tokens;
			}

			function renderTokens(text) {
				const tokens = simpleTokenize(text);
				tokOutput.innerHTML = '';

				if (tokens.length === 0) {
					tokOutput.innerHTML = '<span class="tokenizer-placeholder">Type above to see tokens\u2026</span>';
					tokCount.textContent = '';
					return;
				}

				tokCount.textContent = '(' + tokens.length + ')';

				tokens.forEach((tok, i) => {
					const chip = document.createElement('span');
					chip.className = 'token-chip token-' + tok.type;
					if (tokAstroAttr) chip.setAttribute(tokAstroAttr, '');
					chip.textContent = tok.text;
					chip.title = 'Token ' + i + ' [' + tok.type + ']';
					tokOutput.appendChild(chip);
				});
			}

			tokInput.addEventListener('input', () => renderTokens(tokInput.value));

			// Show default example on load
			const defaultText = 'The fat cat sat quietly on the mat.';
			tokInput.value = defaultText;
			renderTokens(defaultText);
		}

		// --- Embedding scatter plot ---
		const scatterSvg = document.getElementById('embed-scatter');
		const scatterLegend = document.getElementById('embed-scatter-legend');

		if (scatterSvg && scatterLegend) {
			const clusters = [
				{
					name: 'Animals',
					color: 'hsl(210 70% 55%)',
					words: [
						{ word: 'cat', x: 120, y: 300 },
						{ word: 'dog', x: 155, y: 320 },
						{ word: 'fish', x: 95, y: 340 },
						{ word: 'bird', x: 140, y: 270 },
						{ word: 'horse', x: 175, y: 295 },
						{ word: 'mouse', x: 110, y: 330 },
					],
					labelPos: { x: 140, y: 365 },
				},
				{
					name: 'Royalty',
					color: 'hsl(35 90% 55%)',
					words: [
						{ word: 'king', x: 445, y: 95 },
						{ word: 'queen', x: 480, y: 120 },
						{ word: 'prince', x: 420, y: 115 },
						{ word: 'throne', x: 490, y: 90 },
						{ word: 'crown', x: 455, y: 140 },
					],
					labelPos: { x: 460, y: 160 },
				},
				{
					name: 'Emotions',
					color: 'hsl(350 65% 55%)',
					words: [
						{ word: 'happy', x: 130, y: 105 },
						{ word: 'sad', x: 160, y: 130 },
						{ word: 'angry', x: 115, y: 140 },
						{ word: 'love', x: 175, y: 95 },
						{ word: 'fear', x: 140, y: 80 },
					],
					labelPos: { x: 150, y: 165 },
				},
				{
					name: 'Actions',
					color: 'hsl(150 55% 45%)',
					words: [
						{ word: 'run', x: 430, y: 295 },
						{ word: 'walk', x: 465, y: 315 },
						{ word: 'jump', x: 410, y: 325 },
						{ word: 'swim', x: 450, y: 340 },
						{ word: 'climb', x: 475, y: 280 },
					],
					labelPos: { x: 440, y: 360 },
				},
				{
					name: 'Time',
					color: 'hsl(270 50% 58%)',
					words: [
						{ word: 'day', x: 280, y: 200 },
						{ word: 'year', x: 310, y: 220 },
						{ word: 'time', x: 265, y: 230 },
						{ word: 'morning', x: 320, y: 195 },
						{ word: 'night', x: 290, y: 180 },
					],
					labelPos: { x: 300, y: 255 },
				},
			];

			const svgNS = 'http://www.w3.org/2000/svg';

			// Add cluster labels
			clusters.forEach(cluster => {
				const text = document.createElementNS(svgNS, 'text');
				text.setAttribute('x', cluster.labelPos.x);
				text.setAttribute('y', cluster.labelPos.y);
				text.setAttribute('text-anchor', 'middle');
				text.setAttribute('class', 'embed-cluster-label');
				text.style.fill = cluster.color;
				text.style.fillOpacity = '0.3';
				text.textContent = cluster.name;
				scatterSvg.appendChild(text);
			});

			// Add data points with hover labels
			let activeLabel = null;

			clusters.forEach(cluster => {
				cluster.words.forEach(pt => {
					// Create group for point + label
					const g = document.createElementNS(svgNS, 'g');

					// Circle
					const circle = document.createElementNS(svgNS, 'circle');
					circle.setAttribute('cx', pt.x);
					circle.setAttribute('cy', pt.y);
					circle.setAttribute('r', '5');
					circle.setAttribute('fill', cluster.color);
					circle.setAttribute('fill-opacity', '0.65');
					circle.setAttribute('class', 'embed-point');
					circle.setAttribute('data-word', pt.word);

					// Label (hidden by default)
					const label = document.createElementNS(svgNS, 'text');
					label.setAttribute('x', pt.x);
					label.setAttribute('y', pt.y - 10);
					label.setAttribute('text-anchor', 'middle');
					label.setAttribute('class', 'embed-label');
					label.textContent = pt.word;

					// Background rect for label readability
					const bg = document.createElementNS(svgNS, 'rect');
					bg.setAttribute('class', 'embed-label');
					bg.setAttribute('rx', '3');
					bg.setAttribute('ry', '3');
					bg.style.fill = 'hsl(var(--theme-bg))';
					bg.style.fillOpacity = '0.85';

					g.appendChild(bg);
					g.appendChild(label);
					g.appendChild(circle);

					circle.addEventListener('mouseenter', () => {
						if (activeLabel) activeLabel.forEach(el => el.classList.remove('visible'));
						label.classList.add('visible');
						bg.classList.add('visible');
						circle.setAttribute('r', '7');
						circle.setAttribute('fill-opacity', '1');
						// Position bg behind label
						const bbox = label.getBBox();
						bg.setAttribute('x', bbox.x - 3);
						bg.setAttribute('y', bbox.y - 1);
						bg.setAttribute('width', bbox.width + 6);
						bg.setAttribute('height', bbox.height + 2);
						activeLabel = [label, bg];
					});

					circle.addEventListener('mouseleave', () => {
						label.classList.remove('visible');
						bg.classList.remove('visible');
						circle.setAttribute('r', '5');
						circle.setAttribute('fill-opacity', '0.65');
						activeLabel = null;
					});

					// Touch support
					circle.addEventListener('click', (e) => {
						e.stopPropagation();
						if (activeLabel) activeLabel.forEach(el => el.classList.remove('visible'));
						label.classList.add('visible');
						bg.classList.add('visible');
						circle.setAttribute('r', '7');
						circle.setAttribute('fill-opacity', '1');
						const bbox = label.getBBox();
						bg.setAttribute('x', bbox.x - 3);
						bg.setAttribute('y', bbox.y - 1);
						bg.setAttribute('width', bbox.width + 6);
						bg.setAttribute('height', bbox.height + 2);
