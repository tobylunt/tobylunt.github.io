		}

		// --- Positional encoding interactive ---
		const posSlider = document.getElementById('posenc-slider');
		const posValue = document.getElementById('posenc-pos-value');
		const posWavePos = document.getElementById('posenc-wave-pos');
		const posWavesSvg = document.getElementById('posenc-waves');
		const posHeatmap = document.getElementById('posenc-heatmap');

		if (posSlider && posWavesSvg) {
			const svgNS = 'http://www.w3.org/2000/svg';
			const dModel = 32; // dimensions to show
			const maxPos = 32;

			function posEnc(pos, i, d) {
				const angle = pos / Math.pow(10000, (2 * Math.floor(i / 2)) / d);
				return i % 2 === 0 ? Math.sin(angle) : Math.cos(angle);
			}

			function renderWaves(pos) {
				// Clear previous bars
				posWavesSvg.querySelectorAll('.posenc-bar').forEach(el => el.remove());

				const barWidth = 540 / dModel;
				const startX = 30;
				const centerY = 80;
				const maxH = 65;

				for (let i = 0; i < dModel; i++) {
					const val = posEnc(pos, i, dModel);
					const barH = val * maxH;
					const x = startX + i * barWidth + 1;
					const w = barWidth - 2;

					const rect = document.createElementNS(svgNS, 'rect');
					rect.setAttribute('class', 'posenc-bar');
					rect.setAttribute('x', x);
					rect.setAttribute('width', Math.max(w, 2));
					rect.setAttribute('rx', '2');

					if (val >= 0) {
						rect.setAttribute('y', centerY - barH);
						rect.setAttribute('height', barH);
						rect.setAttribute('fill', 'hsl(210 70% 55%)');
						rect.setAttribute('fill-opacity', 0.3 + Math.abs(val) * 0.5);
					} else {
						rect.setAttribute('y', centerY);
						rect.setAttribute('height', -barH);
						rect.setAttribute('fill', 'hsl(35 90% 55%)');
						rect.setAttribute('fill-opacity', 0.3 + Math.abs(val) * 0.5);
					}

					posWavesSvg.appendChild(rect);
				}
			}

			posSlider.addEventListener('input', () => {
				const pos = parseInt(posSlider.value);
				posValue.textContent = pos;
				posWavePos.textContent = pos;
				renderWaves(pos);
			});

			// Initial render
			renderWaves(0);
		}

		// --- Heatmap ---
		if (posHeatmap) {
			const ctx = posHeatmap.getContext('2d');
			const dModel = 32;
			const maxPos = 32;
			const cellW = posHeatmap.width / dModel;
			const cellH = posHeatmap.height / maxPos;

			function posEnc(pos, i, d) {
				const angle = pos / Math.pow(10000, (2 * Math.floor(i / 2)) / d);
				return i % 2 === 0 ? Math.sin(angle) : Math.cos(angle);
			}

			for (let p = 0; p < maxPos; p++) {
				for (let i = 0; i < dModel; i++) {
					const val = posEnc(p, i, dModel);
					// Map [-1, 1] to color: blue (-1) → transparent (0) → amber (+1)
					let r, g, b;
					if (val >= 0) {
						// Amber: hsl(35, 90%, 55%) ≈ rgb(240, 165, 35)
						r = Math.round(240 * val + (1 - val) * 128);
						g = Math.round(165 * val + (1 - val) * 128);
						b = Math.round(35 * val + (1 - val) * 128);
					} else {
						// Blue: hsl(210, 70%, 55%) ≈ rgb(55, 130, 210)
						const v = -val;
						r = Math.round(55 * v + (1 - v) * 128);
						g = Math.round(130 * v + (1 - v) * 128);
						b = Math.round(210 * v + (1 - v) * 128);
					}
					ctx.fillStyle = `rgb(${r}, ${g}, ${b})`;
					ctx.fillRect(i * cellW, p * cellH, cellW, cellH);
				}
			}
		}

		// --- Architecture diagram: tooltips + animation ---
		const archDiagram = document.getElementById('arch-diagram');
		const archTooltip = document.getElementById('arch-tooltip');
		if (archDiagram && archTooltip) {
			// Tooltip on hover/click
			const allBlocks = archDiagram.querySelectorAll('[data-tip]');

			function showTooltip(el) {
				const tip = el.getAttribute('data-tip');
				if (!tip) return;
				archTooltip.textContent = tip;
				archTooltip.classList.add('visible');
				// Position to the right of the hovered block
				const wrap = archDiagram.parentElement;
				const wrapRect = wrap.getBoundingClientRect();
				const elRect = el.getBoundingClientRect();
				const tooltipLeft = elRect.right - wrapRect.left + 12;
				const tooltipTop = elRect.top - wrapRect.top + elRect.height / 2;
				archTooltip.style.left = tooltipLeft + 'px';
				archTooltip.style.top = tooltipTop + 'px';
				archTooltip.style.bottom = 'auto';
				archTooltip.style.transform = 'translateY(-50%)';
			}

			function hideTooltip() {
				archTooltip.classList.remove('visible');
			}

			allBlocks.forEach(block => {
				block.addEventListener('mouseenter', () => showTooltip(block));
				block.addEventListener('mouseleave', hideTooltip);
				block.addEventListener('click', () => showTooltip(block));
			});

			// Close tooltip on click outside
			document.addEventListener('click', (e) => {
				if (!e.target.closest('[data-tip]')) hideTooltip();
			});
		}

	});
</script>

<script is:inline>
	// QKV projection (lazy-init: Feature #22)
	document.addEventListener('DOMContentLoaded', () => {
		var _lazyEl = document.getElementById('qkv-svg');
		if (!_lazyEl) return;
		function _lazyInit() {
		// --- QKV projection animation ---
		const svg = document.getElementById('qkv-svg');
		if (!svg) return;

		const stepBtn = document.getElementById('qkv-step-btn');
		const playBtn = document.getElementById('qkv-play-btn');
		const resetBtn = document.getElementById('qkv-reset-btn');
		const stepLabel = document.getElementById('qkv-step-label');

		// Colors — use space-separated HSL for alpha support
		const COL_INPUT = 'hsl(35 90% 55%)';   // amber — input vectors
		const COL_Q = 'hsl(210 70% 55%)';       // blue — queries
		const COL_K = 'hsl(25 85% 55%)';        // orange — keys
		const COL_V = 'hsl(150 55% 45%)';       // green — values

		// Theme-aware colors: read computed style
		const cs = getComputedStyle(document.documentElement);
		const themeText = cs.getPropertyValue('--theme-text').trim();
		const themeBg = cs.getPropertyValue('--theme-bg').trim();
		const COL_MATRIX = `hsl(${themeText} / 0.65)`;
		const COL_DIM = `hsl(${themeText} / 0.35)`;
		const COL_BG = `hsl(${themeBg})`;

		// Helper: add alpha to an HSL color
		function withAlpha(hsl, alpha) {
			// hsl(210 70% 55%) → hsl(210 70% 55% / 0.15)
			return hsl.replace(')', ` / ${alpha})`);
		}

		// Layout
		const tokens = ['The', 'cat', 'sat'];
		const TOTAL_STEPS = 9; // 3 tokens × 3 projections (Q, K, V)
		let currentStep = 0;
		let playInterval = null;

		// Positions
		const INPUT_X = 60;
		const MATRIX_X = 250;
		const OUTPUT_X = 530;
		const ROW_Y = [100, 210, 320]; // y positions for 3 tokens
		const MATRIX_W = 120;
		const MATRIX_H = 55;
		const VEC_W = 80;
		const VEC_H = 30;

		function ns(tag) {
			return document.createElementNS('http://www.w3.org/2000/svg', tag);
		}

		function addText(parent, x, y, text, opts = {}) {
			const el = ns('text');
			el.setAttribute('x', x);
			el.setAttribute('y', y);
			el.textContent = text;
			el.setAttribute('font-size', opts.size || '13');
			el.setAttribute('fill', opts.fill || COL_DIM);
			el.setAttribute('text-anchor', opts.anchor || 'middle');
			el.setAttribute('font-family', opts.family || 'system-ui, sans-serif');
			if (opts.weight) el.setAttribute('font-weight', opts.weight);
			if (opts.cls) el.setAttribute('class', opts.cls);
			parent.appendChild(el);
			return el;
		}

		function addRect(parent, x, y, w, h, opts = {}) {
			// Opaque backing: draw a solid bg rect first so arrows behind don't show through
			if (opts.opaque) {
				const bg = ns('rect');
				bg.setAttribute('x', x);
				bg.setAttribute('y', y);
				bg.setAttribute('width', w);
				bg.setAttribute('height', h);
				bg.setAttribute('rx', opts.rx || 5);
				bg.setAttribute('fill', COL_BG);
				parent.appendChild(bg);
			}
			const el = ns('rect');
			el.setAttribute('x', x);
			el.setAttribute('y', y);
			el.setAttribute('width', w);
			el.setAttribute('height', h);
			el.setAttribute('rx', opts.rx || 5);
			el.setAttribute('fill', opts.fill || 'none');
			el.setAttribute('stroke', opts.stroke || COL_DIM);
			el.setAttribute('stroke-width', opts.sw || 1.5);
			if (opts.opacity) el.setAttribute('opacity', opts.opacity);
			if (opts.dash) el.setAttribute('stroke-dasharray', opts.dash);
			if (opts.cls) el.setAttribute('class', opts.cls);
			parent.appendChild(el);
			return el;
		}

		function addArrow(parent, x1, y1, x2, y2, color, opts = {}) {
			const el = ns('line');
			el.setAttribute('x1', x1);
			el.setAttribute('y1', y1);
			el.setAttribute('x2', x2);
			el.setAttribute('y2', y2);
			el.setAttribute('stroke', color);
			el.setAttribute('stroke-width', opts.sw || 1.5);
			if (opts.dash) el.setAttribute('stroke-dasharray', opts.dash);
			if (opts.cls) el.setAttribute('class', opts.cls);
			if (opts.opacity) el.setAttribute('opacity', opts.opacity);
			parent.appendChild(el);

			// arrowhead
			if (!opts.noHead) {
				const head = ns('polygon');
				const dx = x2 - x1;
				const dy = y2 - y1;
				const len = Math.sqrt(dx * dx + dy * dy);
				const ux = dx / len;
				const uy = dy / len;
				const sz = 5;
				const px = x2 - ux * 2;
				const py = y2 - uy * 2;
				head.setAttribute('points',
					`${x2},${y2} ${px - uy * sz},${py + ux * sz} ${px + uy * sz},${py - ux * sz}`
				);
				head.setAttribute('fill', color);
				if (opts.cls) head.setAttribute('class', opts.cls);
				if (opts.opacity) head.setAttribute('opacity', opts.opacity);
				parent.appendChild(head);
			}
			return el;
		}

		// SVG layers: edges behind, nodes in front
		var edgeLayer, nodeLayer;

		function drawBase() {
			svg.innerHTML = '';
			edgeLayer = ns('g');
			nodeLayer = ns('g');
			svg.appendChild(edgeLayer);
			svg.appendChild(nodeLayer);

			// Column labels
			addText(nodeLayer, INPUT_X + VEC_W / 2, 35, 'Input Vectors', { size: '12', fill: COL_INPUT, weight: '600' });
			addText(nodeLayer, INPUT_X + VEC_W / 2, 50, '(embedding + position)', { size: '10', fill: COL_DIM });
			addText(nodeLayer, MATRIX_X + MATRIX_W / 2, 35, 'Weight Matrices', { size: '12', fill: COL_DIM, weight: '600' });
			addText(nodeLayer, OUTPUT_X + VEC_W / 2, 35, 'Projections', { size: '12', fill: COL_DIM, weight: '600' });

			// Draw input vectors (always visible)
			tokens.forEach((tok, i) => {
				const y = ROW_Y[i];
				addRect(nodeLayer, INPUT_X, y - VEC_H / 2, VEC_W, VEC_H, {
					fill: withAlpha(COL_INPUT, 0.15),
					stroke: COL_INPUT,
					sw: 1.5,
					opaque: true
				});
				addText(nodeLayer, INPUT_X + VEC_W / 2, y + 1, `x${String.fromCharCode(8321 + i)}`, {
					size: '14', fill: COL_INPUT, weight: '600', family: 'Georgia, serif'
				});
				// Token label below
				addText(nodeLayer, INPUT_X + VEC_W / 2, y + VEC_H / 2 + 16, `"${tok}"`, {
					size: '11', fill: COL_DIM
				});
