		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 6px;
	}

	.tokenizer-input {
		width: 100%;
		padding: 12px 14px;
		border-radius: 8px;
		border: 1.5px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-text) / 0.03);
		color: hsl(var(--theme-text) / 0.9);
		font-family: ui-monospace, monospace;
		font-size: 0.95rem;
		line-height: 1.5;
		resize: vertical;
		transition: border-color 0.15s ease;
	}

	.tokenizer-input:focus {
		outline: none;
		border-color: hsl(210 70% 55% / 0.5);
		box-shadow: 0 0 0 3px hsl(210 70% 55% / 0.1);
	}

	.tokenizer-input::placeholder {
		color: hsl(var(--theme-text) / 0.25);
	}

	.tokenizer-output-wrap {
		margin-top: 12px;
	}

	.tokenizer-output-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 8px;
	}

	.tokenizer-count {
		font-weight: 400;
		color: hsl(var(--theme-text) / 0.3);
	}

	.tokenizer-output {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		min-height: 44px;
		padding: 10px 12px;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
	}

	.tokenizer-placeholder {
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.25);
		font-style: italic;
	}

	/* Token chips — color scheme for reuse in later sections */
	.token-chip {
		display: inline-block;
		padding: 3px 8px;
		border-radius: 4px;
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.4;
		white-space: pre;
	}

	/* Whole word token */
	.token-whole {
		background: hsl(210 60% 55% / 0.12);
		color: hsl(210 60% 55%);
		border: 1px solid hsl(210 60% 55% / 0.2);
	}

	/* Subword piece */
	.token-sub {
		background: hsl(35 80% 50% / 0.12);
		color: hsl(35 80% 50%);
		border: 1px solid hsl(35 80% 50% / 0.2);
	}

	/* Punctuation / special */
	.token-special {
		background: hsl(350 50% 55% / 0.1);
		color: hsl(350 50% 55%);
		border: 1px solid hsl(350 50% 55% / 0.2);
	}

	/* Legend swatches */
	.tokenizer-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 10px;
	}

	.tokenizer-legend-item {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	.token-whole-example { background: hsl(210 60% 55% / 0.25); width: 12px; height: 12px; border-radius: 3px; }
	.token-sub-example { background: hsl(35 80% 50% / 0.25); width: 12px; height: 12px; border-radius: 3px; }
	.token-special-example { background: hsl(350 50% 55% / 0.25); width: 12px; height: 12px; border-radius: 3px; }

	/* ===== Embedding transition (token → vector) ===== */
	.embed-transition {
		margin: 2.5rem 0 2rem;
		max-width: 52rem;
	}

	.embed-transition-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 10px;
	}

	.embed-transition-rows {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 1.25rem;
	}

	.embed-transition-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.embed-arrow {
		color: hsl(var(--theme-text) / 0.3);
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	.embed-vector {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		color: hsl(210 70% 55% / 0.7);
		background: hsl(210 70% 55% / 0.06);
		padding: 4px 10px;
		border-radius: 5px;
		border: 1px solid hsl(210 70% 55% / 0.12);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.embed-transition-note {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
	}

	.embed-transition-note strong {
		color: hsl(var(--theme-text) / 0.95);
		font-weight: 600;
	}

	/* ===== Embedding scatter plot ===== */
	.embed-scatter-wrap {
		margin: 2rem 0;
		max-width: 52rem;
	}

	.embed-scatter-header {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-bottom: 8px;
		flex-wrap: wrap;
	}

	.embed-scatter-title {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
	}

	.embed-scatter-subtitle {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.25);
		font-style: italic;
	}

	.embed-scatter {
		width: 100%;
		border-radius: 10px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
		color: hsl(var(--theme-text));
	}

	/* SVG point styling */
	.embed-scatter :global(.embed-point) {
		cursor: pointer;
		transition: r 0.15s ease, fill-opacity 0.15s ease;
	}

	.embed-scatter :global(.embed-point:hover) {
		fill-opacity: 1;
	}

	.embed-scatter :global(.embed-label) {
		font-family: ui-monospace, monospace;
		font-size: 10px;
		fill: hsl(var(--theme-text) / 0.85);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.embed-scatter :global(.embed-label.visible) {
		opacity: 1;
	}

	.embed-scatter :global(.embed-cluster-label) {
		font-size: 9px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		fill: currentColor;
		fill-opacity: 0.25;
		pointer-events: none;
	}

	.embed-scatter-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 8px;
	}

	.embed-scatter-legend :global(.scatter-legend-item) {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	.embed-scatter-legend :global(.scatter-legend-dot) {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	@media (max-width: 480px) {
		.embed-transition-row {
			flex-wrap: wrap;
		}
		.embed-vector {
			font-size: 0.72rem;
		}
	}

	/* ===== Subsection divider ===== */
	.subsection-divider {
		width: 60px;
		height: 1px;
		background: hsl(var(--theme-text) / 0.1);
		margin: 3rem 0 2rem;
	}

	.subsection-title {
		font-size: 1.5rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.9);
		margin-bottom: 1rem;
		display: flex;
		align-items: baseline;
		gap: 10px;
	}

	.subsection-label {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 500;
		color: hsl(var(--theme-accent) / 0.6);
	}

	/* ===== Positional encoding formula ===== */
	.posenc-formula {
		max-width: 52rem;
		margin: 1rem 0 1.5rem;
		padding: 14px 20px;
		border-radius: 8px;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.06);
		font-family: ui-monospace, monospace;
		font-size: 0.88rem;
		color: hsl(var(--theme-text) / 0.75);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.posenc-formula-row {
		display: flex;
		align-items: baseline;
		gap: 2px;
	}

	.posenc-fn {
		color: hsl(210 70% 55%);
		font-weight: 600;
	}

	.posenc-formula sub,
	.posenc-formula sup {
		font-size: 0.72em;
		color: hsl(var(--theme-text) / 0.5);
	}

	/* ===== Positional encoding interactive ===== */
	.posenc-interactive {
		max-width: 52rem;
		margin: 1.5rem 0;
	}

	.posenc-slider-wrap {
		margin-bottom: 12px;
	}

	.posenc-slider-label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 6px;
	}

	.posenc-pos-value {
		color: hsl(210 70% 55%);
		font-weight: 700;
		font-family: ui-monospace, monospace;
	}

	.posenc-slider {
		width: 100%;
		height: 6px;
		-webkit-appearance: none;
		appearance: none;
		background: hsl(var(--theme-text) / 0.08);
		border-radius: 3px;
		outline: none;
		cursor: pointer;
	}

	.posenc-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(210 70% 55%);
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 4px hsl(0 0% 0% / 0.15);
		cursor: pointer;
	}

	.posenc-slider::-moz-range-thumb {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(210 70% 55%);
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 4px hsl(0 0% 0% / 0.15);
		cursor: pointer;
	}

	.posenc-slider-range {
		display: flex;
		justify-content: space-between;
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.25);
		font-family: ui-monospace, monospace;
		margin-top: 2px;
	}

	/* Wave bars */
	.posenc-waves-wrap {
		margin-top: 8px;
	}

	.posenc-waves-label {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-bottom: 4px;
	}

	.posenc-waves-label span {
		color: hsl(210 70% 55%);
		font-weight: 600;
		font-family: ui-monospace, monospace;
	}

	.posenc-waves {
		width: 100%;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
		color: hsl(var(--theme-text));
	}

	/* ===== Heatmap ===== */
	.posenc-heatmap-wrap {
		max-width: 52rem;
		margin: 2rem 0;
	}

	.posenc-heatmap-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 8px;
	}

	.posenc-heatmap {
		width: 100%;
		max-width: 480px;
		border-radius: 6px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		image-rendering: pixelated;
	}

	.posenc-heatmap-axes {
		display: flex;
		justify-content: space-between;
		margin-top: 4px;
	}

	.posenc-axis-label,
	.posenc-axis-label-y {
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.3);
	}

	.posenc-heatmap-scale {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-top: 6px;
	}

	.posenc-scale-label {
		font-size: 0.68rem;
		font-family: ui-monospace, monospace;
		color: hsl(var(--theme-text) / 0.3);
	}

	.posenc-scale-bar {
		flex: 1;
		max-width: 120px;
		height: 8px;
		border-radius: 4px;
		background: linear-gradient(to right,
			hsl(210 80% 35%),
			hsl(210 20% 50%),
			hsl(var(--theme-bg)),
			hsl(35 60% 55%),
			hsl(35 90% 55%)
		);
		border: 1px solid hsl(var(--theme-text) / 0.06);
	}

	/* ===== Handoff diagram ===== */
	.posenc-handoff {
		max-width: 52rem;
		margin: 2.5rem 0 1rem;
		padding: 20px;
		border-radius: 10px;
		border: 1.5px solid hsl(210 70% 55% / 0.15);
		background: hsl(210 70% 55% / 0.03);
	}

	.posenc-handoff-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 14px;
	}

	.posenc-handoff-row {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
		justify-content: center;
		margin-bottom: 16px;
	}

	.posenc-handoff-box {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 14px;
		border-radius: 8px;
		font-size: 0.82rem;
		font-weight: 600;
	}

	.posenc-handoff-icon {
		font-size: 1rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.posenc-handoff-embed {
		background: hsl(210 70% 55% / 0.1);
		border: 1px solid hsl(210 70% 55% / 0.25);
		color: hsl(210 70% 55%);
	}

	.posenc-handoff-pos {
		background: hsl(210 70% 55% / 0.1);
		border: 1px solid hsl(210 70% 55% / 0.25);
		color: hsl(210 70% 55%);
	}

	.posenc-handoff-result {
		background: hsl(35 90% 55% / 0.08);
		border: 1px solid hsl(35 90% 55% / 0.2);
		color: hsl(35 90% 55%);
	}

	.posenc-handoff-plus,
	.posenc-handoff-eq {
		font-size: 1.2rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.3);
	}

	.posenc-handoff-note {
		font-size: 0.95rem;
		line-height: 1.65;
		color: hsl(var(--theme-text) / 0.7);
	}

	.posenc-handoff-note strong {
		color: hsl(var(--theme-text) / 0.9);
		font-weight: 600;
	}

	@media (max-width: 480px) {
		.posenc-handoff-row {
			flex-direction: column;
			gap: 6px;
		}
		.posenc-formula {
			font-size: 0.78rem;
		}
	}

	/* ===== Attention section — QKV ===== */
	.linkage-attention {
		background: hsl(35 90% 55% / 0.08);
		border: 1px solid hsl(35 90% 55% / 0.2);
		color: hsl(35 90% 55% / 0.85);
	}

	.linkage-attention strong {
		color: hsl(35 90% 55%);
	}

	.qkv-q-text { color: hsl(210 70% 55%); }
	.qkv-k-text { color: hsl(25 85% 55%); }
	.qkv-v-text { color: hsl(150 55% 45%); }

	.qkv-analogy-cards {
		display: flex;
		gap: 16px;
		margin: 1.5rem 0 2rem;
		max-width: 52rem;
	}

	.qkv-card {
		flex: 1;
		padding: 20px 16px;
		border-radius: 10px;
		text-align: center;
		border: 1.5px solid;
	}

	.qkv-card-q {
		background: hsl(210 70% 55% / 0.06);
		border-color: hsl(210 70% 55% / 0.25);
	}

	.qkv-card-k {
		background: hsl(25 85% 55% / 0.06);
		border-color: hsl(25 85% 55% / 0.25);
	}

	.qkv-card-v {
		background: hsl(150 55% 45% / 0.06);
		border-color: hsl(150 55% 45% / 0.25);
	}

	.qkv-card-letter {
		font-size: 1.8rem;
		font-weight: 700;
		font-family: 'Georgia', serif;
		line-height: 1;
		margin-bottom: 4px;
	}

	.qkv-card-q .qkv-card-letter { color: hsl(210 70% 55%); }
	.qkv-card-k .qkv-card-letter { color: hsl(25 85% 55%); }
	.qkv-card-v .qkv-card-letter { color: hsl(150 55% 45%); }

	.qkv-card-name {
		font-size: 0.95rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.85);
		margin-bottom: 6px;
	}

	.qkv-card-desc {
		font-size: 0.82rem;
		font-style: italic;
		color: hsl(var(--theme-text) / 0.55);
	}

	.qkv-viz-container {
		margin: 2rem 0;
		overflow: hidden;
	}

	.qkv-controls {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		flex-wrap: wrap;
	}

	.qkv-btn {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 6px 14px;
		border-radius: 6px;
		font-size: 0.82rem;
		font-weight: 500;
		cursor: pointer;
		border: 1px solid hsl(var(--theme-text) / 0.15);
		background: hsl(var(--theme-bg));
		color: hsl(var(--theme-text) / 0.75);
		transition: background 0.15s, border-color 0.15s;
	}

	.qkv-btn:hover {
		background: hsl(var(--theme-text) / 0.05);
		border-color: hsl(var(--theme-text) / 0.3);
		color: hsl(var(--theme-text) / 0.9);
	}

	.qkv-btn-step {
		border-color: hsl(var(--theme-accent) / 0.3);
		color: hsl(var(--theme-accent));
	}

	.qkv-btn-step:hover {
		background: hsl(var(--theme-accent) / 0.08);
	}

	.qkv-step-label {
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.45);
		margin-left: 8px;
		font-variant-numeric: tabular-nums;
	}

	.qkv-viz-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.qkv-svg {
		width: 100%;
		min-width: 640px;
		height: auto;
		display: block;
	}

	@media (max-width: 480px) {
		.qkv-analogy-cards {
			flex-direction: column;
			gap: 10px;
		}
		.qkv-card {
			padding: 14px 12px;
		}
	}

	/* ===== Dot product attention + softmax (Feature #9) ===== */
	.attn-formula {
		margin: 1.5rem 0;
		padding: 16px 20px;
		border-radius: 8px;
		background: hsl(35 90% 55% / 0.06);
		border: 1px solid hsl(35 90% 55% / 0.15);
		max-width: 52rem;
		font-size: 1.05rem;
		font-family: Georgia, 'Times New Roman', serif;
		color: hsl(var(--theme-text) / 0.85);
		text-align: center;
	}

	.attn-formula-dk {
		border-bottom: 1px solid hsl(var(--theme-text) / 0.4);
		padding-bottom: 1px;
	}

	/* ===== Dot product pipeline card ===== */
	.attn-pipeline-card {
		margin: 2rem 0;
		padding: 1.5rem;
		border-radius: 12px;
		border: 1px solid hsl(var(--theme-text) / 0.08);
		background: hsl(var(--theme-text) / 0.015);
		max-width: 52rem;
	}

	.attn-pipeline-header {
		font-size: 0.78rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: hsl(var(--theme-text) / 0.45);
		margin-bottom: 1rem;
		text-align: center;
	}

	.attn-pipeline-table {
		display: grid;
		grid-template-columns: auto repeat(5, 1fr);
		gap: 0;
		font-variant-numeric: tabular-nums;
	}

	.attn-pl-label {
		display: flex;
		align-items: center;
		padding: 8px 12px 8px 0;
		font-size: 0.75rem;
		font-weight: 500;
		color: hsl(var(--theme-text) / 0.45);
		white-space: nowrap;
	}

	.attn-pl-cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 10px 8px;
		border-bottom: 1px solid hsl(var(--theme-text) / 0.06);
		gap: 4px;
	}

	.attn-pl-cell-head {
		font-size: 0.72rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.55);
		padding: 6px 8px 8px;
		text-align: center;
		border-bottom: 1px solid hsl(var(--theme-text) / 0.1);
	}

	.attn-pl-value {
		font-size: 1rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.85);
	}

	.attn-pl-arrow-row {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 4px 0;
		color: hsl(var(--theme-text) / 0.25);
		font-size: 0.78rem;
	}

	.attn-pl-arrow-label {
		font-size: 0.75rem;
		font-weight: 500;
		color: hsl(35 90% 55% / 0.7);
		font-style: italic;
	}

	.attn-pl-bar-cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding: 8px;
		gap: 4px;
	}

	.attn-pl-bar-wrap {
		width: 100%;
		height: 60px;
		display: flex;
		align-items: flex-end;
	}

	.attn-pl-bar {
		width: 100%;
		border-radius: 3px 3px 0 0;
		transition: height 0.3s ease, background 0.3s ease;
		min-height: 2px;
	}

	.attn-pl-weight {
		font-size: 0.82rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.8);
	}

	.attn-pipeline-temp {
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid hsl(var(--theme-text) / 0.06);
		max-width: 320px;
		margin-left: auto;
		margin-right: auto;
	}

	.attn-temp-label {
		display: block;
		font-size: 0.85rem;
		font-weight: 500;
		color: hsl(var(--theme-text) / 0.7);
		margin-bottom: 6px;
		font-variant-numeric: tabular-nums;
		text-align: center;
	}

	.attn-temp-slider {
		width: 100%;
		-webkit-appearance: none;
		appearance: none;
		height: 5px;
		border-radius: 3px;
		background: hsl(var(--theme-text) / 0.12);
		outline: none;
		cursor: pointer;
	}

	.attn-temp-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(35 90% 55%);
		cursor: pointer;
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 3px hsl(0 0% 0% / 0.2);
	}

	.attn-temp-slider::-moz-range-thumb {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(35 90% 55%);
		cursor: pointer;
		border: 2px solid hsl(var(--theme-bg));
	}

	.attn-temp-range {
		display: flex;
		justify-content: space-between;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 4px;
	}

	@media (max-width: 480px) {
		.attn-pipeline-card { padding: 1rem; }
		.attn-pl-value { font-size: 0.85rem; }
		.attn-pl-bar-wrap { height: 40px; }
	}

	/* ===== Feature #10: Attention heatmap ===== */
	.attn-heatmap-container {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-bg));
		border: 1px solid hsl(var(--theme-text) / 0.1);
		border-radius: 12px;
	}

	.attn-heatmap-title {
		font-weight: 600;
		font-size: 0.95rem;
		color: hsl(var(--theme-text) / 0.85);
		text-align: center;
		margin-bottom: 2px;
	}

	.attn-heatmap-subtitle {
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.45);
		text-align: center;
		margin-bottom: 1.25rem;
	}

	.attn-heatmap-wrap {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.attn-heatmap-axis-query {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: hsl(var(--theme-text) / 0.3);
		writing-mode: vertical-lr;
		transform: rotate(180deg);
	}

	.attn-heatmap-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.attn-heatmap-axis-key {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: hsl(var(--theme-text) / 0.3);
		margin-bottom: 4px;
	}

	.attn-heatmap-grid {
		display: grid;
		grid-template-columns: 80px repeat(5, 58px);
		grid-template-rows: auto repeat(5, 48px);
		gap: 2px;
		align-items: center;
	}

	.attn-heatmap-corner {
		width: 1px;
		height: 1px;
	}

	.attn-heatmap-col-label {
		text-align: center;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 4px 0;
		color: hsl(var(--theme-text) / 0.5);
		transition: color 0.15s, opacity 0.15s;
	}

	.attn-heatmap-col-label.highlight {
		color: hsl(35 90% 55%);
	}

	.attn-heatmap-col-label.dimmed {
		opacity: 0.3;
	}

	.attn-heatmap-row-label {
		font-size: 0.82rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.75);
		text-align: right;
		padding: 0 14px 0 4px;
		min-width: 80px;
		transition: color 0.15s, opacity 0.15s;
		border-radius: 4px 0 0 4px;
	}

	.attn-heatmap-row-label.highlight {
		color: hsl(35 80% 48%);
		font-weight: 700;
	}

	.attn-heatmap-row-label.dimmed {
		opacity: 0.3;
	}

	.attn-heatmap-row-alt {
		background-color: hsl(var(--theme-text) / 0.025);
	}

	.attn-heatmap-cell {
		width: 58px;
		height: 48px;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.78rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		cursor: pointer;
		transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
		position: relative;
	}

	.attn-heatmap-cell:hover {
		transform: scale(1.08);
		box-shadow: 0 0 0 2px hsl(35 90% 55% / 0.6);
		z-index: 2;
	}

	.attn-heatmap-cell.dimmed {
		opacity: 0.25;
	}

	.attn-heatmap-cell.row-active {
		transform: scale(1.02);
	}

	.attn-heatmap-tooltip {
		position: absolute;
		background: hsl(var(--theme-text) / 0.9);
		color: hsl(var(--theme-bg));
		padding: 6px 12px;
		border-radius: 6px;
		font-size: 0.8rem;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s;
		white-space: nowrap;
		z-index: 10;
		left: 50%;
		transform: translateX(-50%);
	}

	.attn-heatmap-tooltip.visible {
		opacity: 1;
	}

	.attn-heatmap-legend {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: 1rem;
	}

	.attn-heatmap-legend-label {
		font-size: 0.75rem;
		color: hsl(var(--theme-text) / 0.5);
		font-variant-numeric: tabular-nums;
	}

	.attn-heatmap-legend-bar {
		width: 160px;
		height: 14px;
		border-radius: 4px;
		background: linear-gradient(to right,
			hsl(35 90% 55% / 0.05),
			hsl(35 90% 55% / 0.25),
			hsl(35 90% 55% / 0.5),
			hsl(35 90% 55% / 0.75),
			hsl(35 90% 55%)
		);
	}

	.attn-heatmap-legend-caption {
		text-align: center;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.4);
		margin-top: 4px;
	}

	@media (max-width: 480px) {
		.attn-heatmap-container {
			padding: 0.75rem;
		}
		.attn-heatmap-axis-query {
			display: none;
		}
		.attn-heatmap-grid {
			grid-template-columns: auto repeat(5, 44px);
			grid-template-rows: auto repeat(5, 38px);
			gap: 1px;
		}
		.attn-heatmap-cell {
			width: 44px;
			height: 38px;
			font-size: 0.65rem;
			border-radius: 3px;
		}
		.attn-heatmap-row-label {
			font-size: 0.68rem;
			padding-right: 6px;
		}
		.attn-heatmap-col-label {
			font-size: 0.65rem;
		}
	}

	/* ===== Feature #11: Value-Weighted Output ===== */

	.val-output-container {
		background: hsl(var(--theme-bg));
		border: 1px solid hsl(var(--theme-text) / 0.1);
		border-radius: 12px;
		padding: 1.5rem;
		margin: 2rem 0;
	}

	.val-output-title {
		font-weight: 600;
		font-size: 0.9rem;
		color: hsl(150 55% 45%);
		margin-bottom: 1rem;
		text-align: center;
	}

	.val-output-steps {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.82rem;
	}

	.val-step-row {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.val-weight {
		font-weight: 700;
		color: hsl(35 90% 55%);
		min-width: 2.4rem;
		text-align: right;
	}

	.val-times,
	.val-equals {
		color: hsl(var(--theme-text) / 0.4);
		font-weight: 400;
	}

	.val-vector-v {
		color: hsl(150 55% 45%);
		font-weight: 600;
		min-width: 4.5rem;
	}

	.val-result {
		color: hsl(var(--theme-text) / 0.7);
		font-size: 0.78rem;
	}

	.val-sum-divider {
		border-top: 2px dashed hsl(var(--theme-text) / 0.2);
		margin: 0.4rem 3rem;
	}

	.val-step-sum {
		font-weight: 700;
	}

	.val-sum-label {
		color: hsl(35 90% 55%);
		min-width: 6.9rem;
		text-align: right;
	}

	.val-result-sum {
		color: hsl(35 90% 55%);
		font-weight: 700;
		font-size: 0.82rem;
	}

	/* Contribution bar chart */
	.val-bars-container {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid hsl(var(--theme-text) / 0.08);
	}

	.val-bars-title {
		font-size: 0.78rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		margin-bottom: 0.75rem;
		text-align: center;
	}

	.val-bars {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		max-width: 320px;
		margin: 0 auto;
	}

	.val-bar-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.val-bar-label {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.6);
		min-width: 3rem;
		text-align: right;
	}

	.val-bar-track {
		flex: 1;
		height: 20px;
		background: hsl(var(--theme-text) / 0.06);
		border-radius: 4px;
		overflow: hidden;
	}

	.val-bar-fill {
		height: 100%;
		background: hsl(150 55% 45%);
		border-radius: 4px;
		transition: width 0.4s ease;
	}

	.val-bar-pct {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.75rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		min-width: 2.5rem;
	}

	/* Pipeline recap mini-diagram */
	.attn-pipeline-recap {
		margin: 2.5rem 0 1.5rem;
		padding: 1.5rem;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		overflow: hidden;
	}

	.attn-pipeline-title {
		text-align: center;
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		margin-bottom: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.attn-pipeline-flow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		flex-wrap: wrap;
	}

	.attn-pipeline-box {
		padding: 0.45rem 0.7rem;
		border-radius: 6px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.75rem;
		font-weight: 600;
		white-space: nowrap;
	}

	.attn-pipeline-arrow {
		color: hsl(var(--theme-text) / 0.3);
		font-size: 1rem;
	}

	.attn-pipe-input {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.attn-pipe-qkv {
		background: hsl(var(--theme-text) / 0.05);
		border: 1px solid hsl(var(--theme-text) / 0.15);
		color: hsl(var(--theme-text) / 0.8);
	}

	.attn-pipe-qkv .qkv-q-text { color: hsl(210 70% 55%); }
	.attn-pipe-qkv .qkv-k-text { color: hsl(25 85% 55%); }
	.attn-pipe-qkv .qkv-v-text { color: hsl(150 55% 45%); }

	.attn-pipe-dot {
		background: hsl(210 70% 55% / 0.12);
		color: hsl(210 70% 55%);
		border: 1px solid hsl(210 70% 55% / 0.25);
	}

	.attn-pipe-softmax {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.attn-pipe-wv {
		background: hsl(150 55% 45% / 0.12);
		color: hsl(150 55% 45%);
		border: 1px solid hsl(150 55% 45% / 0.25);
	}

	.attn-pipe-output {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.attn-pipeline-labels {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		margin-top: 0.4rem;
	}

	.attn-pipeline-labels span {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.3);
		text-align: center;
		min-width: 3rem;
	}

	.attn-pipeline-labels span:empty {
		min-width: 1rem;
	}

	/* 04e: Head walkthrough — attention head stepped figure */
	.head-walk-container {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-text) / 0.02);
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
	}

	.head-walk-controls {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		flex-wrap: wrap;
	}

	.head-walk-controls button:disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.head-walk-body {
		display: block;
	}

	.head-walk-viz-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.head-walk-viz {
		width: 100%;
		min-width: 520px;
		min-height: 340px;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}

	.head-walk-annotation {
		padding: 0.8rem 0 0;
		border-top: 1px solid hsl(var(--theme-text) / 0.08);
		margin-top: 1rem;
	}

	/* Hide mobile annotation on desktop where gutter is visible */
	@media (min-width: 1280px) {
		.head-walk-ann-mobile {
			display: none;
		}
	}

	/* Gutter annotation: positioned in sidenote column alongside figure */
	.hw-gutter-ann {
		position: absolute;
		left: -2rem;
		right: 0;
		padding: 0.75rem 0;
		transition: opacity 0.3s ease;
	}

	.head-walk-ann-title {
		font-size: 0.88rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.85);
		margin-bottom: 0.5rem;
		transition: color 0.3s;
	}

	.head-walk-ann-text {
		font-size: 0.82rem;
		line-height: 1.55;
		color: hsl(var(--theme-text) / 0.65);
		transition: opacity 0.3s;
	}

	.head-walk-ann-shape {
		margin-top: 0.8rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.55);
		line-height: 1.6;
	}

	.head-walk-dim-n {
		color: hsl(320 60% 55%);
		font-weight: 600;
	}

	.head-walk-dim-d {
		color: hsl(185 60% 45%);
		font-weight: 600;
	}

	/* Step 1: Black box visualization — horizontal sentence layout */
	.hw-blackbox-layout {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		width: 100%;
		padding: 1.5rem 0.5rem;
	}

	.hw-bb-sentence {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 1.05rem;
		color: hsl(var(--theme-text) / 0.85);
		line-height: 1.6;
		text-align: center;
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.hw-bb-sentence-text {
		white-space: pre-wrap;
	}

	.hw-bb-blank {
		color: hsl(var(--theme-text) / 0.3);
		letter-spacing: 0.1em;
		border-bottom: 2px dashed hsl(var(--theme-text) / 0.2);
		padding-bottom: 0.1rem;
	}

	.hw-bb-arrow-down {
		font-size: 1.4rem;
		color: hsl(var(--theme-text) / 0.25);
		line-height: 1;
	}

	.hw-bb-pipe {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.2rem;
	}

	.hw-bb-arrow {
		font-size: 1.6rem;
		color: hsl(var(--theme-text) / 0.3);
		flex-shrink: 0;
		line-height: 1;
	}

	.hw-bb-box {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: 160px;
		height: 100px;
		background: hsl(220 15% 12%);
		border-radius: 10px;
		box-shadow: 0 4px 20px hsl(0 0% 0% / 0.35);
		flex-shrink: 0;
		position: relative;
	}

	.hw-bb-box-label {
		font-size: 0.82rem;
		font-weight: 700;
		color: hsl(0 0% 100% / 0.9);
		letter-spacing: 0.03em;
	}

	.hw-bb-box-q {
		font-size: 1.4rem;
		color: hsl(0 0% 100% / 0.5);
		margin-top: 0.2rem;
	}

	.hw-bb-output {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.3rem;
		flex-shrink: 0;
	}

	.hw-bb-prediction {
		padding: 0.35rem 0.7rem;
		background: hsl(145 50% 42% / 0.15);
		border: 1px solid hsl(145 50% 42% / 0.35);
		border-radius: 4px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.88rem;
		font-weight: 600;
		color: hsl(145 50% 42%);
	}

	@media (max-width: 480px) {
		.hw-blackbox-layout {
			gap: 0.7rem;
			padding: 1rem 0.2rem;
		}
		.hw-bb-sentence {
			font-size: 0.85rem;
		}
		.hw-bb-box {
			width: 120px;
			height: 80px;
		}
		.hw-bb-box-label {
			font-size: 0.72rem;
		}
		.hw-bb-box-q {
			font-size: 1.1rem;
		}
		.hw-bb-arrow {
			font-size: 1.2rem;
		}
		.hw-bb-prediction {
			font-size: 0.78rem;
		}
	}

	/* Step 2: Tokenize — word-to-chip morph animation */
	.hw-tokenize-layout {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
		padding: 1rem 0.5rem;
	}

	.hw-tok-morph-row {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: baseline;
		gap: 0.6ch;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		max-width: 480px;
		transition: gap 0.5s ease;
	}

	.hw-tok-morphed .hw-tok-morph-row {
		gap: 6px;
	}

	.hw-tok-morph-word {
		display: inline-block;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 1.05rem;
		color: hsl(var(--theme-text) / 0.85);
		padding: 0 1px;
		border: 1px solid transparent;
		border-radius: 4px;
		background: transparent;
		white-space: nowrap;
		line-height: 1.4;
		font-weight: 500;
		transition: font-size 0.4s ease, color 0.4s ease, padding 0.4s ease,
			background 0.4s ease, border-color 0.4s ease;
		transition-delay: var(--morph-delay, 0ms);
	}

	.hw-tok-morphed .hw-tok-morph-word.hw-tok-morph-whole {
		font-size: 0.82rem;
		padding: 4px 10px;
		color: hsl(210 60% 55%);
		background: hsl(210 60% 55% / 0.12);
		border-color: hsl(210 60% 55% / 0.2);
	}

	.hw-tok-morphed .hw-tok-morph-word.hw-tok-morph-sub {
		font-size: 0.82rem;
		padding: 4px 10px;
		color: hsl(35 80% 50%);
		background: hsl(35 80% 50% / 0.12);
		border-color: hsl(35 80% 50% / 0.2);
	}

	.hw-tok-morph-split {
		display: inline-flex;
		align-items: baseline;
		gap: 0;
		position: relative;
		transition: gap 0.4s ease;
		transition-delay: 340ms;
	}

	.hw-tok-morphed .hw-tok-morph-split {
		gap: 2px;
	}

	.hw-tok-morph-bracket {
		position: absolute;
		bottom: -16px;
		left: 0;
		right: 0;
		text-align: center;
		font-size: 0.62rem;
		color: hsl(35 80% 50% / 0.65);
		white-space: nowrap;
		opacity: 0;
		transition: opacity 0.3s ease;
		transition-delay: 0.7s;
	}

	.hw-tok-morphed .hw-tok-morph-bracket {
		opacity: 1;
	}

	/* Token count: hidden until morph completes */
	.hw-tok-morph .hw-tok-count {
		opacity: 0;
		transition: opacity 0.3s ease;
		transition-delay: 0.9s;
		animation: none;
	}

	.hw-tok-morphed .hw-tok-count {
		opacity: 1;
	}

	.hw-tok-chip {
		display: inline-block;
		padding: 4px 10px;
		border-radius: 4px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.4;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(-8px);
		animation: hw-chip-in 0.35s ease forwards;
	}

	/* Whole word token — blue (matches section 03) */
	.hw-tok-whole {
		background: hsl(210 60% 55% / 0.12);
		color: hsl(210 60% 55%);
		border: 1px solid hsl(210 60% 55% / 0.2);
	}

	/* Subword piece — amber (matches section 03) */
	.hw-tok-sub {
		background: hsl(35 80% 50% / 0.12);
		color: hsl(35 80% 50%);
		border: 1px solid hsl(35 80% 50% / 0.2);
	}

	.hw-tok-count {
		margin-top: 0.5rem;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.4);
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		animation: hw-fade-in 0.3s ease 0.8s both;
	}

	@keyframes hw-chip-in {
		from {
			opacity: 0;
			transform: translateY(-8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes hw-fade-in {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	@media (max-width: 480px) {
		.hw-tok-morph-word {
			font-size: 0.85rem;
		}
		.hw-tok-morphed .hw-tok-morph-word.hw-tok-morph-whole,
		.hw-tok-morphed .hw-tok-morph-word.hw-tok-morph-sub {
			font-size: 0.72rem;
			padding: 3px 7px;
		}
		.hw-tok-chip {
			font-size: 0.72rem;
			padding: 3px 7px;
		}
	}

	/* Step 3: Token Embeddings layout — column pills */
	.hw-embed-layout {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		width: 100%;
		padding: 0.5rem 0.25rem;
	}

	.hw-embed-chips {
		display: flex;
		flex-wrap: nowrap;
		justify-content: center;
		gap: 6px;
	}

	.hw-embed-chip {
		font-size: 0.72rem;
		padding: 2px 7px;
		opacity: 0;
		transform: translateY(0);
		animation: hw-chip-in 0.3s ease forwards;
	}

	.hw-embed-arrow-row {
		display: flex;
		justify-content: center;
		gap: 6px;
	}

	.hw-embed-arrow-cell {
		width: 48px;
		text-align: center;
		font-size: 0.85rem;
		color: hsl(210 60% 55% / 0.5);
		opacity: 0;
		animation: hw-fade-in 0.25s ease forwards;
	}

	/* Body row: y-axis label + pill grid */
	.hw-embed-body {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.hw-embed-yaxis {
		writing-mode: vertical-lr;
		transform: rotate(180deg);
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.62rem;
		color: hsl(210 60% 55% / 0.6);
		letter-spacing: 0.03em;
		white-space: nowrap;
		opacity: 0;
		animation: hw-fade-in 0.3s ease 0.8s both;
	}

	.hw-embed-grid {
		display: flex;
		justify-content: center;
		gap: 6px;
	}

	/* Column pill: unified rounded rectangle per token */
	.hw-embed-pill {
		display: flex;
		flex-direction: column;
		width: 48px;
		border-radius: 6px;
		border: 1.5px solid hsl(210 60% 55% / 0.25);
		background: hsl(210 60% 55% / 0.06);
		overflow: hidden;
		opacity: 0;
		transform: scaleY(0);
		transform-origin: top center;
		animation: hw-pill-expand 0.4s ease forwards;
	}

	.hw-embed-pill-val {
		padding: 3px 2px;
		text-align: center;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.6rem;
		line-height: 1.3;
		color: hsl(210 60% 55%);
		border-top: 1px solid hsl(210 60% 55% / 0.12);
	}

	.hw-embed-pill-val:first-child {
		border-top: none;
	}

	.hw-embed-pill-dots {
		padding: 2px 2px;
		text-align: center;
		font-size: 0.75rem;
		line-height: 1;
		color: hsl(210 60% 55% / 0.4);
		border-top: 1px dashed hsl(210 60% 55% / 0.15);
		border-bottom: 1px dashed hsl(210 60% 55% / 0.15);
		background: hsl(210 60% 55% / 0.03);
	}

	@keyframes hw-pill-expand {
		from {
			opacity: 0;
			transform: scaleY(0);
		}
		to {
			opacity: 1;
			transform: scaleY(1);
		}
	}

	/* Shared keyframe used by Steps 4+ bar animations */
	@keyframes hw-col-expand {
		from {
			opacity: 0;
			transform: translateY(-6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Permanent sidenote (no close button) */
	.hw-embed-sidenote {
		margin-top: 0.5rem;
		padding: 0.5rem 0.75rem;
		font-size: 0.72rem;
		line-height: 1.5;
		color: hsl(var(--theme-text) / 0.55);
		border-left: 2px solid hsl(210 60% 55% / 0.25);
		background: hsl(210 60% 55% / 0.04);
		border-radius: 0 4px 4px 0;
		max-width: 480px;
		opacity: 0;
		animation: hw-fade-in 0.4s ease 1.2s both;
	}

	.hw-embed-sn-text {
		flex: 1;
	}

	.hw-embed-sn-text strong {
		color: hsl(var(--theme-text) / 0.7);
	}

	@media (max-width: 480px) {
		.hw-embed-pill {
			width: 38px;
		}
		.hw-embed-pill-val {
			font-size: 0.52rem;
			padding: 2px 1px;
		}
		.hw-embed-arrow-cell {
			width: 38px;
			font-size: 0.75rem;
		}
		.hw-embed-chip {
			font-size: 0.62rem;
			padding: 2px 5px;
		}
		.hw-embed-chips, .hw-embed-arrow-row, .hw-embed-grid {
			gap: 4px;
		}
		.hw-embed-sidenote {
			font-size: 0.65rem;
		}
	}

	/* Step 4: Positional Embeddings layout */
	.hw-pos-layout {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		width: 100%;
		padding: 0.5rem 0.25rem;
	}

	.hw-pos-chips {
		display: flex;
		flex-wrap: nowrap;
		justify-content: center;
		gap: 4px;
	}

	.hw-pos-chip {
		font-size: 0.72rem;
		padding: 2px 7px;
	}

	.hw-pos-arrow-row {
		display: flex;
		justify-content: center;
		gap: 4px;
	}

	.hw-pos-arrow-cell {
		width: 60px;
		text-align: center;
		font-size: 0.75rem;
		color: hsl(var(--theme-text) / 0.3);
	}

	.hw-pos-cols-row {
		display: flex;
		justify-content: center;
		gap: 4px;
	}

	.hw-pos-token-pair {
		display: flex;
		gap: 2px;
		align-items: stretch;
	}

	.hw-pos-bar {
		width: 28px;
		min-height: 90px;
		border-radius: 3px;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 4px;
		padding: 10px 1px;
	}

	.hw-pos-bar-tok {
		background: hsl(210 60% 55% / 0.12);
		border: 1px solid hsl(210 60% 55% / 0.2);
		color: hsl(210 60% 55% / 0.6);
		opacity: 0;
		animation: hw-col-expand 0.35s ease forwards;
	}

	.hw-pos-bar-pos {
		background: hsl(42 90% 55% / 0.12);
		border: 1px solid hsl(42 90% 55% / 0.25);
		color: hsl(42 90% 55% / 0.7);
		opacity: 0;
		animation: hw-col-expand 0.4s ease forwards;
	}

	.hw-pos-bar-label {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.5rem;
		letter-spacing: 0.02em;
		text-align: center;
		line-height: 1.2;
	}

	.hw-pos-bar-dots {
		font-size: 0.85rem;
		line-height: 1;
		opacity: 0.5;
		flex: 1;
		display: flex;
		align-items: center;
	}

	.hw-pos-legend {
		display: flex;
		justify-content: center;
		gap: 1.2rem;
		margin-top: 0.5rem;
		font-size: 0.65rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		color: hsl(var(--theme-text) / 0.45);
		opacity: 0;
		animation: hw-fade-in 0.3s ease 0.8s both;
	}

	.hw-pos-legend-swatch {
		display: inline-block;
		width: 10px;
		height: 10px;
		border-radius: 2px;
		margin-right: 4px;
		vertical-align: middle;
	}

	.hw-pos-legend-swatch-tok {
		background: hsl(210 60% 55% / 0.35);
	}

	.hw-pos-legend-swatch-pos {
		background: hsl(42 90% 55% / 0.45);
	}

	.hw-pos-dim-label {
		margin-top: 0.3rem;
		font-size: 0.68rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		color: hsl(var(--theme-text) / 0.35);
		opacity: 0;
		animation: hw-fade-in 0.3s ease 1s both;
	}

	@media (max-width: 480px) {
		.hw-pos-bar {
			width: 22px;
			min-height: 70px;
			padding: 4px 1px;
		}
		.hw-pos-bar-label {
			font-size: 0.48rem;
		}
		.hw-pos-chip {
			font-size: 0.62rem;
			padding: 2px 5px;
		}
		.hw-pos-legend {
			font-size: 0.58rem;
		}
	}

	/* Step 4 redesign: positional embeddings with column pills */
	.hw-pos4-layout {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		width: 100%;
		padding: 0.5rem 0.25rem;
	}
	.hw-pos4-body {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.hw-pos4-columns {
		display: flex;
		gap: 6px;
		justify-content: center;
	}
	.hw-pos4-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2px;
	}
	.hw-pos4-chip {
		font-size: 0.72rem;
		padding: 2px 7px;
	}
	.hw-pos4-arrow {
		text-align: center;
		font-size: 0.85rem;
		color: hsl(210 60% 55% / 0.5);
		line-height: 1;
	}
	.hw-pos4-pair {
		display: flex;
		gap: 0px;
		align-items: stretch;
		transition: gap 0.5s ease 0.3s;
	}
	.hw-pos4-morphed .hw-pos4-pair {
		gap: 3px;
	}
	/* Blue pill: starts at Step 3 size, shrinks on morph */
	.hw-pos4-blue {
		display: flex;
		flex-direction: column;
		width: 48px;
		border-radius: 6px;
		border: 1.5px solid hsl(210 60% 55% / 0.25);
		background: hsl(210 60% 55% / 0.06);
		overflow: hidden;
		transition: width 0.5s ease calc(0.3s + var(--i, 0) * 0.06s);
	}
	.hw-pos4-morphed .hw-pos4-blue {
		width: 24px;
	}
	/* De-emphasize numbers in blue pill on morph */
	.hw-pos4-blue .hw-embed-pill-val {
		transition: opacity 0.4s ease calc(0.2s + var(--i, 0) * 0.06s);
	}
	.hw-pos4-blue .hw-embed-pill-dots {
		transition: opacity 0.4s ease calc(0.2s + var(--i, 0) * 0.06s);
	}
	.hw-pos4-morphed .hw-pos4-blue .hw-embed-pill-val {
		opacity: 0.15;
	}
	.hw-pos4-morphed .hw-pos4-blue .hw-embed-pill-dots {
		opacity: 0.2;
	}
	/* Yellow pill: starts hidden, expands on morph */
	.hw-pos4-yellow {
		display: flex;
		flex-direction: column;
		width: 0;
		border-radius: 6px;
		border: 1.5px solid transparent;
		background: transparent;
		overflow: hidden;
		opacity: 0;
		transition: width 0.5s ease calc(0.5s + var(--i, 0) * 0.06s),
		            opacity 0.4s ease calc(0.6s + var(--i, 0) * 0.06s),
		            border-color 0.4s ease calc(0.5s + var(--i, 0) * 0.06s),
		            background-color 0.4s ease calc(0.5s + var(--i, 0) * 0.06s);
	}
	.hw-pos4-morphed .hw-pos4-yellow {
		width: 24px;
		opacity: 1;
		border-color: hsl(42 90% 55% / 0.25);
		background: hsl(42 90% 55% / 0.06);
	}
	.hw-pos4-yval {
		padding: 3px 2px;
		text-align: center;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.6rem;
		line-height: 1.3;
		color: hsl(42 90% 55% / 0.45);
		border-top: 1px solid hsl(42 90% 55% / 0.12);
		opacity: 0.25;
	}
	.hw-pos4-yval:first-child {
		border-top: none;
	}
	.hw-pos4-ydots {
		padding: 2px 2px;
		text-align: center;
		font-size: 0.75rem;
		line-height: 1;
		color: hsl(42 90% 55% / 0.3);
		border-top: 1px dashed hsl(42 90% 55% / 0.15);
		border-bottom: 1px dashed hsl(42 90% 55% / 0.15);
		background: hsl(42 90% 55% / 0.03);
	}
	.hw-pos4-legend {
		display: flex;
		justify-content: center;
		gap: 1.2rem;
		margin-top: 0.5rem;
		font-size: 0.65rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		color: hsl(var(--theme-text) / 0.45);
		opacity: 0;
		animation: hw-fade-in 0.3s ease 1.2s both;
	}
	@media (max-width: 480px) {
		.hw-pos4-blue {
			width: 38px;
		}
		.hw-pos4-morphed .hw-pos4-blue {
			width: 18px;
		}
		.hw-pos4-morphed .hw-pos4-yellow {
			width: 18px;
		}
		.hw-pos4-chip {
			font-size: 0.62rem;
			padding: 2px 5px;
		}
		.hw-pos4-columns {
			gap: 4px;
		}
		.hw-pos4-legend {
			font-size: 0.58rem;
		}
	}

	/* Step 5 redesign: per-token merge animation */
	.hw-merge5-layout {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3rem;
		width: 100%;
		padding: 0.5rem 0.25rem;
	}

	/* Pair container: holds blue + plus + yellow + green */
	.hw-merge5-pair {
		display: flex;
		gap: 3px;
		align-items: stretch;
		justify-content: center;
	}

	/* Blue pill: matches Step 4 morphed state */
	.hw-merge5-blue {
		display: flex;
		flex-direction: column;
		width: 24px;
		border-radius: 6px;
		border: 1.5px solid hsl(210 60% 55% / 0.25);
		background: hsl(210 60% 55% / 0.06);
		overflow: hidden;
		transition: width 0.45s ease calc(0.1s + var(--i, 0) * 0.06s),
		            opacity 0.35s ease calc(0.1s + var(--i, 0) * 0.06s),
		            border-color 0.35s ease calc(0.1s + var(--i, 0) * 0.06s);
	}

	/* Yellow pill: matches Step 4 morphed state */
	.hw-merge5-yellow {
		display: flex;
		flex-direction: column;
		width: 24px;
		border-radius: 6px;
		border: 1.5px solid hsl(42 90% 55% / 0.25);
		background: hsl(42 90% 55% / 0.06);
		overflow: hidden;
		transition: width 0.45s ease calc(0.15s + var(--i, 0) * 0.06s),
		            opacity 0.35s ease calc(0.15s + var(--i, 0) * 0.06s),
		            border-color 0.35s ease calc(0.15s + var(--i, 0) * 0.06s);
	}

	/* Plus sign between pills */
	.hw-merge5-plus {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.35);
		width: 14px;
		overflow: hidden;
		transition: opacity 0.3s ease calc(var(--i, 0) * 0.06s),
		            width 0.3s ease calc(var(--i, 0) * 0.06s);
	}

	/* Green merged pill: hidden initially */
	.hw-merge5-green {
		display: flex;
		flex-direction: column;
		width: 0;
		border-radius: 6px;
		border: 1.5px solid transparent;
		background: transparent;
		overflow: hidden;
		opacity: 0;
		transition: width 0.45s ease calc(0.2s + var(--i, 0) * 0.06s),
		            opacity 0.35s ease calc(0.25s + var(--i, 0) * 0.06s),
		            border-color 0.35s ease calc(0.2s + var(--i, 0) * 0.06s),
		            background-color 0.35s ease calc(0.2s + var(--i, 0) * 0.06s);
	}

	/* Blue pill internal values (faded, matching Step 4 morphed) */
	.hw-merge5-bval {
		padding: 3px 2px;
		text-align: center;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.55rem;
		line-height: 1.3;
		color: hsl(210 60% 55% / 0.55);
		border-top: 1px solid hsl(210 60% 55% / 0.08);
		opacity: 0.15;
	}

	.hw-merge5-bval:first-child {
		border-top: none;
	}

	.hw-merge5-bdots {
		padding: 2px 2px;
		text-align: center;
		font-size: 0.65rem;
		line-height: 1;
		color: hsl(210 60% 55% / 0.3);
		border-top: 1px dashed hsl(210 60% 55% / 0.08);
		border-bottom: 1px dashed hsl(210 60% 55% / 0.08);
		background: hsl(210 60% 55% / 0.02);
		opacity: 0.2;
	}

	/* Yellow pill internal values (faded) */
	.hw-merge5-yval {
		padding: 3px 2px;
		text-align: center;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.55rem;
		line-height: 1.3;
		color: hsl(42 90% 55% / 0.45);
		border-top: 1px solid hsl(42 90% 55% / 0.08);
		opacity: 0.25;
	}

	.hw-merge5-yval:first-child {
		border-top: none;
	}

	.hw-merge5-ydots {
		padding: 2px 2px;
		text-align: center;
		font-size: 0.65rem;
		line-height: 1;
		color: hsl(42 90% 55% / 0.3);
		border-top: 1px dashed hsl(42 90% 55% / 0.08);
		border-bottom: 1px dashed hsl(42 90% 55% / 0.08);
		background: hsl(42 90% 55% / 0.02);
		opacity: 0.2;
	}

	/* Green pill internal values (visible after merge) */
