							<div class="val-result" style="opacity: 0.55;">[0.04, -0.09, 0.18, ...]</div>
						</div>
						{/* Row 2: weight × V for "cat" */}
						<div class="val-step-row">
							<div class="val-weight" style="opacity: 0.88;">0.46</div>
							<div class="val-times">&times;</div>
							<div class="val-vector val-vector-v">v<sub>2</sub> "cat"</div>
