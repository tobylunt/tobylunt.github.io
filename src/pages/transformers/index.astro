							<div class="val-result val-result-sum">[0.23, 0.41, 0.35, ...]</div>
						</div>
					</div>

					{/* Bar visualization showing weight contribution */}
					<div class="val-bars-container">
						<div class="val-bars-title">Contribution to "cat" output</div>
						<div class="val-bars">
							<div class="val-bar-row">
								<div class="val-bar-label">"The"</div>
								<div class="val-bar-track"><div class="val-bar-fill" style="width: 21%;"></div></div>
								<div class="val-bar-pct">21%</div>
							</div>
							<div class="val-bar-row">
								<div class="val-bar-label">"cat"</div>
								<div class="val-bar-track"><div class="val-bar-fill" style="width: 46%;"></div></div>
								<div class="val-bar-pct">46%</div>
							</div>
							<div class="val-bar-row">
								<div class="val-bar-label">"sat"</div>
								<div class="val-bar-track"><div class="val-bar-fill" style="width: 33%;"></div></div>
