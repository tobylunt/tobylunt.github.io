<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// --- Dot product pipeline table ---
		var tableEl = document.getElementById('attn-pipeline-table');
		var tempSlider = document.getElementById('attn-temp-slider');
		var tempDisplay = document.getElementById('attn-temp-display');
		if (!tableEl || !tempSlider) return;

		// Detect Astro scoping attribute
		var astroAttr = null;
		Array.from(tableEl.attributes).forEach(function(attr) {
			if (attr.name.indexOf('data-astro-cid-') === 0) astroAttr = attr.name;
		});
		function el(tag, cls, text) {
			var e = document.createElement(tag);
			if (cls) e.className = cls;
			if (text !== undefined) e.textContent = text;
			if (astroAttr) e.setAttribute(astroAttr, '');
			return e;
		}

		var tokens = ['The', 'big', 'cat', 'sat', 'quietly'];
		var rawScores = [0.9, 2.4, 13.6, 2.1, 0.7];
		var dk = 64;
		var sqrtDk = Math.sqrt(dk);
		var scaledBase = rawScores.map(function(s) { return s / sqrtDk; });

		function softmax(scores, temperature) {
			var scaled = scores.map(function(s) { return s / temperature; });
			var maxS = Math.max.apply(null, scaled);
			var exps = scaled.map(function(s) { return Math.exp(s - maxS); });
			var sum = exps.reduce(function(a, b) { return a + b; }, 0);
			return exps.map(function(e) { return e / sum; });
		}

		// Store references to dynamic elements for updates
		var barEls = [];
		var weightEls = [];

		function buildTable(temperature) {
			tableEl.innerHTML = '';
			barEls = [];
			weightEls = [];
			var weights = softmax(scaledBase, temperature);
			var maxWeight = Math.max.apply(null, weights);

			// Row 1: Header — empty label + token names
			tableEl.appendChild(el('div', 'attn-pl-label', ''));
			tokens.forEach(function(tok) {
				tableEl.appendChild(el('div', 'attn-pl-cell-head', '\u201c' + tok + '\u201d'));
			});

			// Row 2: Raw scores
			tableEl.appendChild(el('div', 'attn-pl-label', 'q\u2082 \u00b7 k\u1d62'));
			tokens.forEach(function(tok, i) {
				var cell = el('div', 'attn-pl-cell');
				cell.appendChild(el('span', 'attn-pl-value', rawScores[i].toFixed(1)));
				tableEl.appendChild(cell);
			});

			// Arrow row: ÷√d_k
			var arrowRow1 = el('div', 'attn-pl-arrow-row');
			arrowRow1.innerHTML = '\u2193 <span class="attn-pl-arrow-label">\u00f7\u221a' + dk + ' = \u00f7' + sqrtDk.toFixed(0) + '</span>';
			if (astroAttr) {
				var innerSpans = arrowRow1.querySelectorAll('span');
				for (var s = 0; s < innerSpans.length; s++) innerSpans[s].setAttribute(astroAttr, '');
			}
			tableEl.appendChild(arrowRow1);

			// Row 3: Scaled scores
			tableEl.appendChild(el('div', 'attn-pl-label', 'scaled'));
			tokens.forEach(function(tok, i) {
				var cell = el('div', 'attn-pl-cell');
				cell.appendChild(el('span', 'attn-pl-value', scaledBase[i].toFixed(3)));
				tableEl.appendChild(cell);
			});

			// Arrow row: softmax
			var arrowRow2 = el('div', 'attn-pl-arrow-row');
			arrowRow2.innerHTML = '\u2193 <span class="attn-pl-arrow-label">softmax</span>';
			if (astroAttr) {
				var innerSpans2 = arrowRow2.querySelectorAll('span');
				for (var s2 = 0; s2 < innerSpans2.length; s2++) innerSpans2[s2].setAttribute(astroAttr, '');
			}
			tableEl.appendChild(arrowRow2);

			// Row 4: Softmax bars + weights
			tableEl.appendChild(el('div', 'attn-pl-label', 'weight'));
			tokens.forEach(function(tok, i) {
				var cell = el('div', 'attn-pl-bar-cell');
				var wrap = el('div', 'attn-pl-bar-wrap');
				var bar = el('div', 'attn-pl-bar');
				var heightPct = (weights[i] / maxWeight) * 100;
				var intensity = 0.3 + weights[i] * 0.7;
				bar.style.height = Math.max(heightPct, 2) + '%';
				bar.style.background = 'hsl(35 90% 55% / ' + intensity.toFixed(2) + ')';
				wrap.appendChild(bar);
				cell.appendChild(wrap);
				var wt = el('div', 'attn-pl-weight', weights[i].toFixed(3));
				cell.appendChild(wt);
				barEls.push(bar);
				weightEls.push(wt);
				tableEl.appendChild(cell);
			});
		}

		function updateBars(temperature) {
			var weights = softmax(scaledBase, temperature);
			var maxWeight = Math.max.apply(null, weights);
			tokens.forEach(function(tok, i) {
				var heightPct = (weights[i] / maxWeight) * 100;
				var intensity = 0.3 + weights[i] * 0.7;
				barEls[i].style.height = Math.max(heightPct, 2) + '%';
				barEls[i].style.background = 'hsl(35 90% 55% / ' + intensity.toFixed(2) + ')';
				weightEls[i].textContent = weights[i].toFixed(3);
			});
		}

		tempSlider.addEventListener('input', function() {
			var temp = parseFloat(tempSlider.value);
			if (tempDisplay) tempDisplay.textContent = 'Temperature: ' + temp.toFixed(1);
			updateBars(temp);
		});

		buildTable(1.0);
	});
</script>

