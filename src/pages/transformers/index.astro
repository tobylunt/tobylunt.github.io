---
import PageLayout from "@/layouts/Base.astro";

const sections = [
	{
		id: "preamble",
		number: "01",
		title: "Preamble",
		subtitle: "Why transformers changed everything",
	},
	{
		id: "architecture",
		number: "02",
		title: "Architecture Overview",
		subtitle: "The full picture, from input to output",
	},
	{
		id: "embeddings",
		number: "03",
		title: "Embeddings",
		subtitle: "Turning words into numbers",
	},
	{
		id: "attention",
		number: "04",
		title: "Attention",
		subtitle: "The mechanism that lets tokens talk to each other",
	},
	{
		id: "multi-head-attention",
		number: "05",
		title: "Multi-Head Attention",
		subtitle: "Many perspectives, one representation",
	},
	{
		id: "ffn",
		number: "06",
		title: "Feed-Forward Network",
		subtitle: "Per-token computation and memory",
	},
	{
		id: "residual-stream",
		number: "07",
		title: "Residual Stream",
		subtitle: "The information highway through the network",
	},
	{
		id: "output",
		number: "08",
		title: "Output",
		subtitle: "From vectors back to words",
	},
	{
		id: "circuits",
		number: "09",
		title: "Circuits",
		subtitle: "How attention heads compose into algorithms",
	},
];
---

<PageLayout meta={{ title: "How Transformers Work" }}>
	{/* Hero — full width, above the three-column layout */}
	<header class="hero mx-auto max-w-3xl px-4 pb-16 pt-8 text-center sm:px-6 sm:pt-16">
		<p class="mb-4 text-sm font-medium uppercase tracking-widest text-accent">
			Interactive Explainer
		</p>
		<h1 class="mb-6 text-4xl font-bold leading-tight text-accent-2 sm:text-5xl lg:text-6xl">
			How Transformers Work
		</h1>
		<p class="mx-auto max-w-2xl text-lg leading-relaxed text-textColor/80 sm:text-xl">
			A visual, interactive guide to the architecture behind modern AI — from
			tokens to predictions, attention to circuits.
		</p>
		<div class="mt-10 flex items-center justify-center gap-3 text-sm text-textColor/50">
			<span>Toby Lunt</span>
			<span class="text-accent/40">|</span>
			<span>2026</span>
			<span class="text-accent/40">|</span>
			<span>~30 min read</span>
		</div>
		<div class="mx-auto mt-12 h-px w-24 bg-accent/30"></div>
	</header>

	{/* Three-column body: TOC | Content | Sidenotes */}
	<div class="transformers-layout">
		{/* Left TOC sidebar — desktop only */}
		<nav id="toc-sidebar" class="toc-sidebar" aria-label="Table of contents">
			<div class="toc-inner">
				<ul class="toc-list">
					{
						sections.map((section) => (
							<li>
								<a
									href={`#${section.id}`}
									class="toc-dot-link"
									data-section={section.id}
									aria-label={section.title}
								>
									<span class="toc-dot"></span>
									<span class="toc-label">{section.number} {section.title}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>

		{/* Main content column */}
		<article class="transformers-content">
			{
				sections.map((section) => (
					<section
						id={section.id}
						class="section-placeholder mb-24 scroll-mt-20"
					>
						<div class="mb-8 flex items-baseline gap-4">
							<span class="font-mono text-sm text-accent/60">
								{section.number}
							</span>
							<div>
								<h2 class="text-2xl font-semibold text-accent-2 sm:text-3xl">
									{section.title}
								</h2>
								<p class="mt-1 text-base text-textColor/60">
									{section.subtitle}
								</p>
							</div>
						</div>
						<div class="rounded-lg border border-dashed border-textColor/15 bg-bgColor/50 px-6 py-16 text-center">
							<div class="mb-3 text-3xl text-textColor/20">&#9671;</div>
							<p class="text-sm text-textColor/40">
								Interactive content coming soon
							</p>
						</div>
					</section>
				))
			}
		</article>

		{/* Right sidenote gutter — desktop only, content added by future features */}
		<aside class="sidenote-gutter" aria-label="Sidenotes">
		</aside>
	</div>

	{/* Mobile TOC — floating button + bottom-sheet drawer */}
	<button
		id="mobile-toc-toggle"
		class="mobile-toc-toggle"
		aria-label="Table of contents"
		aria-expanded="false"
	>
		<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
			<rect x="2" y="3" width="14" height="1.5" rx="0.75" fill="currentColor"/>
			<rect x="2" y="8.25" width="10" height="1.5" rx="0.75" fill="currentColor"/>
			<rect x="2" y="13.5" width="6" height="1.5" rx="0.75" fill="currentColor"/>
		</svg>
	</button>
	<div id="mobile-toc-backdrop" class="mobile-toc-backdrop" aria-hidden="true"></div>
	<div id="mobile-toc-drawer" class="mobile-toc-drawer" aria-hidden="true">
		<div class="mobile-toc-header">
			<span class="mobile-toc-title">Contents</span>
			<button id="mobile-toc-close" class="mobile-toc-close" aria-label="Close table of contents">
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
					<path d="M4 4L12 12M12 4L4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
				</svg>
			</button>
		</div>
		<ul class="mobile-toc-list">
			{
				sections.map((section) => (
					<li>
						<a href={`#${section.id}`} class="mobile-toc-link" data-section={section.id}>
							<span class="mobile-toc-number">{section.number}</span>
							{section.title}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</PageLayout>

<style>
	/* ===== Break out of Base layout's max-w-3xl body constraint ===== */
	.hero {
		width: 100vw;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
	}

	.transformers-layout {
		display: grid;
		grid-template-columns: 1fr;
		/* Break out of body max-width */
		width: 100vw;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		padding: 0 1rem;
	}

	@media (min-width: 1280px) {
		.transformers-layout {
			grid-template-columns: 180px minmax(0, 1fr) 200px;
			gap: 0 2rem;
			padding: 0 3rem;
		}
	}

	@media (min-width: 1536px) {
		.transformers-layout {
			grid-template-columns: 200px minmax(0, 1fr) 240px;
			gap: 0 2.5rem;
			padding: 0 4rem;
		}
	}

	/* ===== Main content column ===== */
	.transformers-content {
		grid-column: 1;
		padding: 0 0 2rem;
		min-width: 0;
	}

	@media (min-width: 1280px) {
		.transformers-content {
			grid-column: 2;
		}
	}

	/* ===== Left TOC sidebar ===== */
	.toc-sidebar {
		display: none;
	}

	@media (min-width: 1280px) {
		.toc-sidebar {
			display: block;
			grid-column: 1;
			grid-row: 1;
		}
	}

	.toc-inner {
		position: sticky;
		top: 5rem;
	}

	.toc-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0;
		/* Vertical line behind dots — centered on the dot column */
		position: relative;
	}

	.toc-list::before {
		content: '';
		position: absolute;
		left: 4px; /* center of 9px dot area */
		top: 14px; /* vertically center between first and last dot */
		bottom: 14px;
		width: 1.5px;
		background: hsl(var(--theme-text) / 0.1);
		border-radius: 1px;
	}

	.toc-dot-link {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 7px 0;
		text-decoration: none;
		color: hsl(var(--theme-text) / 0.25);
		transition: color 0.2s ease;
		cursor: pointer;
	}

	.toc-dot-link:hover {
		color: hsl(var(--theme-text) / 0.55);
	}

	/* Read state: sections above current */
	.toc-dot-link.read {
		color: hsl(var(--theme-text) / 0.35);
	}

	/* Active state: current section */
	.toc-dot-link.active {
		color: hsl(var(--theme-text) / 0.85);
	}

	.toc-dot {
		flex-shrink: 0;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: hsl(var(--theme-bg) / 1);
		border: 1.5px solid hsl(var(--theme-text) / 0.18);
		position: relative;
		z-index: 1;
		transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
	}

	/* Read dots: small filled, muted */
	.toc-dot-link.read .toc-dot {
		background: hsl(var(--theme-text) / 0.25);
		border-color: hsl(var(--theme-text) / 0.25);
		transform: scale(0.7);
	}

	/* Active dot: filled accent, larger */
	.toc-dot-link.active .toc-dot {
		background: hsl(var(--theme-accent) / 1);
		border-color: hsl(var(--theme-accent) / 1);
		transform: scale(1.1);
		box-shadow: 0 0 0 3px hsl(var(--theme-accent) / 0.15);
	}

	/* Hover unread dots */
	.toc-dot-link:hover .toc-dot {
		border-color: hsl(var(--theme-text) / 0.35);
	}

	.toc-label {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.15s ease, transform 0.15s ease;
	}

	.toc-dot-link.active .toc-label {
		opacity: 1;
		transform: translateX(0);
		color: hsl(var(--theme-accent) / 1);
		font-weight: 600;
	}

	.toc-sidebar:hover .toc-label {
		opacity: 1;
		transform: translateX(0);
	}

	/* ===== Right sidenote gutter ===== */
	.sidenote-gutter {
		display: none;
	}

	@media (min-width: 1280px) {
		.sidenote-gutter {
			display: block;
			grid-column: 3;
			grid-row: 1;
		}
	}

	/* ===== Mobile TOC toggle button ===== */
	.mobile-toc-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		position: fixed;
		bottom: 1.25rem;
		left: 1.25rem;
		z-index: 40;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		border: 1px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-bg) / 0.92);
		color: hsl(var(--theme-text) / 0.6);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 2px 12px hsl(0 0% 0% / 0.1);
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}

	.mobile-toc-toggle:hover {
		transform: scale(1.06);
		box-shadow: 0 4px 16px hsl(0 0% 0% / 0.16);
	}

	@media (min-width: 1280px) {
		.mobile-toc-toggle {
			display: none;
		}
	}

	/* ===== Mobile TOC backdrop ===== */
	.mobile-toc-backdrop {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 49;
		background: hsl(0 0% 0% / 0.35);
	}

	.mobile-toc-backdrop.open {
		display: block;
		animation: fadeIn 0.2s ease forwards;
	}

	/* ===== Mobile TOC drawer (bottom sheet) ===== */
	.mobile-toc-drawer {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 50;
		max-height: 65vh;
		background: hsl(var(--theme-bg) / 0.98);
		border-top: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 14px 14px 0 0;
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 -4px 24px hsl(0 0% 0% / 0.12);
		transform: translateY(100%);
		transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
		overflow-y: auto;
		overscroll-behavior: contain;
	}

	.mobile-toc-drawer.open {
		transform: translateY(0);
	}

	@media (min-width: 1280px) {
		.mobile-toc-drawer,
		.mobile-toc-backdrop {
			display: none !important;
		}
	}

	.mobile-toc-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 20px 6px;
		position: sticky;
		top: 0;
		background: hsl(var(--theme-bg) / 0.98);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.mobile-toc-title {
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: hsl(var(--theme-text) / 0.4);
	}

	.mobile-toc-close {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		border: none;
		background: hsl(var(--theme-text) / 0.06);
		color: hsl(var(--theme-text) / 0.45);
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.mobile-toc-close:hover {
		background: hsl(var(--theme-text) / 0.12);
	}

	.mobile-toc-list {
		list-style: none;
		padding: 4px 12px 28px;
		margin: 0;
	}

	.mobile-toc-link {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 10px 10px;
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.88rem;
		color: hsl(var(--theme-text) / 0.55);
		transition: background 0.15s ease, color 0.15s ease;
	}

	.mobile-toc-link:hover {
		background: hsl(var(--theme-text) / 0.04);
	}

	.mobile-toc-link.active {
		color: hsl(var(--theme-accent) / 1);
		background: hsl(var(--theme-accent) / 0.07);
	}

	.mobile-toc-number {
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.25);
		min-width: 1.5em;
	}

	.mobile-toc-link.active .mobile-toc-number {
		color: hsl(var(--theme-accent) / 0.55);
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}
</style>

<script define:vars={{ sectionIds: sections.map(s => s.id) }}>
	document.addEventListener('DOMContentLoaded', () => {
		// --- Scroll-tracking via IntersectionObserver ---
		const tocLinks = document.querySelectorAll('.toc-dot-link');
		const mobileLinks = document.querySelectorAll('.mobile-toc-link');
		let activeId = null;

		function setActive(id) {
			if (id === activeId) return;
			activeId = id;

			const activeIdx = sectionIds.indexOf(id);

			tocLinks.forEach((link, i) => {
				const sectionId = link.dataset.section;
				const idx = sectionIds.indexOf(sectionId);
				link.classList.remove('active', 'read');
				if (sectionId === id) {
					link.classList.add('active');
				} else if (activeIdx >= 0 && idx < activeIdx) {
					link.classList.add('read');
				}
			});

			mobileLinks.forEach(link => {
				link.classList.toggle('active', link.dataset.section === id);
			});
		}

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter(e => e.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

				if (visible.length > 0) {
					setActive(visible[0].target.id);
				}
			},
			{
				rootMargin: '-10% 0px -60% 0px',
				threshold: 0,
			}
		);

		sectionIds.forEach(id => {
			const el = document.getElementById(id);
			if (el) observer.observe(el);
		});

		// --- Smooth scroll on TOC click ---
		function handleTocClick(e) {
			const link = e.currentTarget;
			const href = link.getAttribute('href');
			const targetId = href ? href.slice(1) : null;
			if (!targetId) return;

			e.preventDefault();
			const target = document.getElementById(targetId);
			if (target) {
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			closeMobileDrawer();
		}

		tocLinks.forEach(link => link.addEventListener('click', handleTocClick));
		mobileLinks.forEach(link => link.addEventListener('click', handleTocClick));

		// --- Mobile drawer ---
		const toggle = document.getElementById('mobile-toc-toggle');
		const drawer = document.getElementById('mobile-toc-drawer');
		const backdrop = document.getElementById('mobile-toc-backdrop');
		const closeBtn = document.getElementById('mobile-toc-close');

		function openMobileDrawer() {
			if (!drawer || !backdrop || !toggle) return;
			drawer.classList.add('open');
			backdrop.classList.add('open');
			toggle.setAttribute('aria-expanded', 'true');
			drawer.setAttribute('aria-hidden', 'false');
		}

		function closeMobileDrawer() {
			if (!drawer || !backdrop || !toggle) return;
			drawer.classList.remove('open');
			backdrop.classList.remove('open');
			toggle.setAttribute('aria-expanded', 'false');
			drawer.setAttribute('aria-hidden', 'true');
		}

		toggle?.addEventListener('click', () => {
			const isOpen = drawer?.classList.contains('open');
			isOpen ? closeMobileDrawer() : openMobileDrawer();
		});

		closeBtn?.addEventListener('click', closeMobileDrawer);
		backdrop?.addEventListener('click', closeMobileDrawer);
	});
</script>
