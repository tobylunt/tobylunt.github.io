			// Let's show it as the same grid with dimension labels swapped

			var tMatrix = el('div', 'hw-kproj-transposed-matrix');
			tMatrix.style.gridTemplateColumns = 'repeat(' + tokens.length + ', 1fr)';

			// Transpose the values: kValues[r][c] -> row r of K^T picks across original columns
			// K^T[i][j] = K[j][i], but our display is 3 rows x 8 cols for both
			// For visual clarity, show the same values rearranged
			// Actually the key insight: K is (T=8 x d_head=3+) displayed as 3 visible rows x 8 cols
			// K^T is (d_head=3+ x T=8) — same display grid, different meaning
			// Just show the transposed values
			kValues.forEach(function(row) {
				row.forEach(function(val) {
					tMatrix.appendChild(el('div', 'hw-kproj-transposed-cell', val));
				});
