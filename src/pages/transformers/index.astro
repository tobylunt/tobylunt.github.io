	document.addEventListener('DOMContentLoaded', () => {
		// ===== Feature #10: Attention pattern heatmap =====
		const tokens = ['The', 'big', 'cat', 'sat', 'quietly'];
		// Realistic attention weights (each row sums to 1.0)
		// Row = query token, Col = key token
		// Patterns: adj→noun ("big"→"cat"), adv→verb ("quietly"→"sat"), verb→subject ("sat"→"cat")
		const attnWeights = [
			[0.38, 0.08, 0.32, 0.14, 0.08],  // "The": self + determiner→noun
			[0.07, 0.18, 0.53, 0.14, 0.08],  // "big": adjective→noun (cat)
			[0.12, 0.24, 0.30, 0.24, 0.10],  // "cat": balanced, self + neighbors
			[0.06, 0.10, 0.44, 0.25, 0.15],  // "sat": verb→subject (cat)
			[0.04, 0.06, 0.13, 0.55, 0.22],  // "quietly": adverb→verb (sat)
		];

		const gridEl = document.getElementById('heatmap-grid');
		const tooltipEl = document.getElementById('heatmap-tooltip');
		if (!gridEl || !tooltipEl) return;

		// Detect Astro scoping attribute for dynamic elements
		var hmAstroAttr = null;
		Array.from(gridEl.attributes).forEach(function(attr) {
			if (attr.name.indexOf('data-astro-cid-') === 0) hmAstroAttr = attr.name;
		});
		function hmEl(tag, cls) {
			var e = document.createElement(tag);
			if (cls) e.className = cls;
			if (hmAstroAttr) e.setAttribute(hmAstroAttr, '');
			return e;
		}

		const allCells = [];
		const allRowLabels = [];
		const allColLabels = [];

		// Row 0: blank corner + column labels
		const corner = hmEl('div', 'attn-heatmap-corner');
		gridEl.appendChild(corner);

		tokens.forEach((tok) => {
			const label = hmEl('div', 'attn-heatmap-col-label');
			label.textContent = tok;
			gridEl.appendChild(label);
			allColLabels.push(label);
		});

		// Data rows
		for (let ri = 0; ri < tokens.length; ri++) {
			const rowLabel = hmEl('div', 'attn-heatmap-row-label');
			rowLabel.dataset.row = ri;
			rowLabel.textContent = tokens[ri];
			if (ri % 2 === 1) rowLabel.classList.add('attn-heatmap-row-alt');
			gridEl.appendChild(rowLabel);
			allRowLabels.push(rowLabel);

			for (let ci = 0; ci < tokens.length; ci++) {
				const weight = attnWeights[ri][ci];
				const cell = hmEl('div', 'attn-heatmap-cell');
				if (ri % 2 === 1) cell.classList.add('attn-heatmap-row-alt');
				cell.textContent = weight.toFixed(2);
				cell.dataset.row = ri;
				cell.dataset.col = ci;

				// Amber color with opacity proportional to weight
				const alpha = 0.08 + weight * 0.85;
				cell.style.background = 'hsl(35 90% 55% / ' + alpha.toFixed(2) + ')';

				// Text color: dark on strong, light on weak
				if (weight > 0.35) {
					cell.style.color = 'hsl(35 20% 15%)';
				} else {
					cell.style.color = 'hsl(var(--theme-text) / 0.7)';
				}

				// Row hover: highlight full row on enter, clear on leave
				cell.addEventListener('mouseenter', () => highlightRow(ri));
				cell.addEventListener('mouseleave', clearHighlight);

				gridEl.appendChild(cell);
				allCells.push(cell);
			}
		}

		function highlightRow(row) {
			allRowLabels.forEach((label, i) => {
				label.classList.toggle('highlight', i === row);
				label.classList.toggle('dimmed', i !== row);
			});
			allColLabels.forEach((label) => {
				label.classList.remove('highlight', 'dimmed');
			});

			allCells.forEach((c) => {
				const cr = parseInt(c.dataset.row);
				c.classList.toggle('dimmed', cr !== row);
				c.classList.toggle('row-active', cr === row);
			});

			// Show row summary in tooltip
			const maxIdx = attnWeights[row].indexOf(Math.max(...attnWeights[row]));
			tooltipEl.textContent = '\u201c' + tokens[row] + '\u201d attends most to \u201c' + tokens[maxIdx] + '\u201d (' + attnWeights[row][maxIdx].toFixed(2) + ')';
			tooltipEl.classList.add('visible');
		}

		function clearHighlight() {
			allRowLabels.forEach((label) => {
				label.classList.remove('highlight', 'dimmed');
			});
			allColLabels.forEach((label) => {
				label.classList.remove('highlight', 'dimmed');
			});
			allCells.forEach((c) => {
				c.classList.remove('dimmed', 'row-active');
			});
			tooltipEl.classList.remove('visible');
		}

		document.addEventListener('click', clearHighlight);
	});
</script>

<script is:inline>
	// Multi-head heatmaps (lazy-init: Feature #22)
	document.addEventListener('DOMContentLoaded', () => {
		var _lazyEl = document.getElementById('mha-heatmap-1');
		if (!_lazyEl) return;
		function _lazyInit() {
