				wText.setAttribute('font-size', '15');
				wText.setAttribute('fill', m.color);
				wText.setAttribute('font-weight', '600');
				wText.setAttribute('font-family', 'Georgia, serif');
				wText.innerHTML = `W<tspan baseline-shift="sub" font-size="11">${m.sub}</tspan>`;
				nodeLayer.appendChild(wText);
			});

			// Draw output placeholders (3 outputs per token = 9 boxes arranged in grid)
			const projections = [
				{ label: 'Q', color: COL_Q },
				{ label: 'K', color: COL_K },
				{ label: 'V', color: COL_V },
			];

			tokens.forEach((tok, ti) => {
				projections.forEach((p, pi) => {
					const ox = OUTPUT_X + pi * (VEC_W + 12);
					const oy = ROW_Y[ti];
					addRect(nodeLayer, ox, oy - VEC_H / 2, VEC_W, VEC_H, {
						fill: 'transparent',
						stroke: COL_DIM,
						sw: 1,
						dash: '3 3',
						opacity: '0.3',
						cls: `qkv-output-box qkv-out-${ti}-${pi}`
					});
				});
			});

			// Output column sub-labels
			projections.forEach((p, pi) => {
				const ox = OUTPUT_X + pi * (VEC_W + 12);
				addText(nodeLayer, ox + VEC_W / 2, 50, p.label, {
					size: '13', fill: p.color, weight: '700', family: 'Georgia, serif'
				});
			});
		}

		function renderStep4() {
			var layout = el('div', 'hw-pos-layout');

			// Token chips row at the top
			var chipsRow = el('div', 'hw-pos-chips');
			var tokens = ['The', 'fat', 'cat', 'sat', 'quiet', 'ly', 'on', 'the'];
			var tokenTypes = ['whole', 'whole', 'whole', 'whole', 'sub', 'sub', 'whole', 'whole'];

			tokens.forEach(function(tok, i) {
				var chip = el('span', 'hw-tok-chip hw-tok-' + tokenTypes[i] + ' hw-pos-chip', tok);
				chipsRow.appendChild(chip);
