		border: 1.5px dashed hsl(var(--theme-text) / 0.2);
	}
	.res-pn-norm .res-pn-label { color: hsl(var(--theme-text) / 0.6); }

	.res-pn-attn {
		background: hsl(35 90% 55% / 0.1);
		border: 1.5px solid hsl(35 90% 55% / 0.3);
	}
	.res-pn-attn .res-pn-label { color: hsl(35 90% 55%); }

	.res-pn-ffn {
		background: hsl(150 55% 45% / 0.1);
		border: 1.5px solid hsl(150 55% 45% / 0.3);
	}
	.res-pn-ffn .res-pn-label { color: hsl(150 55% 45%); }

	.res-pn-add {
		background: hsl(270 50% 58% / 0.06);
		border: 1.5px solid hsl(270 50% 58% / 0.2);
	}
	.res-pn-add .res-pn-label { color: hsl(270 50% 58%); font-family: Georgia, serif; }

	.res-prenorm-arrow {
		font-size: 0.9rem;
		color: hsl(var(--theme-text) / 0.2);
		padding: 0 4px;
	}

	.res-prenorm-caption {
		text-align: center;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.4);
		margin-top: 1rem;
		font-style: italic;
		line-height: 1.5;
	}

	@media (max-width: 480px) {
		.res-highway-stream {
			flex-direction: column;
			gap: 4px;
		}
		.res-stream-junction {
			flex-direction: row;
			gap: 8px;
		}
		.res-junction-branch {
			flex-direction: row;
		}
		.ln-columns {
			flex-direction: column;
			align-items: center;
		}
		.ln-arrow {
			transform: rotate(90deg);
		}
		.res-prenorm-flow {
			gap: 4px;
		}
		.res-prenorm-step {
			padding: 6px 8px;
			min-width: 36px;
		}
		.res-pn-label {
			font-size: 0.62rem;
		}
	}

	/* ===== Section 08: Output ===== */

	.linkage-output {
		background: hsl(350 65% 55% / 0.06);
		border-color: hsl(350 65% 55% / 0.2);
	}
	.linkage-output .linkage-icon {
		color: hsl(350 65% 55%);
	}

	/* Embedding ↔ Unembedding symmetry diagram */
	.out-symmetry-diagram {
		margin: 2rem 0;
		padding: 1.5rem;
		border-radius: 12px;
		border: 1px solid hsl(var(--theme-text) / 0.08);
		background: hsl(var(--theme-bg) / 0.5);
	}
	.out-symmetry-title {
		text-align: center;
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.7);
		margin-bottom: 1.2rem;
	}
	.out-symmetry-flow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1rem;
	}
	.out-sym-col {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		flex: 1;
		max-width: 280px;
	}
	.out-sym-box {
		padding: 1rem;
		border-radius: 10px;
		text-align: center;
		width: 100%;
	}
	.out-sym-embed {
		background: hsl(210 70% 55% / 0.08);
		border: 1.5px solid hsl(210 70% 55% / 0.3);
	}
	.out-sym-unembed {
		background: hsl(350 65% 55% / 0.08);
		border: 1.5px solid hsl(350 65% 55% / 0.3);
	}
	.out-sym-label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		margin-bottom: 0.25rem;
	}
	.out-sym-embed .out-sym-label { color: hsl(210 70% 55%); }
	.out-sym-unembed .out-sym-label { color: hsl(350 65% 55%); }
	.out-sym-desc {
		font-size: 0.9rem;
		font-weight: 700;
		color: hsl(var(--theme-text) / 0.8);
		margin-bottom: 0.25rem;
	}
	.out-sym-shape {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}
	.out-sym-example {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.8rem;
	}
	.out-sym-arrow {
		color: hsl(var(--theme-text) / 0.3);
	}
	.out-sym-vec {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.5);
	}
	.out-sym-logits {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.72rem;
		color: hsl(350 65% 55%);
		font-weight: 600;
	}
	.out-sym-mirror {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 0 0.5rem;
	}
	.out-sym-mirror-line {
		width: 1px;
		height: 30px;
		background: hsl(var(--theme-text) / 0.12);
	}
	.out-sym-mirror-label {
		font-size: 1.2rem;
		color: hsl(var(--theme-text) / 0.25);
	}
	.out-symmetry-caption {
		text-align: center;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.4);
		margin-top: 1rem;
		font-style: italic;
		line-height: 1.5;
	}

	/* Output prediction widget */
	.out-prediction-widget {
		margin: 2rem 0;
		padding: 1.5rem;
		border-radius: 12px;
		border: 1px solid hsl(350 65% 55% / 0.15);
		background: hsl(350 65% 55% / 0.03);
	}
	.out-prediction-title {
		text-align: center;
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.7);
		margin-bottom: 1.2rem;
	}
	.out-prediction-context {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-bottom: 1.5rem;
	}
	.out-context-label {
		font-size: 0.8rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
	}
	.out-context-tokens {
		display: flex;
		gap: 4px;
		flex-wrap: wrap;
	}
	.out-context-predict {
		font-weight: 700;
		color: hsl(350 65% 55%);
		font-size: 1rem;
		padding: 4px 12px;
		border-radius: 6px;
		border: 2px dashed hsl(350 65% 55% / 0.4);
		background: hsl(350 65% 55% / 0.06);
	}

	/* Pipeline steps */
	.out-pipeline-steps {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0;
		margin-bottom: 1.5rem;
	}
	.out-pipeline-step {
		text-align: center;
	}
	.out-pipe-label {
		font-size: 0.72rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		margin-bottom: 0.25rem;
	}
	.out-pipe-box {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.72rem;
		padding: 8px 16px;
		border-radius: 8px;
		display: inline-block;
	}
	.out-pipe-residual {
		background: hsl(270 50% 58% / 0.1);
		border: 1.5px solid hsl(270 50% 58% / 0.3);
		color: hsl(270 50% 58%);
	}
	.out-pipe-logits {
		background: hsl(var(--theme-text) / 0.04);
		border: 1.5px solid hsl(var(--theme-text) / 0.12);
		color: hsl(var(--theme-text) / 0.6);
	}
	.out-pipe-probs {
		background: hsl(350 65% 55% / 0.08);
		border: 1.5px solid hsl(350 65% 55% / 0.3);
		color: hsl(350 65% 55%);
		font-family: inherit;
		font-weight: 600;
	}
	.out-pipeline-arrow {
		font-size: 0.75rem;
		color: hsl(var(--theme-text) / 0.3);
		padding: 6px 0;
	}

	/* Temperature control */
	.out-temp-control {
		margin-bottom: 1.5rem;
		text-align: center;
	}
	.out-temp-label {
		font-size: 0.8rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.6);
		margin-bottom: 0.5rem;
	}
	.out-temp-slider {
		width: 100%;
		max-width: 400px;
		margin: 0 auto;
		display: block;
		accent-color: hsl(350 65% 55%);
	}
	.out-temp-range {
		display: flex;
		justify-content: space-between;
		max-width: 400px;
		margin: 0.25rem auto 0;
		font-size: 0.65rem;
		color: hsl(var(--theme-text) / 0.3);
	}

	/* Top-k predictions */
	.out-topk-container {
		margin-top: 0.5rem;
	}
	.out-topk-title {
		font-size: 0.8rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.6);
		margin-bottom: 0.75rem;
		text-align: center;
	}
	.out-topk-bars {
		display: flex;
		flex-direction: column;
		gap: 8px;
		max-width: 500px;
		margin: 0 auto;
	}
	.out-topk-row {
		display: flex;
		align-items: center;
		gap: 8px;
	}
	.out-topk-token {
		font-size: 0.8rem;
		font-weight: 600;
		width: 60px;
		text-align: right;
		color: hsl(var(--theme-text) / 0.7);
	}
	.out-topk-bar-track {
		flex: 1;
		height: 28px;
		background: hsl(var(--theme-text) / 0.04);
		border-radius: 6px;
		overflow: hidden;
		position: relative;
	}
	.out-topk-bar-fill {
		height: 100%;
		border-radius: 6px;
		background: hsl(350 65% 55%);
		transition: width 0.4s ease;
		min-width: 2px;
	}
	.out-topk-prob {
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.72rem;
		width: 52px;
		color: hsl(var(--theme-text) / 0.5);
	}
	.out-topk-rest {
		text-align: center;
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.3);
		margin-top: 0.5rem;
		font-style: italic;
	}

	@media (max-width: 480px) {
		.out-symmetry-flow {
			flex-direction: column;
			gap: 0.5rem;
		}
		.out-sym-mirror {
			flex-direction: row;
			padding: 0;
		}
		.out-sym-mirror-line {
			width: 30px;
			height: 1px;
		}
		.out-sym-col {
			max-width: 100%;
		}
		.out-sym-example {
			font-size: 0.72rem;
		}
		.out-topk-token {
			width: 48px;
			font-size: 0.72rem;
		}
		.out-topk-prob {
			width: 44px;
			font-size: 0.65rem;
		}
	}

	/* ===== Section 08b: Walkthrough ===== */
	.wt-section {
		padding-top: 1rem;
	}

	.wt-walkthrough {
		margin-top: 1.5rem;
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		background: hsl(var(--theme-text) / 0.015);
		overflow: hidden;
	}

	.wt-controls {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 12px 16px;
		border-bottom: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.02);
		flex-wrap: wrap;
	}

	.wt-ctrl-btn {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		padding: 5px 12px;
		border-radius: 6px;
		border: 1px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-text) / 0.03);
		color: hsl(var(--theme-text) / 0.65);
		font-size: 0.75rem;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}
	.wt-ctrl-btn:hover:not(:disabled) {
		background: hsl(var(--theme-accent) / 0.08);
		color: hsl(var(--theme-accent));
	}
	.wt-ctrl-btn:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.wt-ctrl-play.playing {
		color: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent) / 0.3);
		background: hsl(var(--theme-accent) / 0.06);
	}

	.wt-step-counter {
		margin-left: auto;
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	/* Pipeline + Annotation body */
	.wt-body {
		display: grid;
		grid-template-columns: 260px 1fr;
		gap: 0;
		min-height: 440px;
	}

	/* Vertical pipeline */
	.wt-pipeline {
		padding: 20px 16px 20px 20px;
		border-right: 1px solid hsl(var(--theme-text) / 0.06);
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	.wt-stage {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 6px 10px;
		border-radius: 6px;
		border: 1.5px solid transparent;
		transition: all 0.35s ease;
		cursor: pointer;
		position: relative;
	}
	.wt-stage:hover {
		background: hsl(var(--theme-text) / 0.03);
	}

	.wt-stage-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: hsl(var(--theme-text) / 0.15);
		flex-shrink: 0;
		transition: all 0.35s ease;
	}

	.wt-stage-label {
		font-size: 0.78rem;
		font-weight: 500;
		color: hsl(var(--theme-text) / 0.6);
		transition: color 0.35s ease;
	}

	.wt-stage-ref {
		margin-left: auto;
		font-size: 0.65rem;
		color: hsl(var(--theme-text) / 0.25);
		font-family: 'SF Mono', 'Fira Code', monospace;
	}

	.wt-connector {
		width: 2px;
		height: 10px;
		background: hsl(var(--theme-text) / 0.08);
		margin-left: 23px;
		flex-shrink: 0;
	}

	/* Layer bracket */
	.wt-layer-bracket {
		border: 1px dashed hsl(var(--theme-text) / 0.1);
		border-radius: 8px;
		padding: 8px 6px;
		position: relative;
	}
	.wt-bracket-label {
		position: absolute;
		top: -9px;
		right: 10px;
		background: hsl(var(--theme-bg));
		padding: 0 6px;
		font-size: 0.65rem;
		color: hsl(var(--theme-text) / 0.35);
		font-family: 'SF Mono', 'Fira Code', monospace;
	}
	.wt-layer-inner {
		display: flex;
		flex-direction: column;
		align-items: stretch;
	}

	/* Color-coded stage active states */
	.wt-stage.active.wt-embed {
		background: hsl(210 70% 55% / 0.1);
		border-color: hsl(210 70% 55% / 0.35);
	}
	.wt-stage.active.wt-embed .wt-stage-dot { background: hsl(210 70% 55%); box-shadow: 0 0 6px hsl(210 70% 55% / 0.5); }
	.wt-stage.active.wt-embed .wt-stage-label { color: hsl(210 70% 55%); font-weight: 600; }

	.wt-stage.active.wt-attn {
		background: hsl(35 90% 55% / 0.1);
		border-color: hsl(35 90% 55% / 0.35);
	}
	.wt-stage.active.wt-attn .wt-stage-dot { background: hsl(35 90% 55%); box-shadow: 0 0 6px hsl(35 90% 55% / 0.5); }
	.wt-stage.active.wt-attn .wt-stage-label { color: hsl(35 90% 55%); font-weight: 600; }

	.wt-stage.active.wt-ffn {
		background: hsl(150 55% 45% / 0.1);
		border-color: hsl(150 55% 45% / 0.35);
	}
	.wt-stage.active.wt-ffn .wt-stage-dot { background: hsl(150 55% 45%); box-shadow: 0 0 6px hsl(150 55% 45% / 0.5); }
	.wt-stage.active.wt-ffn .wt-stage-label { color: hsl(150 55% 45%); font-weight: 600; }

	.wt-stage.active.wt-residual {
		background: hsl(270 50% 58% / 0.1);
		border-color: hsl(270 50% 58% / 0.35);
	}
	.wt-stage.active.wt-residual .wt-stage-dot { background: hsl(270 50% 58%); box-shadow: 0 0 6px hsl(270 50% 58% / 0.5); }
	.wt-stage.active.wt-residual .wt-stage-label { color: hsl(270 50% 58%); font-weight: 600; }

	.wt-stage.active.wt-norm {
		background: hsl(var(--theme-text) / 0.06);
		border-color: hsl(var(--theme-text) / 0.2);
	}
	.wt-stage.active.wt-norm .wt-stage-dot { background: hsl(var(--theme-text) / 0.55); box-shadow: 0 0 6px hsl(var(--theme-text) / 0.25); }
	.wt-stage.active.wt-norm .wt-stage-label { color: hsl(var(--theme-text) / 0.85); font-weight: 600; }

	.wt-stage.active.wt-output {
		background: hsl(350 65% 55% / 0.1);
		border-color: hsl(350 65% 55% / 0.35);
	}
	.wt-stage.active.wt-output .wt-stage-dot { background: hsl(350 65% 55%); box-shadow: 0 0 6px hsl(350 65% 55% / 0.5); }
	.wt-stage.active.wt-output .wt-stage-label { color: hsl(350 65% 55%); font-weight: 600; }

	/* Visited (past) stages get a subtle tint */
	.wt-stage.visited .wt-stage-dot { background: hsl(var(--theme-text) / 0.3); }
	.wt-stage.visited .wt-stage-label { color: hsl(var(--theme-text) / 0.5); }

	/* Annotation panel */
	.wt-annotation {
		padding: 24px 24px;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.wt-ann-title {
		font-size: 1rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.85);
		margin-bottom: 8px;
		transition: color 0.3s ease;
	}
	.wt-ann-text {
		font-size: 0.85rem;
		line-height: 1.6;
		color: hsl(var(--theme-text) / 0.6);
		transition: opacity 0.3s ease;
	}
	.wt-ann-text strong {
		color: hsl(var(--theme-text) / 0.8);
	}
	.wt-ann-token {
		margin-top: 14px;
		padding: 10px 14px;
		border-radius: 8px;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.06);
		font-family: 'SF Mono', 'Fira Code', monospace;
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.55);
		line-height: 1.5;
		min-height: 40px;
		transition: opacity 0.3s ease;
	}
	.wt-ann-token:empty { display: none; }

	/* Mobile: stack vertically */
	@media (max-width: 640px) {
		.wt-body {
			grid-template-columns: 1fr;
		}
		.wt-pipeline {
			border-right: none;
			border-bottom: 1px solid hsl(var(--theme-text) / 0.06);
			padding: 16px 12px;
		}
		.wt-annotation {
			padding: 16px;
			min-height: 150px;
		}
	}

	/* ===== Section 09: Circuits ===== */
	.linkage-circuits {
		background: hsl(35 90% 55% / 0.06);
		border-color: hsl(35 90% 55% / 0.2);
	}
	.linkage-circuits .linkage-icon { color: hsl(35 90% 55%); }

	/* Induction head circuit diagram */
	.circ-induction-wrap {
		margin: 1.5rem 0 2rem;
		padding: 24px;
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		background: hsl(var(--theme-text) / 0.015);
	}
	.circ-induction-title {
		font-size: 0.9rem;
		font-weight: 600;
		text-align: center;
		color: hsl(var(--theme-text) / 0.8);
		margin-bottom: 4px;
	}
	.circ-induction-subtitle {
		font-size: 0.75rem;
		text-align: center;
		color: hsl(var(--theme-text) / 0.45);
		margin-bottom: 20px;
	}

	/* Token sequence */
	.circ-sequence {
		display: flex;
		align-items: center;
		gap: 10px;
		justify-content: center;
		margin-bottom: 20px;
	}
	.circ-seq-label {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.4);
	}
	.circ-tokens {
		display: flex;
		gap: 4px;
	}
	.circ-tok {
		padding: 4px 10px;
		border-radius: 4px;
		font-size: 0.8rem;
		font-weight: 500;
		font-family: 'SF Mono', 'Fira Code', monospace;
		background: hsl(var(--theme-text) / 0.04);
		color: hsl(var(--theme-text) / 0.45);
		border: 1px solid hsl(var(--theme-text) / 0.06);
	}
	.circ-tok-a {
		background: hsl(210 70% 55% / 0.1);
		color: hsl(210 70% 55%);
		border-color: hsl(210 70% 55% / 0.25);
		font-weight: 700;
	}
	.circ-tok-b {
		background: hsl(35 90% 55% / 0.1);
