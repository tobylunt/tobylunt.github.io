	</div>
</PageLayout>

<style>
	/* ===== Break out of Base layout's max-w-3xl body constraint ===== */
	.hero {
		width: 100vw;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
	}

	.transformers-layout {
		display: grid;
		grid-template-columns: 1fr;
		/* Break out of body max-width */
		width: 100vw;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		padding: 0 1rem;
	}

	@media (min-width: 1280px) {
		.transformers-layout {
			grid-template-columns: 180px minmax(0, 1fr) 200px;
			gap: 0 2rem;
			padding: 0 3rem;
		}
	}

	@media (min-width: 1536px) {
		.transformers-layout {
