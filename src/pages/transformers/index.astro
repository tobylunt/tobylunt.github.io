			// Helper: create a flying column copy from srcCol toward W_Q
			function flyCol(srcCol, dur) {
				var lRect = layout.getBoundingClientRect();
				var sRect = srcCol.getBoundingClientRect();
				var wRect = wqCols.getBoundingClientRect();

				var fly = srcCol.cloneNode(true);
				fly.classList.add('hw-q8-fly-col');
				fly.style.position = 'absolute';
				fly.style.left = (sRect.left - lRect.left) + 'px';
				fly.style.top = (sRect.top - lRect.top) + 'px';
				fly.style.width = sRect.width + 'px';
				fly.style.transition = 'transform ' + dur + 'ms ease-in-out, opacity ' + dur + 'ms ease';
				layout.appendChild(fly);

				var dx = (wRect.left + wRect.width / 2 - sRect.width / 2) - sRect.left;
				requestAnimationFrame(function() {
					requestAnimationFrame(function() {
						fly.style.transform = 'translateX(' + dx + 'px) scale(0.8)';
						fly.style.opacity = '0.2';
					});
				});

				setTimeout(function() {
					if (fly.parentNode) fly.remove();
				}, dur + 80);
			}

