		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.attn-pipe-qkv {
		background: hsl(var(--theme-text) / 0.05);
		border: 1px solid hsl(var(--theme-text) / 0.15);
		color: hsl(var(--theme-text) / 0.8);
	}

	.attn-pipe-qkv .qkv-q-text { color: hsl(210 70% 55%); }
	.attn-pipe-qkv .qkv-k-text { color: hsl(25 85% 55%); }
	.attn-pipe-qkv .qkv-v-text { color: hsl(150 55% 45%); }

	.attn-pipe-dot {
		background: hsl(210 70% 55% / 0.12);
		color: hsl(210 70% 55%);
		border: 1px solid hsl(210 70% 55% / 0.25);
	}

	.attn-pipe-softmax {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.attn-pipe-wv {
		background: hsl(150 55% 45% / 0.12);
		color: hsl(150 55% 45%);
		border: 1px solid hsl(150 55% 45% / 0.25);
	}

	.attn-pipe-output {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.attn-pipeline-labels {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		margin-top: 0.4rem;
	}

	.attn-pipeline-labels span {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.3);
		text-align: center;
		min-width: 3rem;
	}

	.attn-pipeline-labels span:empty {
		min-width: 1rem;
	}

	@media (max-width: 480px) {
		.val-output-container {
			padding: 1rem;
		}
		.val-step-row {
			font-size: 0.72rem;
			gap: 0.3rem;
		}
		.val-sum-divider {
			margin: 0.4rem 1rem;
		}
		.attn-pipeline-flow {
			gap: 0.2rem;
		}
		.attn-pipeline-box {
			padding: 0.35rem 0.5rem;
			font-size: 0.65rem;
		}
	}

	/* ===== Feature #12: Multi-Head Attention ===== */

	/* Parallel heads intro diagram */
	.mha-parallel-intro {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		text-align: center;
	}

	.mha-parallel-title {
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1.2rem;
	}

	.mha-parallel-diagram {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
	}

	.mha-single-head-box {
		padding: 0.8rem 1.2rem;
		border: 2px solid hsl(35 90% 55% / 0.3);
		border-radius: 8px;
		background: hsl(35 90% 55% / 0.06);
	}

	.mha-head-label {
		font-size: 0.72rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 0.4rem;
	}

	.mha-head-pipeline {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		justify-content: center;
	}

	.mha-mini-box {
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 600;
	}

	.mha-mini-qkv {
		background: hsl(var(--theme-text) / 0.05);
		border: 1px solid hsl(var(--theme-text) / 0.15);
		display: flex;
		gap: 0.2rem;
	}

	.mha-mini-attn {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.mha-mini-out {
		background: hsl(35 90% 55% / 0.12);
		color: hsl(35 90% 55%);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}

	.mha-mini-arrow {
		color: hsl(var(--theme-text) / 0.3);
		font-size: 0.8rem;
	}

	.mha-duplicate-arrow {
		font-size: 1rem;
		color: hsl(var(--theme-text) / 0.3);
		font-weight: 600;
	}

	.mha-multi-head-stack {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
		max-width: 360px;
	}

	.mha-head-slot {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		justify-content: center;
		padding: 0.5rem 0.8rem;
		border-radius: 8px;
		border: 1px solid hsl(35 90% 55% / 0.2);
		background: hsl(35 90% 55% / 0.04);
	}

	.mha-head-tag {
		font-size: 0.65rem;
		font-weight: 700;
		color: hsl(35 90% 55%);
		min-width: 3.5rem;
		text-align: right;
	}

	/* Head heatmap gallery */
	.mha-heads-gallery {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		margin: 2rem 0;
	}

	.mha-head-card {
		background: hsl(var(--theme-bg));
		border: 1px solid hsl(var(--theme-text) / 0.1);
		border-radius: 10px;
		padding: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.mha-head-card-title {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
	}

	.mha-head-number {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.72rem;
		font-weight: 700;
		color: hsl(35 90% 55%);
	}

	.mha-head-role {
		font-size: 0.75rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.6);
	}

	.mha-head-card-desc {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
		line-height: 1.4;
	}

	/* Mini heatmap grids (3x3, smaller than Feature #10) */
	.mha-heatmap-grid {
		display: grid;
		grid-template-columns: auto repeat(3, 1fr);
		grid-template-rows: auto repeat(3, 1fr);
		gap: 2px;
		align-items: center;
		justify-items: center;
		margin-top: auto;
	}

	.mha-heatmap-corner {
		font-size: 0.5rem;
		color: hsl(var(--theme-text) / 0.25);
		text-align: center;
		line-height: 1.2;
	}

	.mha-heatmap-col-label,
	.mha-heatmap-row-label {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.6rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		padding: 2px;
	}

	.mha-heatmap-cell {
		width: 100%;
		aspect-ratio: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		border-radius: 3px;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.58rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.7);
		cursor: default;
		transition: transform 0.15s ease;
		min-height: 36px;
	}

	.mha-heatmap-cell:hover {
		transform: scale(1.08);
	}

	@media (max-width: 768px) {
		.mha-heads-gallery {
			grid-template-columns: 1fr;
			max-width: 320px;
			margin-left: auto;
			margin-right: auto;
		}
	}

	@media (max-width: 480px) {
		.mha-parallel-intro {
			padding: 1rem;
		}
		.mha-head-card {
			padding: 0.8rem;
		}
	}

	/* ===== Feature #13: Concatenation & Projection ===== */

	.mha-formula {
		text-align: center;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.88rem;
		color: hsl(35 90% 55%);
		padding: 1rem;
		margin: 1.5rem 0;
		background: hsl(35 90% 55% / 0.06);
		border: 1px solid hsl(35 90% 55% / 0.15);
		border-radius: 8px;
	}

	/* Concat diagram */
	.mha-concat-diagram {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.8rem;
	}

	.mha-concat-title {
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.mha-concat-heads {
		display: flex;
		gap: 0.6rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.mha-concat-head-vec {
		padding: 0.6rem 0.8rem;
		border-radius: 8px;
		text-align: center;
		min-width: 120px;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.mha-concat-head-vec.mha-head-disabled {
		opacity: 0.2;
		transform: scale(0.95);
	}

	.mha-concat-h1 {
		background: hsl(200 60% 50% / 0.12);
		border: 1px solid hsl(200 60% 50% / 0.3);
	}
	.mha-concat-h2 {
		background: hsl(35 90% 55% / 0.12);
		border: 1px solid hsl(35 90% 55% / 0.3);
	}
	.mha-concat-h3 {
		background: hsl(280 50% 55% / 0.12);
		border: 1px solid hsl(280 50% 55% / 0.3);
	}

	.mha-concat-head-label {
		font-weight: 700;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.6);
		margin-bottom: 0.2rem;
	}

	.mha-concat-head-vals {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		color: hsl(var(--theme-text) / 0.5);
	}

	.mha-concat-head-dim {
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 0.2rem;
	}

	.mha-concat-arrow {
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.4);
		font-weight: 600;
	}

	/* Wide concatenated bar */
	.mha-concat-wide {
		text-align: center;
	}

	.mha-concat-wide-label {
		font-size: 0.72rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		margin-bottom: 0.3rem;
	}

	.mha-concat-wide-bar {
		display: flex;
		border-radius: 6px;
		overflow: hidden;
		max-width: 400px;
		margin: 0 auto;
	}

	.mha-concat-wide-seg {
		flex: 1;
		padding: 0.5rem 0.8rem;
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.7rem;
		font-weight: 700;
		text-align: center;
		transition: opacity 0.3s ease;
	}

	.mha-concat-wide-seg.mha-seg-disabled {
		opacity: 0.15;
	}

	.mha-seg-h1 {
		background: hsl(200 60% 50% / 0.25);
		color: hsl(200 60% 50%);
	}
	.mha-seg-h2 {
		background: hsl(35 90% 55% / 0.25);
		color: hsl(35 90% 55%);
	}
	.mha-seg-h3 {
		background: hsl(280 50% 55% / 0.25);
		color: hsl(280 50% 55%);
	}

	.mha-concat-wide-dim {
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 0.3rem;
	}

	/* Output vector */
	.mha-concat-output {
		text-align: center;
		padding: 0.7rem 1.2rem;
		background: hsl(35 90% 55% / 0.1);
		border: 2px solid hsl(35 90% 55% / 0.3);
		border-radius: 8px;
		transition: all 0.3s ease;
	}

	.mha-concat-output-label {
		font-weight: 700;
		font-size: 0.75rem;
		color: hsl(35 90% 55%);
		margin-bottom: 0.15rem;
	}

	.mha-concat-output-vals {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.6);
		transition: color 0.3s ease;
	}

	.mha-concat-output-dim {
		font-size: 0.6rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-top: 0.15rem;
	}

	/* Toggle buttons */
	.mha-toggle-container {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(var(--theme-bg));
		border: 1px solid hsl(var(--theme-text) / 0.1);
		border-radius: 12px;
	}

	.mha-toggle-title {
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.7);
		margin-bottom: 0.3rem;
	}

	.mha-toggle-desc {
		font-size: 0.75rem;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 1rem;
	}

	.mha-toggle-buttons {
		display: flex;
		gap: 0.6rem;
		justify-content: center;
		flex-wrap: wrap;
		margin-bottom: 1rem;
	}

	.mha-toggle-btn {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.5rem 0.9rem;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.15);
		background: hsl(var(--theme-text) / 0.04);
		color: hsl(var(--theme-text) / 0.4);
		font-size: 0.78rem;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.mha-toggle-btn.mha-toggle-active {
		border-color: hsl(35 90% 55% / 0.4);
		background: hsl(35 90% 55% / 0.1);
		color: hsl(var(--theme-text) / 0.8);
	}

	.mha-toggle-indicator {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: hsl(var(--theme-text) / 0.15);
		transition: background 0.2s ease;
	}

	.mha-toggle-active .mha-toggle-indicator {
		background: hsl(35 90% 55%);
	}

	.mha-toggle-role {
		font-size: 0.65rem;
		color: hsl(var(--theme-text) / 0.35);
		font-weight: 400;
	}

	.mha-toggle-result {
		text-align: center;
		padding: 0.8rem;
		background: hsl(var(--theme-text) / 0.03);
		border-radius: 8px;
	}

	.mha-toggle-result-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.5);
		margin-bottom: 0.3rem;
	}

	.mha-toggle-result-vec {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.78rem;
		color: hsl(35 90% 55%);
		font-weight: 600;
		margin-bottom: 0.3rem;
		transition: color 0.3s ease;
	}

	.mha-toggle-result-note {
		font-size: 0.7rem;
		color: hsl(var(--theme-text) / 0.4);
		font-style: italic;
		transition: color 0.3s ease;
	}

	/* Residual stream handoff */
	.mha-residual-handoff {
		margin: 2rem 0;
		padding: 1.5rem;
		background: hsl(270 50% 58% / 0.05);
		border: 1px solid hsl(270 50% 58% / 0.15);
		border-radius: 12px;
	}

	.mha-residual-title {
		text-align: center;
		font-weight: 600;
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.5);
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
	}

	.mha-residual-flow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		flex-wrap: wrap;
	}

	.mha-residual-box {
		padding: 0.6rem 1rem;
		border-radius: 8px;
		text-align: center;
	}

	.mha-residual-box-label {
		font-size: 0.65rem;
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.mha-residual-box-val {
		font-family: 'IBM Plex Mono', ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 700;
	}

	.mha-residual-input {
		background: hsl(270 50% 58% / 0.1);
		border: 1px solid hsl(270 50% 58% / 0.25);
	}
	.mha-residual-input .mha-residual-box-label { color: hsl(270 50% 58%); }
	.mha-residual-input .mha-residual-box-val { color: hsl(270 50% 58%); }

	.mha-residual-attn {
		background: hsl(35 90% 55% / 0.1);
		border: 1px solid hsl(35 90% 55% / 0.25);
	}
	.mha-residual-attn .mha-residual-box-label { color: hsl(35 90% 55%); }
	.mha-residual-attn .mha-residual-box-val { color: hsl(35 90% 55%); }

	.mha-residual-result {
		background: hsl(270 50% 58% / 0.12);
		border: 2px solid hsl(270 50% 58% / 0.35);
	}
	.mha-residual-result .mha-residual-box-label { color: hsl(270 50% 58%); }
	.mha-residual-result .mha-residual-box-val { color: hsl(270 50% 58%); }

	.mha-residual-plus,
	.mha-residual-equals {
		font-size: 1.2rem;
		font-weight: 700;
		color: hsl(var(--theme-text) / 0.3);
	}

	.mha-residual-caption {
		text-align: center;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.4);
		margin-top: 0.8rem;
		font-style: italic;
	}

	@media (max-width: 480px) {
		.mha-concat-heads {
			flex-direction: column;
			align-items: center;
		}
		.mha-concat-head-vec {
			min-width: 160px;
		}
		.mha-toggle-buttons {
			flex-direction: column;
			align-items: center;
		}
		.mha-residual-flow {
			flex-direction: column;
		}
		.mha-residual-plus,
		.mha-residual-equals {
			transform: rotate(90deg);
		}
	}

	/* ===== Feature #14: Feed-Forward Network ===== */
	.linkage-ffn {
		background: hsl(150 55% 45% / 0.06);
		border-color: hsl(150 55% 45% / 0.25);
	}
	.linkage-ffn .linkage-icon { color: hsl(150 55% 45%); }

	.ffn-structure-diagram {
		background: hsl(var(--theme-text) / 0.02);
		border: 1.5px solid hsl(var(--theme-text) / 0.08);
		border-radius: 12px;
		padding: 1.5rem;
		margin: 1.5rem 0;
		overflow-x: auto;
	}

	.ffn-structure-title {
		font-size: 0.82rem;
		font-weight: 600;
		color: hsl(150 55% 45%);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 0.5rem;
	}

	.ffn-structure-formula {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.95rem;
		color: hsl(var(--theme-text) / 0.7);
		margin-bottom: 1.2rem;
		text-align: center;
	}

	.ffn-bulge {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0;
		padding: 1rem 0;
		min-height: 240px;
	}

	.ffn-bulge-stage {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 6px;
		min-width: 60px;
	}

	.ffn-bar {
		width: 40px;
		border-radius: 6px;
		background: hsl(150 55% 45% / 0.35);
		border: 1.5px solid hsl(150 55% 45% / 0.5);
		transition: height 0.3s ease;
	}

	.ffn-bar-tall {
		width: 56px;
		background: hsl(150 55% 45% / 0.5);
		border-color: hsl(150 55% 45% / 0.7);
	}

	.ffn-stage-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.7);
		text-align: center;
	}

	.ffn-stage-dim {
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.4);
		text-align: center;
		line-height: 1.3;
		font-variant-numeric: tabular-nums;
	}

	.ffn-bulge-arrow {
		font-size: 1.2rem;
		color: hsl(var(--theme-text) / 0.25);
		align-self: center;
		padding: 0 4px;
		margin-bottom: 30px;
	}

	.ffn-bar-label {
		font-size: 0.72rem;
