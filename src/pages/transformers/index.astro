		font-size: 2rem;
		font-weight: 700;
		color: hsl(var(--theme-text) / 0.18);
		user-select: none;
	}

	.teaser-text {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
		max-width: 42rem;
		text-align: center;
	}

	@media (max-width: 480px) {
		.teaser-box {
			gap: 1rem;
		}
		.teaser-blackbox {
			width: 90px;
			height: 64px;
		}
		.vocab-grid {
			grid-template-columns: 1fr;
		}
	}

	/* ===== Architecture diagram ===== */
	.arch-prose {
		max-width: 42rem;
		margin-bottom: 2rem;
	}

	.arch-prose p {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
		margin-bottom: 1.25rem;
	}

	.arch-prose strong {
		color: hsl(var(--theme-text) / 0.95);
		font-weight: 600;
	}

	.arch-outro {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
		max-width: 42rem;
		margin-top: 2rem;
	}

	.arch-diagram-wrap {
		position: relative;
		margin: 1.5rem 0;
	}

	.arch-controls {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.75rem;
	}

	.arch-animate-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 14px;
		border-radius: 6px;
		border: 1px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-text) / 0.03);
		color: hsl(var(--theme-text) / 0.65);
		font-size: 0.78rem;
		font-weight: 500;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.arch-animate-btn:hover {
		background: hsl(var(--theme-accent) / 0.08);
		color: hsl(var(--theme-accent));
	}

	.arch-animate-btn.running {
		color: hsl(var(--theme-accent));
		border-color: hsl(var(--theme-accent) / 0.3);
	}

	.arch-diagram {
		display: flex;
		flex-direction: column-reverse; /* bottom-to-top flow */
		align-items: center;
		gap: 6px;
		padding: 2rem 1rem;
		border-radius: 12px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
	}

	.arch-block {
		position: relative;
		width: 100%;
		max-width: 320px;
		padding: 12px 16px;
		border-radius: 8px;
		text-align: center;
		cursor: pointer;
		transition: transform 0.15s ease, box-shadow 0.2s ease, opacity 0.3s ease;
		border: 1.5px solid transparent;
	}

	.arch-block:hover {
		transform: scale(1.03);
		z-index: 2;
	}

	.arch-block-label {
		font-size: 0.82rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}

	/* Block colors matching preamble vocabulary */
	.arch-embedding {
		background: hsl(210 70% 55% / 0.12);
		border-color: hsl(210 70% 55% / 0.3);
		color: hsl(210 70% 55%);
	}
	.arch-embedding:hover {
		box-shadow: 0 0 0 3px hsl(210 70% 55% / 0.12);
	}

	.arch-attention {
		background: hsl(35 90% 55% / 0.12);
		border-color: hsl(35 90% 55% / 0.3);
		color: hsl(35 90% 55%);
	}
	.arch-attention:hover {
		box-shadow: 0 0 0 3px hsl(35 90% 55% / 0.12);
	}

	.arch-ffn {
		background: hsl(150 55% 45% / 0.12);
		border-color: hsl(150 55% 45% / 0.3);
		color: hsl(150 55% 45%);
	}
	.arch-ffn:hover {
		box-shadow: 0 0 0 3px hsl(150 55% 45% / 0.12);
	}

	.arch-output {
		background: hsl(350 65% 55% / 0.12);
		border-color: hsl(350 65% 55% / 0.3);
		color: hsl(350 65% 55%);
	}
	.arch-output:hover {
		box-shadow: 0 0 0 3px hsl(350 65% 55% / 0.12);
	}

	.arch-norm {
		background: hsl(var(--theme-text) / 0.04);
		border-color: hsl(var(--theme-text) / 0.1);
		color: hsl(var(--theme-text) / 0.55);
		padding: 8px 16px;
	}
	.arch-norm:hover {
		box-shadow: 0 0 0 3px hsl(var(--theme-text) / 0.06);
	}

	.arch-norm-sm {
		max-width: 240px;
		padding: 6px 12px;
	}

	.arch-norm-sm .arch-block-label {
		font-size: 0.72rem;
	}

	.arch-arrow {
		font-size: 1.1rem;
		color: hsl(var(--theme-text) / 0.2);
		line-height: 1;
		user-select: none;
	}

	.arch-input-label {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		color: hsl(var(--theme-text) / 0.4);
		padding: 4px 0;
	}

	/* Layer group (repeated block) */
	.arch-layer-group {
		position: relative;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 6px;
		width: 100%;
		padding: 16px 12px;
		border: 1.5px dashed hsl(270 50% 58% / 0.25);
		border-radius: 10px;
		background: hsl(270 50% 58% / 0.03);
	}

	.arch-layer-bracket {
		position: absolute;
		top: 8px;
		right: 12px;
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		color: hsl(270 50% 58% / 0.55);
		letter-spacing: 0.02em;
	}

	.arch-add-label {
		font-family: ui-monospace, monospace;
		font-size: 0.68rem;
		color: hsl(270 50% 58% / 0.5);
		user-select: none;
	}

	/* Residual connection wrapper */
	.arch-residual-wrap {
		position: relative;
		display: flex;
		flex-direction: column-reverse;
		align-items: center;
		gap: 6px;
		width: 100%;
		padding-left: 24px;
	}

	.arch-residual-line {
		position: absolute;
		left: 6px;
		top: 8px;
		bottom: 8px;
		width: 3px;
		border-radius: 2px;
		background: hsl(270 50% 58% / 0.18);
	}

	/* Tooltip */
	.arch-tooltip {
		position: absolute;
		bottom: 100%;
		left: 50%;
		transform: translateX(-50%) translateY(-8px);
		max-width: 320px;
		padding: 10px 14px;
		border-radius: 8px;
		background: hsl(var(--theme-text) / 0.92);
		color: hsl(var(--theme-bg));
		font-size: 0.8rem;
		line-height: 1.5;
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
		z-index: 10;
		white-space: normal;
	}

	.arch-tooltip.visible {
		opacity: 1;
	}

	/* Animation: data flow pulse */
	.arch-block.arch-flow-active {
		animation: archPulse 0.5s ease;
	}

	@keyframes archPulse {
		0%   { transform: scale(1); box-shadow: none; }
		50%  { transform: scale(1.06); box-shadow: 0 0 12px hsl(var(--theme-accent) / 0.3); }
		100% { transform: scale(1); box-shadow: none; }
	}

	@media (max-width: 640px) {
		.arch-block {
			max-width: none;
			padding: 10px 12px;
		}
		.arch-block-label {
			font-size: 0.75rem;
		}
		.arch-norm-sm {
			max-width: none;
		}
		.arch-residual-wrap {
			padding-left: 18px;
		}
		.arch-tooltip {
			max-width: 260px;
			font-size: 0.75rem;
		}
	}

	/* ===== Shared section prose ===== */
	.section-prose {
		max-width: 42rem;
	}

	.section-prose p {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
		margin-bottom: 1.25rem;
	}

	.section-prose strong {
		color: hsl(var(--theme-text) / 0.95);
		font-weight: 600;
	}

	.section-prose code {
		font-size: 0.9em;
		padding: 2px 5px;
		border-radius: 4px;
		background: hsl(var(--theme-text) / 0.06);
		color: hsl(var(--theme-text) / 0.85);
	}

	/* ===== Linkage callout ===== */
	.linkage-callout {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 12px 16px;
		border-radius: 8px;
		margin-bottom: 1.5rem;
		font-size: 0.88rem;
		line-height: 1.55;
		max-width: 42rem;
	}

	.linkage-callout strong {
		font-weight: 600;
	}

	.linkage-icon {
		flex-shrink: 0;
		font-size: 1rem;
		margin-top: 1px;
	}

	.linkage-embedding {
		background: hsl(210 70% 55% / 0.08);
		border: 1px solid hsl(210 70% 55% / 0.2);
		color: hsl(210 70% 55% / 0.85);
	}

	.linkage-embedding strong {
		color: hsl(210 70% 55%);
	}

	/* ===== Tokenizer widget ===== */
	.tokenizer-widget {
		margin: 2rem 0;
		max-width: 42rem;
	}

	.tokenizer-label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 6px;
	}

	.tokenizer-input {
		width: 100%;
		padding: 12px 14px;
		border-radius: 8px;
		border: 1.5px solid hsl(var(--theme-text) / 0.12);
		background: hsl(var(--theme-text) / 0.03);
		color: hsl(var(--theme-text) / 0.9);
		font-family: ui-monospace, monospace;
		font-size: 0.95rem;
		line-height: 1.5;
		resize: vertical;
		transition: border-color 0.15s ease;
	}

	.tokenizer-input:focus {
		outline: none;
		border-color: hsl(210 70% 55% / 0.5);
		box-shadow: 0 0 0 3px hsl(210 70% 55% / 0.1);
	}

	.tokenizer-input::placeholder {
		color: hsl(var(--theme-text) / 0.25);
	}

	.tokenizer-output-wrap {
		margin-top: 12px;
	}

	.tokenizer-output-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 8px;
	}

	.tokenizer-count {
		font-weight: 400;
		color: hsl(var(--theme-text) / 0.3);
	}

	.tokenizer-output {
		display: flex;
		flex-wrap: wrap;
		gap: 5px;
		min-height: 44px;
		padding: 10px 12px;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
	}

	.tokenizer-placeholder {
		font-size: 0.85rem;
		color: hsl(var(--theme-text) / 0.25);
		font-style: italic;
	}

	/* Token chips — color scheme for reuse in later sections */
	.token-chip {
		display: inline-block;
		padding: 3px 8px;
		border-radius: 4px;
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		font-weight: 500;
		line-height: 1.4;
		white-space: pre;
	}

	/* Whole word token */
	.token-whole {
		background: hsl(210 60% 55% / 0.12);
		color: hsl(210 60% 55%);
		border: 1px solid hsl(210 60% 55% / 0.2);
	}

	/* Subword piece */
	.token-sub {
		background: hsl(35 80% 50% / 0.12);
		color: hsl(35 80% 50%);
		border: 1px solid hsl(35 80% 50% / 0.2);
	}

	/* Punctuation / special */
	.token-special {
		background: hsl(var(--theme-text) / 0.06);
		color: hsl(var(--theme-text) / 0.5);
		border: 1px solid hsl(var(--theme-text) / 0.1);
	}

	/* Legend swatches */
	.tokenizer-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 10px;
	}

	.tokenizer-legend-item {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	.token-whole-example { background: hsl(210 60% 55% / 0.25); width: 12px; height: 12px; border-radius: 3px; }
	.token-sub-example { background: hsl(35 80% 50% / 0.25); width: 12px; height: 12px; border-radius: 3px; }
	.token-special-example { background: hsl(var(--theme-text) / 0.15); width: 12px; height: 12px; border-radius: 3px; }

	/* ===== Embedding transition (token → vector) ===== */
	.embed-transition {
		margin: 2.5rem 0 2rem;
		max-width: 42rem;
	}

	.embed-transition-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 10px;
	}

	.embed-transition-rows {
		display: flex;
		flex-direction: column;
		gap: 8px;
		margin-bottom: 1.25rem;
	}

	.embed-transition-row {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.embed-arrow {
		color: hsl(var(--theme-text) / 0.3);
		font-size: 1.1rem;
		flex-shrink: 0;
	}

	.embed-vector {
		font-family: ui-monospace, monospace;
		font-size: 0.82rem;
		color: hsl(210 70% 55% / 0.7);
		background: hsl(210 70% 55% / 0.06);
		padding: 4px 10px;
		border-radius: 5px;
		border: 1px solid hsl(210 70% 55% / 0.12);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.embed-transition-note {
		font-size: 1.05rem;
		line-height: 1.75;
		color: hsl(var(--theme-text) / 0.78);
	}

	.embed-transition-note strong {
		color: hsl(var(--theme-text) / 0.95);
		font-weight: 600;
	}

	/* ===== Embedding scatter plot ===== */
	.embed-scatter-wrap {
		margin: 2rem 0;
		max-width: 42rem;
	}

	.embed-scatter-header {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-bottom: 8px;
		flex-wrap: wrap;
	}

	.embed-scatter-title {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
	}

	.embed-scatter-subtitle {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.25);
		font-style: italic;
	}

	.embed-scatter {
		width: 100%;
		border-radius: 10px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
		color: hsl(var(--theme-text));
	}

	/* SVG point styling */
	.embed-scatter :global(.embed-point) {
		cursor: pointer;
		transition: r 0.15s ease, fill-opacity 0.15s ease;
	}

	.embed-scatter :global(.embed-point:hover) {
		fill-opacity: 1;
	}

	.embed-scatter :global(.embed-label) {
		font-family: ui-monospace, monospace;
		font-size: 10px;
		fill: hsl(var(--theme-text) / 0.85);
		pointer-events: none;
		opacity: 0;
		transition: opacity 0.15s ease;
	}

	.embed-scatter :global(.embed-label.visible) {
		opacity: 1;
	}

	.embed-scatter :global(.embed-cluster-label) {
		font-size: 9px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		fill: currentColor;
		fill-opacity: 0.25;
		pointer-events: none;
	}

	.embed-scatter-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 8px;
	}

	.embed-scatter-legend :global(.scatter-legend-item) {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.45);
	}

	.embed-scatter-legend :global(.scatter-legend-dot) {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	@media (max-width: 480px) {
		.embed-transition-row {
			flex-wrap: wrap;
		}
		.embed-vector {
			font-size: 0.72rem;
		}
	}

	/* ===== Subsection divider ===== */
	.subsection-divider {
		width: 60px;
		height: 1px;
		background: hsl(var(--theme-text) / 0.1);
		margin: 3rem 0 2rem;
	}

	.subsection-title {
		font-size: 1.5rem;
		font-weight: 600;
		color: hsl(var(--theme-text) / 0.9);
		margin-bottom: 1rem;
		display: flex;
		align-items: baseline;
		gap: 10px;
	}

	.subsection-label {
		font-family: ui-monospace, monospace;
		font-size: 0.78rem;
		font-weight: 500;
		color: hsl(var(--theme-accent) / 0.6);
	}

	/* ===== Positional encoding formula ===== */
	.posenc-formula {
		max-width: 42rem;
		margin: 1rem 0 1.5rem;
		padding: 14px 20px;
		border-radius: 8px;
		background: hsl(var(--theme-text) / 0.03);
		border: 1px solid hsl(var(--theme-text) / 0.06);
		font-family: ui-monospace, monospace;
		font-size: 0.88rem;
		color: hsl(var(--theme-text) / 0.75);
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.posenc-formula-row {
		display: flex;
		align-items: baseline;
		gap: 2px;
	}

	.posenc-fn {
		color: hsl(210 70% 55%);
		font-weight: 600;
	}

	.posenc-formula sub,
	.posenc-formula sup {
		font-size: 0.72em;
		color: hsl(var(--theme-text) / 0.5);
	}

	/* ===== Positional encoding interactive ===== */
	.posenc-interactive {
		max-width: 42rem;
		margin: 1.5rem 0;
	}

	.posenc-slider-wrap {
		margin-bottom: 12px;
	}

	.posenc-slider-label {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 6px;
	}

	.posenc-pos-value {
		color: hsl(210 70% 55%);
		font-weight: 700;
		font-family: ui-monospace, monospace;
	}

	.posenc-slider {
		width: 100%;
		height: 6px;
		-webkit-appearance: none;
		appearance: none;
		background: hsl(var(--theme-text) / 0.08);
		border-radius: 3px;
		outline: none;
		cursor: pointer;
	}

	.posenc-slider::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(210 70% 55%);
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 4px hsl(0 0% 0% / 0.15);
		cursor: pointer;
	}

	.posenc-slider::-moz-range-thumb {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: hsl(210 70% 55%);
		border: 2px solid hsl(var(--theme-bg));
		box-shadow: 0 1px 4px hsl(0 0% 0% / 0.15);
		cursor: pointer;
	}

	.posenc-slider-range {
		display: flex;
		justify-content: space-between;
		font-size: 0.68rem;
		color: hsl(var(--theme-text) / 0.25);
		font-family: ui-monospace, monospace;
		margin-top: 2px;
	}

	/* Wave bars */
	.posenc-waves-wrap {
		margin-top: 8px;
	}

	.posenc-waves-label {
		font-size: 0.72rem;
		color: hsl(var(--theme-text) / 0.35);
		margin-bottom: 4px;
	}

	.posenc-waves-label span {
		color: hsl(210 70% 55%);
		font-weight: 600;
		font-family: ui-monospace, monospace;
	}

	.posenc-waves {
		width: 100%;
		border-radius: 8px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		background: hsl(var(--theme-text) / 0.015);
		color: hsl(var(--theme-text));
	}

	/* ===== Heatmap ===== */
	.posenc-heatmap-wrap {
		max-width: 42rem;
		margin: 2rem 0;
	}

	.posenc-heatmap-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: hsl(var(--theme-text) / 0.4);
		margin-bottom: 8px;
	}

	.posenc-heatmap {
		width: 100%;
		max-width: 480px;
		border-radius: 6px;
		border: 1px solid hsl(var(--theme-text) / 0.06);
		image-rendering: pixelated;
	}

	.posenc-heatmap-axes {
