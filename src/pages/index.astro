---
import SocialList from "@/components/SocialList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 5;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);

const cactusTech: { desc: string; href: string; title: string }[] = [
  {
    desc: "Very fine-grained data visualization engine. I keep coming back to D3.",
    href: "https://github.com/vercel/satori",
    title: "D3",
  },
  {
    desc: "LLM prompt management, metrics, traces, and a solid API.",
    href: "https://www.langchain.com/",
    title: "LangChain and LangSmith",
  },
  {
    desc: "Heirloom quality woodworking tools.",
    href: "https://www.lie-nielsen.com/",
    title: "Lie-Nielsen Toolworks",
  },
  {
    desc: "Powerful slippy maps and spatial data representation. Nice SDK.",
    href: "https://docs.mapbox.com/mapbox-gl-js/api/",
    title: "Mapbox GL JS",
  },
];
---

<PageLayout meta={{ title: "Home" }}>
  <section>
    <p class="mb-4">
      Hi, I'm Toby. I like to make things. I try to make useful and beautiful things! I'm a
      co-founder of
      <a class="cactus-link" href="http://www.devdatalab.org/" target="_blank"
        >Development Data Lab</a
      >, where we help solve major social problems in developing countries using novel datasets. I
      lead data engineering, data science, geospatial, and visualization at DDL.
    </p>
    <p class="mb-4">
      My past lives include being a line cook at a fancy restaurant and a Fulbrighter to Ethiopia,
      where I worked on agricultural development projects alongside smallholder farmers. I also
      build furniture, restore old sailboats, and I really like maps.
    </p>
    <p class="mb-4">
      This site is intended to be a landing page and a means for sharing my hobbies, interests, and
      side projects.
    </p>
    <SocialList />
  </section>
  <section aria-label="Blog post list" class="mt-16">
    <h2 class="title mb-4 text-xl">Posts</h2>
    <ul class="space-y-4">
      {
        allPostsByDate.map((p) => (
          <li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
            <PostPreview post={p} />
          </li>
        ))
      }
    </ul>
    <div class="mt-4">
      <a href="/posts" class="font-semibold hover:underline">More Posts →</a>
    </div>
  </section>
  <section class="mt-16">
    <h2 class="title mb-4 text-xl">Tools I have been liking recently</h2>
    <dl class="space-y-4">
      {
        cactusTech.map(({ desc, href, title }) => (
          <div class="flex flex-col gap-2 sm:flex-row">
            <dt>
              <span class="flex">
                <a class="cactus-link" href={href} rel="noopener noreferrer" target="_blank">
                  {title}
                </a>
                :
              </span>
            </dt>
            <dd>{desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</PageLayout>
